<Window x:Class="CLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CLab.Views"
        Title="CustomerLab"
        Height="800"
        Width="1200">

    <Grid>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="{Binding SidebarWidth}"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!-- Sidebar -->
        <views:SidebarView Grid.Column="0"/>


        <!-- Area contenuto -->
        <Border Grid.Column="1"
        Background="{StaticResource BrushSfondoChiaro}">

            <ContentControl
        Content="{Binding VistaCorrente}"/>

        </Border>

    </Grid>

</Window>