<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Dimensioni font -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeMenu">15</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">18</sys:Double>
    <sys:Double x:Key="FontSizeTitle">28</sys:Double>

    <!-- ========================= -->
    <!-- Text Styles -->
    <!-- ========================= -->

    <Style x:Key="PageTitleText"
       TargetType="TextBlock">

        <Setter Property="FontSize"
            Value="{StaticResource FontSizeTitle}"/>

        <Setter Property="FontWeight"
            Value="SemiBold"/>

        <Setter Property="Foreground"
            Value="{StaticResource BrushTestoPrimario}"/>

    </Style>


    <Style x:Key="PageSubtitleText"
       TargetType="TextBlock">

        <Setter Property="FontSize"
            Value="{StaticResource FontSizeSubtitle}"/>

        <Setter Property="Foreground"
            Value="{StaticResource BrushTestoSecondario}"/>

    </Style>


    <Style x:Key="BodyText"
       TargetType="TextBlock">

        <Setter Property="FontSize"
            Value="{StaticResource FontSizeBody}"/>

        <Setter Property="Foreground"
            Value="{StaticResource BrushTestoPrimario}"/>

    </Style>


    <Style x:Key="MenuText"
       TargetType="TextBlock">

        <Setter Property="FontSize"
            Value="{StaticResource FontSizeMenu}"/>

        <Setter Property="Foreground"
            Value="{StaticResource BrushTestoSecondario}"/>

    </Style>

</ResourceDictionary>