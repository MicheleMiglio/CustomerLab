<UserControl x:Class="CLab.Views.AttivitaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:local="clr-namespace:CLab.Models"
             xmlns:converters="clr-namespace:CLab.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">

    <UserControl.Resources>
        <ResourceDictionary>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <converters:EnumToVisibilityConverter x:Key="EnumToVisibility"/>
            <converters:TipoCampoLabelConverter   x:Key="TipoCampoLabel"/>

            <ObjectDataProvider x:Key="Periodicita" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:Periodicita"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <ObjectDataProvider x:Key="TipiCampo" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:TipoCampoAttivita"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource ModuleHeaderBorderStyle}" Padding="28,0" Height="64">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Attività" Style="{StaticResource ModuleTitleStyle}"/>
                    <TextBlock Text="GESTIONE E CONFIGURAZIONE ATTIVITÀ" Style="{StaticResource ModuleSubtitleStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Catalogo" Command="{Binding MostraCatalogoCommand}"
                        Padding="4,8" Margin="0,0,20,0" Cursor="Hand" Background="Transparent">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2">
                                    <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConfigurazioneAttiva}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Configurazione" Command="{Binding MostraConfigurazioneCommand}"
                        Padding="4,8" Cursor="Hand" Background="Transparent">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2">
                                    <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConfigurazioneAttiva}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- AREA CONTENUTO -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar: solo per il Catalogo, la Configurazione ha i suoi controlli sotto -->
            <Grid Grid.Row="0" Margin="28,14,28,12"
                Visibility="{Binding ConfigurazioneAttiva, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White"
                    BorderBrush="{StaticResource BrushBordo}" BorderThickness="1"
                    CornerRadius="6" Height="34">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconBootstrapIcons Grid.Column="0"
                        Kind="Search" Width="13" Height="13" Foreground="{StaticResource BrushTestoSecondario}"
                        Margin="10,0,6,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                             Text="{Binding FiltroCatalogoTesto, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Background="Transparent"
                             FontSize="13" Foreground="{StaticResource BrushTestoPrimario}"
                             VerticalContentAlignment="Center" Height="32"
                             mah:TextBoxHelper.Watermark="  Cerca attività…"/>
                    </Grid>
                </Border>

                <Button Grid.Column="2" Style="{StaticResource BtnOutlineGold}" Height="34"
                    Command="{Binding NuovoCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBootstrapIcons Kind="Plus"
                        Width="11" Height="11"
                        Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Nuova attività" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Elenco catalogo -->
            <DataGrid Grid.Row="1" ItemsSource="{Binding ElencoFiltrato}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  BorderThickness="1" BorderBrush="{StaticResource BrushBordo}"
                  RowHeight="44" HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  Background="White" RowBackground="White"
                  AlternatingRowBackground="{StaticResource BrushSfondoAlternato}"
                  Margin="28,0,28,24"
                  Visibility="{Binding ConfigurazioneAttiva, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModuleColumnHeaderStyle}"/>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrushAccentHover}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NOME" Binding="{Binding Nome}" Width="2*" SortMemberPath="Nome">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="14,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="PERIODICITÀ" Binding="{Binding Periodicita}" Width="1.2*" SortMemberPath="Periodicita">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="14,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="TIPO CAMPO" Binding="{Binding TipoCampo, Converter={StaticResource TipoCampoLabel}}" Width="1.2*" SortMemberPath="TipoCampo">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="14,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Style="{StaticResource BtnIcon}"
                                        Command="{Binding DataContext.ModificaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" ToolTip="Modifica">
                                        <iconPacks:PackIconBootstrapIcons Kind="Pencil"
                                        Width="13" Height="13" Foreground="{StaticResource BrushTestoSecondario}"/>
                                    </Button>
                                    <Button Style="{StaticResource BtnIconRed}" Margin="3,0,0,0"
                                        Command="{Binding DataContext.EliminaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" ToolTip="Elimina">
                                        <iconPacks:PackIconBootstrapIcons Kind="Trash"
                                        Width="13" Height="13" Foreground="{StaticResource BrushTestoSecondario}"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Configurazione: doppia lista -->
            <Grid Grid.Row="1" Visibility="{Binding ConfigurazioneAttiva, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Sotto-schede + selettore -->
                <Grid Grid.Row="0" Margin="28,15,28,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Per cliente" Command="{Binding MostraConfigPerClienteCommand}"
                            Padding="4,6" Margin="0,0,16,0" Cursor="Hand" Background="Transparent">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ModalitaPerCliente}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Per attività" Command="{Binding MostraConfigPerAttivitaCommand}"
                            Padding="4,6" Cursor="Hand" Background="Transparent">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ModalitaPerCliente}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <ComboBox Width="170" Height="34" Margin="0,0,10,0"
      Visibility="{Binding ModalitaPerCliente, Converter={StaticResource BoolToVisibility}}"
      IsTextSearchEnabled="True" TextSearch.TextPath="Nome"
      ItemsSource="{Binding ReferentiFiltroConfigurazione}"
      SelectedItem="{Binding ReferenteFiltroConfigurazione}"/>
                    
                    <ComboBox Grid.Column="1" Width="260" Height="34" HorizontalAlignment="Right"
                        Visibility="{Binding ModalitaPerCliente, Converter={StaticResource BoolToVisibility}}"
                        ItemsSource="{Binding ClientiPerConfigurazione}"
                        TextSearch.TextPath="RagioneSociale"
                        SelectedItem="{Binding ClienteConfigurazione}"/>

                    <ComboBox Grid.Column="1" Width="260" Height="34" HorizontalAlignment="Right"
                        Visibility="{Binding ModalitaPerCliente, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}"
                        ItemsSource="{Binding ElencoFiltrato}"
                        SelectedItem="{Binding AttivitaConfigurazione}"/>
                </Grid>

                <!-- Le due colonne -->
                <Grid Grid.Row="1" Margin="28,0,28,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ASSEGNATE -->
                    <Border Grid.Column="0" BorderBrush="{StaticResource BrushBordo}" BorderThickness="1" CornerRadius="8" Background="White" Opacity="0.6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Margin="14,12,14,8"
                                   Text="{Binding AttivitaAssegnateConfig.Count, StringFormat='ASSEGNATE ({0})'}"
                                   FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTestoSecondario}"
                                   Visibility="{Binding ModalitaPerCliente, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Grid.Row="0" Margin="14,12,14,8"
                                   Text="{Binding ClientiAssegnatiConfig.Count, StringFormat='ASSEGNATI ({0})'}"
                                   FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTestoSecondario}"
                                   Visibility="{Binding ModalitaPerCliente, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}"/>

                            <Border Grid.Row="1" Margin="14,0,14,10" Background="White"
                                BorderBrush="{StaticResource BrushBordo}" BorderThickness="1" CornerRadius="6" Height="32">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconBootstrapIcons Grid.Column="0"
                                    Kind="Search" Width="12" Height="12" Foreground="{StaticResource BrushTestoSecondario}"
                                    Margin="9,0,5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1"
                                         Text="{Binding FiltroAssegnateTesto, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent"
                                         FontSize="12" Foreground="{StaticResource BrushTestoPrimario}"
                                         VerticalContentAlignment="Center" Height="30"
                                         mah:TextBoxHelper.Watermark="  Cerca tra le assegnate…"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14,0,14,14">

                                    <ItemsControl ItemsSource="{Binding AttivitaAssegnateConfig}"
                                              Visibility="{Binding ModalitaPerCliente, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BrushSfondoChiaro}" CornerRadius="5"
                                                    Padding="10,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Nome}" FontSize="12" Foreground="{StaticResource BrushTestoPrimario}"/>
                                                            <TextBlock FontSize="10" Foreground="{StaticResource BrushTestoSecondario}" Margin="0,2,0,0">
                                                                <Run Text="{Binding Periodicita}"/>
                                                                <Run Text=" · "/>
                                                                <Run Text="{Binding TipoCampo, Converter={StaticResource TipoCampoLabel}}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Padding="4" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.RimuoviAttivitaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" ToolTip="Non assegnare">
                                                            <iconPacks:PackIconBootstrapIcons Kind="Dash" Width="12" Height="12" Foreground="{StaticResource BrushTestoSecondario}"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding ClientiAssegnatiConfig}"
                                              Visibility="{Binding ModalitaPerCliente, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BrushSfondoChiaro}" CornerRadius="5"
                                                    Padding="10,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding RagioneSociale}" FontSize="12" Foreground="{StaticResource BrushTestoPrimario}"/>
                                                            <TextBlock Text="{Binding PartitaIva, StringFormat='P.IVA {0}'}"
                                                                   FontSize="10" Foreground="{StaticResource BrushTestoSecondario}" Margin="0,2,0,0"
                                                                   Visibility="{Binding PartitaIva, Converter={StaticResource BoolToVisibility}}"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Padding="4" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.RimuoviClienteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" ToolTip="Non assegnare">
                                                            <iconPacks:PackIconBootstrapIcons Kind="Dash" Width="12" Height="12" Foreground="{StaticResource BrushTestoSecondario}"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- NON ASSEGNATE -->
                    <Border Grid.Column="2" BorderBrush="{StaticResource BrushBordo}" BorderThickness="1" CornerRadius="8"  Background="White" Opacity="0.6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Margin="14,12,14,8"
                                   Text="{Binding AttivitaNonAssegnateConfig.Count, StringFormat='NON ASSEGNATE ({0})'}"
                                   FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTestoSecondario}"
                                   Visibility="{Binding ModalitaPerCliente, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Grid.Row="0" Margin="14,12,14,8"
                                   Text="{Binding ClientiNonAssegnatiConfig.Count, StringFormat='NON ASSEGNATI ({0})'}"
                                   FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTestoSecondario}"
                                   Visibility="{Binding ModalitaPerCliente, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}"/>

                            <Border Grid.Row="1" Margin="14,0,14,10" Background="White"
                                BorderBrush="{StaticResource BrushBordo}" BorderThickness="1" CornerRadius="6" Height="32">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconBootstrapIcons Grid.Column="0"
                                    Kind="Search" Width="12" Height="12" Foreground="{StaticResource BrushTestoSecondario}"
                                    Margin="9,0,5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1"
                                         Text="{Binding FiltroNonAssegnateTesto, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent"
                                         FontSize="12" Foreground="{StaticResource BrushTestoPrimario}"
                                         VerticalContentAlignment="Center" Height="30"
                                         mah:TextBoxHelper.Watermark="  Cerca tra le non assegnate…"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14,0,14,14">

                                    <ItemsControl ItemsSource="{Binding AttivitaNonAssegnateConfig}"
                                              Visibility="{Binding ModalitaPerCliente, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BrushSfondoChiaro}" CornerRadius="5"
                                                    Padding="10,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Nome}" FontSize="12" Foreground="{StaticResource BrushTestoPrimario}"/>
                                                            <TextBlock FontSize="10" Foreground="{StaticResource BrushTestoSecondario}" Margin="0,2,0,0">
                                                                <Run Text="{Binding Periodicita}"/>
                                                                <Run Text=" · "/>
                                                                <Run Text="{Binding TipoCampo, Converter={StaticResource TipoCampoLabel}}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Padding="4" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.AggiungiAttivitaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" ToolTip="Assegna">
                                                            <iconPacks:PackIconBootstrapIcons Kind="Plus" Width="12" Height="12" Foreground="{StaticResource BrushTestoSecondario}"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding ClientiNonAssegnatiConfig}"
                                              Visibility="{Binding ModalitaPerCliente, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BrushSfondoChiaro}" CornerRadius="5"
                                                    Padding="10,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding RagioneSociale}" FontSize="12" Foreground="{StaticResource BrushTestoPrimario}"/>
                                                            <TextBlock Text="{Binding PartitaIva, StringFormat='P.IVA {0}'}"
                                                                   FontSize="10" Foreground="{StaticResource BrushTestoSecondario}" Margin="0,2,0,0"
                                                                   Visibility="{Binding PartitaIva, Converter={StaticResource BoolToVisibility}}"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Padding="4" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.AggiungiClienteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" ToolTip="Assegna">
                                                            <iconPacks:PackIconBootstrapIcons Kind="Plus" Width="12" Height="12" Foreground="{StaticResource BrushTestoSecondario}"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                </Grid>
            </Grid>

        </Grid>

        <!-- OVERLAY -->
        <Border Grid.Row="0" Grid.RowSpan="2"
            Cursor="Arrow"
            Visibility="{Binding PannelloAperto, Converter={StaticResource BoolToVisibility}}">
            <Border.Background>
                <SolidColorBrush Color="{StaticResource ColorPrimaryDark}" Opacity="0.35"/>
            </Border.Background>
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding AnnullaCommand}"/>
            </Border.InputBindings>
        </Border>

        <!-- PANNELLO NUOVA/MODIFICA ATTIVITÀ -->
        <Border Grid.Row="0" Grid.RowSpan="2" Width="400" HorizontalAlignment="Right"
            Background="White"
            BorderBrush="{StaticResource BrushBordo}" BorderThickness="1,0,0,0"
            Visibility="{Binding PannelloAperto, Converter={StaticResource BoolToVisibility}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0"
                              Direction="180" Opacity="0.12" Color="{StaticResource ColorPrimaryDark}"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource ModuleHeaderBorderStyle}" Padding="22,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Attività" Style="{StaticResource ModuleTitleStyle}"/>
                        <Button Grid.Column="1" Style="{StaticResource BtnIconGhost}"
                            Command="{Binding AnnullaCommand}"
                            ToolTip="Chiudi" VerticalAlignment="Top">
                            <iconPacks:PackIconBootstrapIcons Kind="XLg"
                            Width="14" Height="14" Foreground="{StaticResource BrushTestoSecondario}"/>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,16">

                        <TextBlock Text="NOME" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding FormNome, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,16"/>

                        <TextBlock Text="PERIODICITÀ" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Source={StaticResource Periodicita}}"
                              SelectedItem="{Binding FormPeriodicita}" Margin="0,4,0,16"/>

                        <TextBlock Text="TIPO DI CAMPO" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Source={StaticResource TipiCampo}}"
                              SelectedItem="{Binding FormTipoCampo}" Margin="0,4,0,16"/>

                        <StackPanel Visibility="{Binding FormTipoCampo, Converter={StaticResource EnumToVisibility}, ConverterParameter=TestoLibero}">
                            <TextBlock Text="LUNGHEZZA MASSIMA" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding FormTestoLunghezzaMassima, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,16"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding FormTipoCampo, Converter={StaticResource EnumToVisibility}, ConverterParameter=Numero}"
                                Orientation="Horizontal" Margin="0,0,0,16">
                            <CheckBox IsChecked="{Binding FormNumeroEImporto}"/>
                            <TextBlock Text="È un importo in euro" Margin="6,0,0,0"
                                   Foreground="{StaticResource BrushTestoSecondario}" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding FormTipoCampo, Converter={StaticResource EnumToVisibility}, ConverterParameter=Tendina}">

                            <TextBlock Text="OPZIONI" Style="{StaticResource FieldLabel}"/>
                            <ItemsControl ItemsSource="{Binding FormOpzioni}" Margin="0,4,0,8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushSfondoChiaro}" CornerRadius="4"
                                            Padding="8,4" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource BrushTestoPrimario}"/>
                                                <TextBlock Text=" ✕" FontSize="11" Foreground="{StaticResource BrushTestoSecondario}"
                                                       Cursor="Hand" Margin="6,0,0,0">
                                                    <TextBlock.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                            Command="{Binding DataContext.RimuoviOpzioneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    </TextBlock.InputBindings>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding FormNuovaOpzione, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Style="{StaticResource BtnOutline}" Margin="6,0,0,0"
                                    Content="Aggiungi" Command="{Binding AggiungiOpzioneCommand}"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <CheckBox IsChecked="{Binding FormTendinaRichiedeImporto}"/>
                                <TextBlock Text="Richiedi anche un importo abbinato" Margin="6,0,0,0"
                                       Foreground="{StaticResource BrushTestoSecondario}" FontSize="12"/>
                            </StackPanel>

                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="{StaticResource BrushBordo}" BorderThickness="0,1,0,0" Padding="22,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Salva" Command="{Binding SalvaCommand}"
                            Style="{StaticResource BtnPrimary}" HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="2" Content="Annulla" Command="{Binding AnnullaCommand}"
                            Style="{StaticResource BtnOutline}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

    </Grid>
</UserControl>