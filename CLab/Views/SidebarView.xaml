<UserControl x:Class="CLab.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:conv="clr-namespace:CLab.Converters">

    <Border Background="{StaticResource BrushSidebarBackground}">

        <Grid ClipToBounds="True">

            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Logo / Nome applicazione: stessa altezza dell'header di pagina,
                 così le due barre in cima allo schermo si allineano. Tutto il
                 blocco è cliccabile per aprire/chiudere la sidebar. -->
            <Border Grid.Row="0"
                BorderBrush="{StaticResource BrushDivisoreSuScuro}" BorderThickness="0,0,0,1"
                Background="Transparent" Cursor="Hand">

                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleSidebarCommand}"/>
                </Border.InputBindings>

                <Grid Margin="18,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Marchio -->
                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6"
                        Background="{StaticResource BrushAccentHover}" VerticalAlignment="Center">
                        <TextBlock Text="C" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Wordmark, solo a sidebar espansa -->
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding SidebarEspansa, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="CLab" FontSize="15" FontWeight="Medium"
                               Foreground="{StaticResource BrushTestoSuScuro}"/>
                        <TextBlock Text="Customer Lab" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource BrushTestoSuScuroSecondario}" Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- Indicatore di collassa, solo a sidebar espansa -->
                    <iconPacks:PackIconBootstrapIcons Grid.Column="2" Kind="ChevronLeft"
                        Width="12" Height="12" Foreground="{StaticResource BrushTestoSuScuroSecondario}"
                        VerticalAlignment="Center"
                        Visibility="{Binding SidebarEspansa, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Border>

            <!-- Menu principale -->
            <Border Grid.Row="1"
        Margin="0,10,0,0">
                <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding MenuPrincipale}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Button Style="{StaticResource SidebarMenuButton}"
        Command="{Binding Comando}"
        CommandParameter="{Binding}">

                                <Grid VerticalAlignment="Center">


                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="Auto"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>



                                    <!-- ICONA -->
                                    <iconPacks:PackIconBootstrapIcons
        Grid.Column="0"
        Kind="{Binding Icona, Converter={StaticResource IconaBootstrapConverter}}"
        Width="18"
        Height="18"
        Margin="2,0,10,0"/>



                                    <!-- TESTO -->
                                    <TextBlock Grid.Column="1"
               Text="{Binding Titolo}"
               Style="{StaticResource MenuText}"
               Visibility="{Binding DataContext.SidebarEspansa,
                            RelativeSource={RelativeSource AncestorType=UserControl},
                            Converter={StaticResource BoolToVisibility}}"/>


                                </Grid>

                            </Button>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>
            </Border>
            <!-- Footer -->
            <ItemsControl Grid.Row="2"
              ItemsSource="{Binding MenuFooter}">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Button Style="{StaticResource SidebarMenuButton}"
        Command="{Binding Comando}"
        CommandParameter="{Binding}">

                            <Grid VerticalAlignment="Center">


                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>



                                <!-- ICONA -->
                                <iconPacks:PackIconBootstrapIcons
        Grid.Column="0"
        Kind="{Binding Icona, Converter={StaticResource IconaBootstrapConverter}}"
        Width="18"
        Height="18"
        Margin="2,0,10,0"/>



                                <!-- TESTO -->
                                <TextBlock Grid.Column="1"
               Text="{Binding Titolo}"
               Style="{StaticResource MenuText}"
               Visibility="{Binding DataContext.SidebarEspansa,
                            RelativeSource={RelativeSource AncestorType=UserControl},
                            Converter={StaticResource BoolToVisibility}}"/>


                            </Grid>

                        </Button>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>
        </Grid>
    </Border>

</UserControl>