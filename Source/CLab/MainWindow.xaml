<mah:MetroWindow x:Class="CLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:views="clr-namespace:CLab.Views"
        Title="CustomerLab"
        Height="800"
        Width="1200"
        MinHeight="760"
        MinWidth="1120"
        WindowTitleBrush="{StaticResource BrushSidebarBackground}"
        NonActiveWindowTitleBrush="{StaticResource BrushSidebarBackground}"
        GlowBrush="{StaticResource BrushBordoLeggero}"
        TitleForeground="{StaticResource BrushTestoPrimario}"
        TitleCharacterCasing="Normal"
        ShowIconOnTitleBar="True"
        ShowTitleBar="True"
        SaveWindowPosition="True"
        WindowState="Maximized">

    <mah:MetroWindow.InputBindings>
        <!-- FASE 12: Ctrl+K apre la ricerca globale -->
        <KeyBinding Modifiers="Control" Key="K" Command="{Binding Ricerca.ApriCommand}"/>
    </mah:MetroWindow.InputBindings>

    <!-- Titolo di finestra piccolo e discreto su titlebar chiara: testo
         secondario, si nota appena (il contenuto è il protagonista). -->
    <mah:MetroWindow.TitleTemplate>
        <DataTemplate>
            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=mah:MetroWindow}, Path=Title}"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushTestoSecondario}"
                       Margin="10,0,0,0" VerticalAlignment="Center"/>
        </DataTemplate>
    </mah:MetroWindow.TitleTemplate>

    <!-- Icona di sistema in titlebar: stesso marchio "C" della sidebar,
         così titlebar e app sono un unico blocco visivo. -->
    <mah:MetroWindow.IconTemplate>
        <DataTemplate>
            <Border Width="16" Height="16" CornerRadius="4" Margin="6,0,0,0"
                    Background="{StaticResource BrushPrimary}">
                <TextBlock Text="C" FontSize="9" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </DataTemplate>
    </mah:MetroWindow.IconTemplate>

    <!-- Sfondo della shell: stessa tinta off-white della sidebar. Sidebar e
         contenuto si distinguono solo per il bordo 1px (in SidebarView):
         nessuna cornice scura, un'unica superficie luminosa. -->
    <Grid Background="{StaticResource BrushSidebarBackground}"
          TextElement.FontFamily="{StaticResource FontFamilyBase}">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="{Binding SidebarWidth}"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!-- Sidebar -->
        <views:SidebarView Grid.Column="0"/>


        <!-- Area contenuto: angolo in alto a sinistra arrotondato (il punto in
             cui sidebar e titlebar navy si incontrano), più una sfumatura
             azzurro-chiaro→grigio-chiaro nella fascia della testata pagina.
             Prima l'header di ogni modulo era una scatola grigia scollegata,
             incollata di netto sotto una titlebar ora colorata: qui invece il
             colore della cornice "prosegue" morbidamente dentro il modulo e
             sfuma nello sfondo normale, un solo punto di codice che vale per
             tutti gli 8 moduli (l'header di ciascuno è trasparente, vedi
             Theme/ModulePage.xaml → ModuleHeaderBorderStyle). -->
        <Border Grid.Column="1"
        Background="{StaticResource BrushSfondoChiaro}"
        BorderBrush="{StaticResource BrushBordoLeggero}"
        BorderThickness="0,1,0,0"
        ClipToBounds="True">

            <ContentControl
        Content="{Binding VistaCorrente}"/>

        </Border>

        <!-- FASE 12: ricerca globale (Ctrl+K), overlay sull'intera finestra -->
        <views:GlobalSearchControl Grid.Column="0" Grid.ColumnSpan="2" DataContext="{Binding Ricerca}"/>

    </Grid>

</mah:MetroWindow>
