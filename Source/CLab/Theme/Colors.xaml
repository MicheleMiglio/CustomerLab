<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ -->
    <!-- COLORI: tutti dichiarati qui, in cima. Nessun Brush qui sotto -->
    <!-- deve mai puntare a un colore non ancora definito in questo    -->
    <!-- blocco (i riferimenti in avanti in WPF non sono affidabili).  -->
    <!-- ============================================================ -->

    <Color x:Key="ColorPrimaryDark">#0F2D4A</Color>
    <Color x:Key="ColorPrimary">#185FA5</Color>
    <Color x:Key="ColorPrimaryLight">#378ADD</Color>
    <Color x:Key="ColorAccent">#BA7517</Color>
    <Color x:Key="ColorTestoSuScuro">#E6F1FB</Color>
    <Color x:Key="ColorTestoSuScuroSecondario">#8FA3C0</Color>
    <Color x:Key="ColorTestoPrimario">#212529</Color>
    <Color x:Key="ColorTestoSecondario">#6C757D</Color>
    <Color x:Key="ColorBordo">#D8DEE5</Color>
    <Color x:Key="ColorSfondoChiaro">#F5F7FA</Color>

    <!-- Sidebar: rail scura piena, stessa tinta del navy di brand -->
    <Color x:Key="ColorSidebarBackground">#0F2D4A</Color>

    <!-- Stato cliente -->
    <Color x:Key="ColorStatoAttivo">#1D9E75</Color>
    <Color x:Key="ColorStatoStandBy">#EF9F27</Color>
    <Color x:Key="ColorStatoCessato">#E24B4A</Color>

    <!-- Danger / Success: stesse tinte dello stato, chiave semantica diversa -->
    <Color x:Key="ColorDanger">#E24B4A</Color>
    <Color x:Key="ColorSuccess">#1D9E75</Color>

    <!-- ============================================================ -->
    <!-- BRUSH: da qui in poi solo SolidColorBrush, tutti basati sui   -->
    <!-- Color dichiarati sopra.                                       -->
    <!-- ============================================================ -->

    <SolidColorBrush x:Key="BrushPrimaryDark" Color="{StaticResource ColorPrimaryDark}"/>
    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}"/>
    <SolidColorBrush x:Key="BrushPrimaryLight" Color="{StaticResource ColorPrimaryLight}"/>
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}"/>

    <SolidColorBrush x:Key="BrushStatoAttivo" Color="{StaticResource ColorStatoAttivo}"/>
    <SolidColorBrush x:Key="BrushStatoStandBy" Color="{StaticResource ColorStatoStandBy}"/>
    <SolidColorBrush x:Key="BrushStatoCessato" Color="{StaticResource ColorStatoCessato}"/>

    <SolidColorBrush x:Key="BrushStatoAttivoLight" Color="{StaticResource ColorStatoAttivo}" Opacity="0.15"/>
    <SolidColorBrush x:Key="BrushStatoStandByLight" Color="{StaticResource ColorStatoStandBy}" Opacity="0.18"/>
    <SolidColorBrush x:Key="BrushStatoCessatoLight" Color="{StaticResource ColorStatoCessato}" Opacity="0.15"/>

    <SolidColorBrush x:Key="BrushTestoSuScuro" Color="{StaticResource ColorTestoSuScuro}"/>
    <SolidColorBrush x:Key="BrushTestoSuScuroSecondario" Color="{StaticResource ColorTestoSuScuroSecondario}"/>
    <SolidColorBrush x:Key="BrushTestoPrimario" Color="{StaticResource ColorTestoPrimario}"/>
    <SolidColorBrush x:Key="BrushTestoSecondario" Color="{StaticResource ColorTestoSecondario}"/>
    <SolidColorBrush x:Key="BrushBordo" Color="{StaticResource ColorBordo}"/>
    <SolidColorBrush x:Key="BrushSfondoChiaro" Color="{StaticResource ColorSfondoChiaro}"/>
    <SolidColorBrush x:Key="BrushSfondoAlternato" Color="{StaticResource ColorSfondoChiaro}" Opacity="0.5"/>

    <SolidColorBrush x:Key="BrushSidebarBackground" Color="{StaticResource ColorSidebarBackground}"/>
    <SolidColorBrush x:Key="BrushSidebarHover" Color="White" Opacity="0.06"/>
    <SolidColorBrush x:Key="BrushSidebarSelected" Color="{StaticResource ColorAccent}" Opacity="0.18"/>
    <SolidColorBrush x:Key="BrushDivisoreSuScuro" Color="White" Opacity="0.08"/>

    <!-- Accent: stati hover/selected (wash trasparente, si adatta a qualsiasi sfondo) -->
    <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorAccent}" Opacity="0.08"/>
    <SolidColorBrush x:Key="BrushAccentSelected" Color="{StaticResource ColorAccent}" Opacity="0.16"/>

    <!-- Danger (azioni distruttive: elimina, rimuovi) -->
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}"/>
    <SolidColorBrush x:Key="BrushDangerLight" Color="{StaticResource ColorDanger}" Opacity="0.12"/>

    <!-- Success (conferme, icone positive es. email) -->
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}"/>
    <SolidColorBrush x:Key="BrushSuccessLight" Color="{StaticResource ColorSuccess}" Opacity="0.12"/>

    <!-- Info (box informativi, icone neutre es. telefono) -->
    <SolidColorBrush x:Key="BrushInfoLight" Color="{StaticResource ColorPrimaryLight}" Opacity="0.12"/>
    <SolidColorBrush x:Key="BrushInfoBorder" Color="{StaticResource ColorPrimaryLight}" Opacity="0.4"/>

</ResourceDictionary>
