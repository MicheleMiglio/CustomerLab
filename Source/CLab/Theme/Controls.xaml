<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!-- ========================= -->
    <!-- Base Button (i bottoni concreti - Primary/Outline/Icon - sono -->
    <!-- in Theme/Buttons.xaml: quello è lo standard usato ovunque)     -->
    <!-- ========================= -->

    <Style x:Key="BaseButton"
           TargetType="Button">

        <Setter Property="Height"
                Value="{StaticResource ButtonHeight}"/>

        <Setter Property="Padding"
        Value="16,0"/>

        <Setter Property="Background"
                Value="Transparent"/>

        <Setter Property="BorderThickness"
                Value="0"/>

        <Setter Property="Cursor"
                Value="Hand"/>

        <Setter Property="FontSize"
                Value="{StaticResource FontSizeBody}"/>

    </Style>


    <!-- ========================= -->
    <!-- Sidebar -->
    <!-- ========================= -->

    <Style x:Key="SidebarToggleButton"
       TargetType="Button"
       BasedOn="{StaticResource BaseButton}">

        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

    </Style>


    <!-- ============================================================ -->
    <!-- CARD: unico contenitore condiviso da tutti i moduli. Prima    -->
    <!-- ogni vista reinventava "Border bianco + BrushBordo + un       -->
    <!-- CornerRadius diverso" a mano - ora è tutto qui.                -->
    <!-- Regola design system: una card esiste perché crea una         -->
    <!-- superficie distinta, non come contenitore di default. Bordo   -->
    <!-- sottile, niente ombra, radius coerente col sistema.            -->
    <!-- ============================================================ -->

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBordoLeggero}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Variante per righe cliccabili dentro una card (liste, tab) -->
    <Style x:Key="CardRowStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushSfondoFine}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        <Setter Property="Padding" Value="10,9"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>


    <!-- ============================================================ -->
    <!-- PALLINO DI STATO: verde/giallo/rosso, usato per riassumere lo -->
    <!-- stato di una sezione senza dover leggere il dettaglio. Mai    -->
    <!-- usato in sidebar/navigazione: lì l'accento resta blu.         -->
    <!-- ============================================================ -->

    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="6"/>
        <Setter Property="Height" Value="6"/>
    </Style>

    <!-- Badge/pillola con testo, per stati come "scaduto", "da versare", "completata".
         Forma pill piena (radius 999): le pill restano riservate a badge/stato. -->
    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="8,3"/>
    </Style>

    <Style x:Key="StatusPillText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>


</ResourceDictionary>