<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">


    <!-- ========================= -->
    <!-- Sidebar -->
    <!-- ========================= -->

    <sys:Double x:Key="SidebarWidthExpanded">
        240
    </sys:Double>

    <sys:Double x:Key="SidebarWidthCollapsed">
        68
    </sys:Double>


    <!-- ========================= -->
    <!-- Spaziature standard -->
    <!-- ========================= -->

    <sys:Double x:Key="SpacingXS">
        4
    </sys:Double>

    <sys:Double x:Key="SpacingSM">
        8
    </sys:Double>

    <sys:Double x:Key="SpacingMD">
        16
    </sys:Double>

    <sys:Double x:Key="SpacingLG">
        24
    </sys:Double>

    <sys:Double x:Key="SpacingXL">
        32
    </sys:Double>


    <!-- ========================= -->
    <!-- Corner Radius -->
    <!-- ========================= -->

    <CornerRadius x:Key="RadiusSmall">
        8
    </CornerRadius>

    <CornerRadius x:Key="RadiusMedium">
        12
    </CornerRadius>

    <CornerRadius x:Key="RadiusLarge">
        20
    </CornerRadius>

    <!-- ========================= -->
    <!-- Elementi UI -->
    <!-- ========================= -->

    <sys:Double x:Key="ButtonHeight">
        40
    </sys:Double>

    <sys:Double x:Key="InputHeight">
        38
    </sys:Double>

    <sys:Double x:Key="HeaderHeight">
        72
    </sys:Double>


</ResourceDictionary>