<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">


    <!-- ========================= -->
    <!-- Sidebar (larghezze reali usate da MainViewModel.SidebarWidth) -->
    <!-- ========================= -->

    <sys:Double x:Key="SidebarWidthExpanded">
        220
    </sys:Double>

    <sys:Double x:Key="SidebarWidthCollapsed">
        70
    </sys:Double>


    <!-- ========================= -->
    <!-- Spaziature standard: scala 4 / 8 / 12 / 16 / 20 / 24 / 32.
         Titolo→sottotitolo: 4-8 | sezione→contenuto: 12-16 |
         sezioni principali: 24-32 | elementi correlati: 8-12. -->
    <!-- ========================= -->

    <sys:Double x:Key="SpacingXS">
        4
    </sys:Double>

    <sys:Double x:Key="SpacingSM">
        8
    </sys:Double>

    <sys:Double x:Key="SpacingMD">
        12
    </sys:Double>

    <sys:Double x:Key="SpacingLG">
        16
    </sys:Double>

    <sys:Double x:Key="SpacingXL">
        20
    </sys:Double>

    <sys:Double x:Key="SpacingXXL">
        24
    </sys:Double>

    <sys:Double x:Key="SpacingXXXL">
        32
    </sys:Double>


    <!-- ========================= -->
    <!-- Corner Radius: pochi valori coerenti.
         Small 6 = controlli piccoli (badge interni, checkbox)
         Medium 10 = card / superfici
         Large 12 = overlay / pannelli
         (pillole e badge usano radius pieno dedicato, vedi Controls.xaml) -->
    <!-- ========================= -->

    <CornerRadius x:Key="RadiusSmall">
        6
    </CornerRadius>

    <CornerRadius x:Key="RadiusMedium">
        10
    </CornerRadius>

    <CornerRadius x:Key="RadiusLarge">
        12
    </CornerRadius>

    <!-- ========================= -->
    <!-- Elementi UI -->
    <!-- ========================= -->

    <sys:Double x:Key="ButtonHeight">
        40
    </sys:Double>

    <sys:Double x:Key="InputHeight">
        38
    </sys:Double>

    <sys:Double x:Key="HeaderHeight">
        72
    </sys:Double>


</ResourceDictionary>