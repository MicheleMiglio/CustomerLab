<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Style x:Key="SidebarMenuButton"
           TargetType="Button"
           BasedOn="{StaticResource BaseButton}">


        <Setter Property="Height"
                Value="44"/>

        <Setter Property="Margin"
                Value="8,1"/>

        <Setter Property="HorizontalContentAlignment"
                Value="Left"/>

        <Setter Property="Foreground"
                Value="{StaticResource BrushTestoSuScuroSecondario}"/>


        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusMedium}">


                        <Grid>

                            <ContentPresenter
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"/>


                        </Grid>


                    </Border>


                </ControlTemplate>

            </Setter.Value>

        </Setter>


        <Style.Triggers>


            <!-- Hover -->
            <Trigger Property="IsMouseOver"
                     Value="True">

                <Setter Property="Background"
                        Value="{StaticResource BrushSidebarHover}"/>

            </Trigger>


            <!-- Selezionato -->
            <DataTrigger Binding="{Binding IsSelezionato}"
                         Value="True">

                <Setter Property="Background"
                        Value="{StaticResource BrushSidebarSelected}"/>

                <Setter Property="Foreground"
                        Value="{StaticResource BrushAccent}"/>

            </DataTrigger>


        </Style.Triggers>

    </Style>


</ResourceDictionary>