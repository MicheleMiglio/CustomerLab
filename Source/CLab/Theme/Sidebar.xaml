<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Style x:Key="SidebarMenuButton"
           TargetType="Button"
           BasedOn="{StaticResource BaseButton}">


        <Setter Property="Height"
                Value="44"/>

        <Setter Property="Margin"
                Value="8,1"/>

        <Setter Property="HorizontalContentAlignment"
                Value="Left"/>

        <Setter Property="Foreground"
                Value="{StaticResource BrushTestoSuScuroSecondario}"/>


        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="0,10,10,0"
                            ClipToBounds="True">


                        <Grid>

                            <Border x:Name="AccentBar"
                                    Width="3"
                                    HorizontalAlignment="Left"
                                    Margin="0"
                                    Background="{StaticResource BrushSidebarAccent}"
                                    Visibility="Collapsed"/>

                            <ContentPresenter
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"/>


                        </Grid>


                    </Border>


                    <ControlTemplate.Triggers>

                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background"
                                    Value="{StaticResource BrushSidebarHover}"/>
                        </Trigger>

                        <!-- Selezionato: sfondo blu tenue + barretta di accento -->
                        <DataTrigger Binding="{Binding IsSelezionato}" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background"
                                    Value="{StaticResource BrushSidebarSelected}"/>
                            <Setter TargetName="AccentBar" Property="Visibility" Value="Visible"/>
                        </DataTrigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>


        <Style.Triggers>

            <!-- Selezionato: testo più chiaro (non passa dal template, va sulla Style) -->
            <DataTrigger Binding="{Binding IsSelezionato}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BrushTestoSuScuro}"/>
            </DataTrigger>

        </Style.Triggers>

    </Style>


</ResourceDictionary>