<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ -->
    <!-- VOCE DI MENU SIDEBAR (design system CLab 2.0: rail chiara).   -->
    <!--                                                              -->
    <!-- - Riposo:  testo neutro scuro, sfondo trasparente             -->
    <!-- - Hover:   wash neutro leggermente più scuro del rail         -->
    <!-- - Attivo:  wash blu tenue + testo/icona ColorPrimary,         -->
    <!--            radius 6. Niente barre di accento laterali:        -->
    <!--            la voce attiva non deve dominare la pagina.        -->
    <!-- - Collassata: solo icona, perfettamente centrata, con         -->
    <!--            tooltip (il ToolTip è già impostato dalla View).   -->
    <!-- ============================================================ -->

    <Style x:Key="SidebarMenuButton"
           TargetType="Button"
           BasedOn="{StaticResource BaseButton}">

        <Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="10,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">

                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            ClipToBounds="True">

                        <ContentPresenter x:Name="Content"
                                          Margin="10,0,6,0"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Hover: neutro, discreto, nessuna animazione -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background"
                                    Value="{StaticResource BrushSidebarHover}"/>
                        </Trigger>

                        <!-- Attivo: wash blu tenue -->
                        <DataTrigger Binding="{Binding IsSelezionato}" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background"
                                    Value="{StaticResource BrushSidebarSelected}"/>
                        </DataTrigger>

                        <!-- Collassata: icona sola, centrata al pixel sul rail -->
                        <DataTrigger Binding="{Binding DataContext.SidebarEspansa,
                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="False">
                            <Setter TargetName="Content" Property="HorizontalAlignment" Value="Center"/>
                            <Setter TargetName="Content" Property="Margin" Value="0"/>
                        </DataTrigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>

            <!-- Attivo: testo e icona in blu ColorPrimary -->
            <DataTrigger Binding="{Binding IsSelezionato}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BrushSidebarAccent}"/>
            </DataTrigger>

        </Style.Triggers>

    </Style>

</ResourceDictionary>