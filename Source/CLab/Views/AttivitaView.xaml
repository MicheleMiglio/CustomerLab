<UserControl x:Class="CLab.Views.AttivitaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:local="clr-namespace:CLab.Models"
             xmlns:converters="clr-namespace:CLab.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:views="clr-namespace:CLab.Views">

    <UserControl.Resources>
        <ResourceDictionary>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <converters:EnumToVisibilityConverter x:Key="EnumToVisibility"/>
            <converters:TipoCampoLabelConverter   x:Key="TipoCampoLabel"/>

            <ObjectDataProvider x:Key="Periodicita" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:Periodicita"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <ObjectDataProvider x:Key="TipiCampo" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:TipoCampoAttivita"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <!-- ============================================================ -->
            <!-- RESTYLE (stile Studi): tab a chip (segmented), azioni griglia -->
            <!-- ghost, header colonna con indicatore di ordinamento. Stili    -->
            <!-- locali: pattern già usato nel modulo Studi (risorsa locale,  -->
            <!-- non condivisa).                                              -->
            <!-- ============================================================ -->

            <!-- Chip tab (segmented): ghost, hover neutro, selezione wash blu. -->
            <Style x:Key="ChipTab" TargetType="Button">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Padding" Value="12,4"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushHoverNeutro}"/>
                                </Trigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="Sel"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushSidebarSelectedBadge}"/>
                                </MultiDataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ChipTabCatalogo" TargetType="Button" BasedOn="{StaticResource ChipTab}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ConfigurazioneAttiva}" Value="False">
                        <Setter Property="Tag" Value="Sel"/>
                        <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ChipTabConfigurazione" TargetType="Button" BasedOn="{StaticResource ChipTab}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ConfigurazioneAttiva}" Value="True">
                        <Setter Property="Tag" Value="Sel"/>
                        <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ChipTabPerCliente" TargetType="Button" BasedOn="{StaticResource ChipTab}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ModalitaPerCliente}" Value="True">
                        <Setter Property="Tag" Value="Sel"/>
                        <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ChipTabPerAttivita" TargetType="Button" BasedOn="{StaticResource ChipTab}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ModalitaPerCliente}" Value="False">
                        <Setter Property="Tag" Value="Sel"/>
                        <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Azioni inline della griglia: icone ghost (nessun chrome), grigie,
                 feedback solo in hover (come Studi). -->
            <Style x:Key="AzioneGriglia" TargetType="Button">
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushHoverNeutro}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Elimina: neutra a riposo, rosso solo in hover. -->
            <Style x:Key="AzioneGrigliaElimina" TargetType="Button" BasedOn="{StaticResource AzioneGriglia}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource BrushStatoCessato}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Header di colonna locale: kit del Theme + indicatore di direzione. -->
            <Style x:Key="AttivitaColumnHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridColumnHeader">
                            <Grid>
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{StaticResource BrushBordoLeggero}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center"/>
                                        <TextBlock x:Name="freccia" Text="▼" FontSize="8"
                                            Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Margin="0,1,12,0" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left"
                                    Width="4" Cursor="SizeWE">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Rectangle Fill="Transparent"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                                    Width="4" Cursor="SizeWE">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Rectangle Fill="Transparent"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="SortDirection" Value="Ascending">
                                    <Setter TargetName="freccia" Property="Text" Value="▲"/>
                                    <Setter TargetName="freccia" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                </Trigger>
                                <Trigger Property="SortDirection" Value="Descending">
                                    <Setter TargetName="freccia" Property="Text" Value="▼"/>
                                    <Setter TargetName="freccia" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushSfondoChiaro}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER: titolo + tab (Catalogo/Configurazione, stile chip) + azione primaria -->
        <Border Grid.Row="0" Style="{StaticResource ModuleHeaderBorderStyle}" Padding="28,0" Height="64">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Attività" Style="{StaticResource ModuleTitleStyle}"
                           VerticalAlignment="Center"/>

                <Border Grid.Column="1" Background="{StaticResource BrushSfondoFine}"
                        CornerRadius="{StaticResource RadiusSmall}" Padding="2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Catalogo" Style="{StaticResource ChipTabCatalogo}"
                                Command="{Binding MostraCatalogoCommand}"/>
                        <Button Content="Configurazione" Style="{StaticResource ChipTabConfigurazione}"
                                Command="{Binding MostraConfigurazioneCommand}"/>
                    </StackPanel>
                </Border>

                <Button Grid.Column="3" Style="{StaticResource BtnPrimary}" Height="32" MinWidth="120" Padding="12,0"
                        Margin="20,0,0,0" Command="{Binding NuovoCommand}"
                        >
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBootstrapIcons Kind="Plus" Width="11" Height="11"
                            Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Nuova attività" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- AREA CONTENUTO -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar: solo per il Catalogo, ricerca posizionata a destra (come Studi) -->
            <Grid Grid.Row="0" Margin="28,10,28,0"
                Visibility="{Binding ConfigurazioneAttiva, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="250" Height="32" Background="White" Grid.Column="1"
                        BorderBrush="{StaticResource BrushBordo}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconBootstrapIcons Grid.Column="0" Kind="Search" Width="13" Height="13"
                                Foreground="{StaticResource BrushTestoSecondario}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding FiltroCatalogoTesto, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent" FontSize="12"
                                 Foreground="{StaticResource BrushTestoPrimario}"
                                 VerticalContentAlignment="Center"
                                 mah:TextBoxHelper.Watermark="  Cerca attività…"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Elenco catalogo -->
            <DataGrid Grid.Row="1" x:Name="gridAttivita" ItemsSource="{Binding ElencoFiltrato}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  Style="{StaticResource ModuleDataGridStyle}"
                  RowHeight="44" HeadersVisibility="Column"
                  Margin="28,12,28,0"
                  MouseDoubleClick="gridAttivita_MouseDoubleClick"
                  Visibility="{Binding ConfigurazioneAttiva, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AttivitaColumnHeaderStyle}"/>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource ModuleDataGridRowClickableSelectedStyle}"/>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NOME" Binding="{Binding Nome}" Width="2*" SortMemberPath="Nome">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="14,0"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="PERIODICITÀ" Binding="{Binding Periodicita}" Width="1.2*" SortMemberPath="Periodicita">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="14,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="TIPO CAMPO" Binding="{Binding TipoCampo, Converter={StaticResource TipoCampoLabel}}" Width="1.2*" SortMemberPath="TipoCampo">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="14,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Style="{StaticResource AzioneGriglia}"
                                        Command="{Binding DataContext.ModificaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" ToolTip="Modifica">
                                        <iconPacks:PackIconBootstrapIcons Kind="Pencil"
                                        Width="13" Height="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                                    <Button Style="{StaticResource AzioneGrigliaElimina}" Margin="2,0,0,0"
                                        Command="{Binding DataContext.EliminaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" ToolTip="Elimina">
                                        <iconPacks:PackIconBootstrapIcons Kind="Trash"
                                        Width="13" Height="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- EMPTY STATE: solo per il catalogo (nessuna attività / nessun risultato dalla ricerca) -->
            <StackPanel Grid.Row="1" Margin="28,70,28,24" HorizontalAlignment="Center"
                Visibility="{Binding ConfigurazioneAttiva, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                <TextBlock Text="{Binding EmptyStateTesto}" FontSize="14"
                    Foreground="{StaticResource BrushTestoSecondario}" HorizontalAlignment="Center"
                    Visibility="{Binding NessunRisultato, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <!-- Configurazione: doppia lista -->
            <Grid Grid.Row="1" Visibility="{Binding ConfigurazioneAttiva, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Sotto-schede (stile chip) + selettore -->
                <Grid Grid.Row="0" Margin="28,5,28,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource BrushSfondoFine}"
                            CornerRadius="{StaticResource RadiusSmall}" Padding="2" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Per cliente" Style="{StaticResource ChipTabPerCliente}"
                                    Command="{Binding MostraConfigPerClienteCommand}"/>
                            <Button Content="Per attività" Style="{StaticResource ChipTabPerAttivita}"
                                    Command="{Binding MostraConfigPerAttivitaCommand}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            VerticalAlignment="Top">

                        <StackPanel Margin="0,0,10,0"
                Visibility="{Binding ModalitaPerCliente, Converter={StaticResource BoolToVisibility}}">

                            <TextBlock Text="SELEZIONA STUDIO"
                   Margin="0,0,0,2"
                   FontSize="10"
                   FontWeight="Medium"
                   Foreground="{StaticResource BrushTestoSecondario}"/>

                            <ComboBox Width="170"
                  Height="34"
                  IsTextSearchEnabled="True"
                  TextSearch.TextPath="Nome"
                  ItemsSource="{Binding ReferentiFiltroConfigurazione}"
                  SelectedItem="{Binding ReferenteFiltroConfigurazione}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,0"
                Visibility="{Binding ModalitaPerCliente, Converter={StaticResource BoolToVisibility}}">

                            <TextBlock Text="SELEZIONA CLIENTE"
                   Margin="0,0,0,2"
                   FontSize="10"
                   FontWeight="Medium"
                   Foreground="{StaticResource BrushTestoSecondario}"/>

                            <ComboBox Width="260"
                  Height="34"
                  ItemsSource="{Binding ClientiPerConfigurazione}"
                  TextSearch.TextPath="RagioneSociale"
                  SelectedItem="{Binding ClienteConfigurazione}"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding ModalitaPerCliente, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">

                            <TextBlock Text="SELEZIONA ATTIVITÀ"
                   Margin="0,0,0,2"
                   FontSize="10"
                   FontWeight="Medium"
                   Foreground="{StaticResource BrushTestoSecondario}"/>

                            <ComboBox Width="260"
                  Height="34"
                  ItemsSource="{Binding ElencoFiltrato}"
                  SelectedItem="{Binding AttivitaConfigurazione}"/>
                        </StackPanel>

                    </StackPanel>
                </Grid>

                <!-- Le due colonne -->
                <Grid Grid.Row="1" Margin="28,0,28,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ASSEGNATE -->
                    <Border Grid.Column="0" BorderBrush="{StaticResource BrushBordo}" BorderThickness="1" CornerRadius="8" Background="White" Opacity="0.6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Margin="14,12,14,8"
                                   Text="{Binding AttivitaAssegnateConfig.Count, StringFormat='ASSEGNATE ({0})'}"
                                   FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTestoSecondario}"
                                   Visibility="{Binding ModalitaPerCliente, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Grid.Row="0" Margin="14,12,14,8"
                                   Text="{Binding ClientiAssegnatiConfig.Count, StringFormat='ASSEGNATI ({0})'}"
                                   FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTestoSecondario}"
                                   Visibility="{Binding ModalitaPerCliente, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}"/>

                            <Border Grid.Row="1" Margin="14,0,14,10" Background="White"
                                BorderBrush="{StaticResource BrushBordo}" BorderThickness="1" CornerRadius="6" Height="32">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconBootstrapIcons Grid.Column="0"
                                    Kind="Search" Width="12" Height="12" Foreground="{StaticResource BrushTestoSecondario}"
                                    Margin="9,0,5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1"
                                         Text="{Binding FiltroAssegnateTesto, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent"
                                         FontSize="12" Foreground="{StaticResource BrushTestoPrimario}"
                                         VerticalContentAlignment="Center" Height="30"
                                         mah:TextBoxHelper.Watermark="  Cerca tra le assegnate…"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14,0,14,14">

                                    <ItemsControl ItemsSource="{Binding AttivitaAssegnateConfig}"
                                              Visibility="{Binding ModalitaPerCliente, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BrushSfondoChiaro}" CornerRadius="5"
                                                    Padding="10,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Nome}" FontSize="12" Foreground="{StaticResource BrushTestoPrimario}"/>
                                                            <TextBlock FontSize="10" Foreground="{StaticResource BrushTestoSecondario}" Margin="0,2,0,0">
                                                                <Run Text="{Binding Periodicita}"/>
                                                                <Run Text=" · "/>
                                                                <Run Text="{Binding TipoCampo, Converter={StaticResource TipoCampoLabel}}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource AzioneGriglia}" Padding="4" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.RimuoviAttivitaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" ToolTip="Non assegnare">
                                                            <iconPacks:PackIconBootstrapIcons Kind="Dash" Width="12" Height="12" Foreground="{StaticResource BrushTestoSecondario}"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding ClientiAssegnatiConfig}"
                                              Visibility="{Binding ModalitaPerCliente, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BrushSfondoChiaro}" CornerRadius="5"
                                                    Padding="10,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding RagioneSociale}" FontSize="12" Foreground="{StaticResource BrushTestoPrimario}"/>
                                                            <TextBlock Text="{Binding PartitaIva, StringFormat='P.IVA {0}'}"
                                                                   FontSize="10" Foreground="{StaticResource BrushTestoSecondario}" Margin="0,2,0,0"
                                                                   Visibility="{Binding PartitaIva, Converter={StaticResource BoolToVisibility}}"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource AzioneGriglia}" Padding="4" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.RimuoviClienteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" ToolTip="Non assegnare">
                                                            <iconPacks:PackIconBootstrapIcons Kind="Dash" Width="12" Height="12" Foreground="{StaticResource BrushTestoSecondario}"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- NON ASSEGNATE -->
                    <Border Grid.Column="2" BorderBrush="{StaticResource BrushBordo}" BorderThickness="1" CornerRadius="8"  Background="White" Opacity="0.6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Margin="14,12,14,8"
                                   Text="{Binding AttivitaNonAssegnateConfig.Count, StringFormat='NON ASSEGNATE ({0})'}"
                                   FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTestoSecondario}"
                                   Visibility="{Binding ModalitaPerCliente, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Grid.Row="0" Margin="14,12,14,8"
                                   Text="{Binding ClientiNonAssegnatiConfig.Count, StringFormat='NON ASSEGNATI ({0})'}"
                                   FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTestoSecondario}"
                                   Visibility="{Binding ModalitaPerCliente, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}"/>

                            <Border Grid.Row="1" Margin="14,0,14,10" Background="White"
                                BorderBrush="{StaticResource BrushBordo}" BorderThickness="1" CornerRadius="6" Height="32">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconBootstrapIcons Grid.Column="0"
                                    Kind="Search" Width="12" Height="12" Foreground="{StaticResource BrushTestoSecondario}"
                                    Margin="9,0,5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1"
                                         Text="{Binding FiltroNonAssegnateTesto, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent"
                                         FontSize="12" Foreground="{StaticResource BrushTestoPrimario}"
                                         VerticalContentAlignment="Center" Height="30"
                                         mah:TextBoxHelper.Watermark="  Cerca tra le non assegnate…"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14,0,14,14">

                                    <ItemsControl ItemsSource="{Binding AttivitaNonAssegnateConfig}"
                                              Visibility="{Binding ModalitaPerCliente, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BrushSfondoChiaro}" CornerRadius="5"
                                                    Padding="10,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Nome}" FontSize="12" Foreground="{StaticResource BrushTestoPrimario}"/>
                                                            <TextBlock FontSize="10" Foreground="{StaticResource BrushTestoSecondario}" Margin="0,2,0,0">
                                                                <Run Text="{Binding Periodicita}"/>
                                                                <Run Text=" · "/>
                                                                <Run Text="{Binding TipoCampo, Converter={StaticResource TipoCampoLabel}}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource AzioneGriglia}" Padding="4" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.AggiungiAttivitaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" ToolTip="Assegna">
                                                            <iconPacks:PackIconBootstrapIcons Kind="Plus" Width="12" Height="12" Foreground="{StaticResource BrushTestoSecondario}"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding ClientiNonAssegnatiConfig}"
                                              Visibility="{Binding ModalitaPerCliente, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BrushSfondoChiaro}" CornerRadius="5"
                                                    Padding="10,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding RagioneSociale}" FontSize="12" Foreground="{StaticResource BrushTestoPrimario}"/>
                                                            <TextBlock Text="{Binding PartitaIva, StringFormat='P.IVA {0}'}"
                                                                   FontSize="10" Foreground="{StaticResource BrushTestoSecondario}" Margin="0,2,0,0"
                                                                   Visibility="{Binding PartitaIva, Converter={StaticResource BoolToVisibility}}"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource AzioneGriglia}" Padding="4" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.AggiungiClienteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" ToolTip="Assegna">
                                                            <iconPacks:PackIconBootstrapIcons Kind="Plus" Width="12" Height="12" Foreground="{StaticResource BrushTestoSecondario}"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                </Grid>
            </Grid>

        </Grid>

        <!-- MODAL nuova/modifica attività (pattern Studi): campo Nome, Periodicità,
             Tipo di campo e i campi specifici del tipo, più, in modifica, l'elenco
             dei clienti a cui l'attività è assegnata (sola lettura). La conferma
             delle modifiche non salvate è già prevista dal ModalDialogControl. -->
        <views:ModalDialogControl Grid.Row="0" Grid.RowSpan="2"
            IsAperto="{Binding PannelloAperto}"
            Titolo="{Binding TitoloPannello}"
            ComandoChiudi="{Binding AnnullaCommand}"
            ComandoSalva="{Binding SalvaCommand}"
            HaModificheNonSalvate="{Binding HaModifiche}">

            <views:ModalDialogControl.Contenuto>
                <StackPanel>

                    <TextBlock Text="NOME" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding FormNome, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,16"/>

                    <TextBlock Text="PERIODICITÀ" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Source={StaticResource Periodicita}}"
                          SelectedItem="{Binding FormPeriodicita}" Margin="0,4,0,16"/>

                    <TextBlock Text="TIPO DI CAMPO" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Source={StaticResource TipiCampo}}"
                          SelectedItem="{Binding FormTipoCampo}" Margin="0,4,0,16"/>

                    <StackPanel Visibility="{Binding FormTipoCampo, Converter={StaticResource EnumToVisibility}, ConverterParameter=TestoLibero}">
                        <TextBlock Text="LUNGHEZZA MASSIMA" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding FormTestoLunghezzaMassima, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,16"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding FormTipoCampo, Converter={StaticResource EnumToVisibility}, ConverterParameter=Numero}"
                            Orientation="Horizontal" Margin="0,0,0,16">
                        <CheckBox IsChecked="{Binding FormNumeroEImporto}"/>
                        <TextBlock Text="È un importo in euro" Margin="6,0,0,0"
                               Foreground="{StaticResource BrushTestoSecondario}" FontSize="12"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding FormTipoCampo, Converter={StaticResource EnumToVisibility}, ConverterParameter=Tendina}">

                        <TextBlock Text="OPZIONI" Style="{StaticResource FieldLabel}"/>
                        <ItemsControl ItemsSource="{Binding FormOpzioni}" Margin="0,4,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushSfondoChiaro}" CornerRadius="4"
                                        Padding="8,4" Margin="0,0,6,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource BrushTestoPrimario}"/>
                                            <iconPacks:PackIconBootstrapIcons Kind="XLg" Width="9" Height="9"
                                                   Foreground="{StaticResource BrushTestoSecondario}"
                                                   Cursor="Hand" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <iconPacks:PackIconBootstrapIcons.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                        Command="{Binding DataContext.RimuoviOpzioneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                </iconPacks:PackIconBootstrapIcons.InputBindings>
                                            </iconPacks:PackIconBootstrapIcons>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding FormNuovaOpzione, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Style="{StaticResource BtnOutline}" Margin="6,0,0,0"
                                Content="Aggiungi" Command="{Binding AggiungiOpzioneCommand}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <CheckBox IsChecked="{Binding FormTendinaRichiedeImporto}"/>
                            <TextBlock Text="Richiedi anche un importo abbinato" Margin="6,0,0,0"
                                   Foreground="{StaticResource BrushTestoSecondario}" FontSize="12"/>
                        </StackPanel>

                    </StackPanel>

                </StackPanel>
            </views:ModalDialogControl.Contenuto>
        </views:ModalDialogControl>

    </Grid>
</UserControl>
