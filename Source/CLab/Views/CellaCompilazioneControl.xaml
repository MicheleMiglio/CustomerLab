<UserControl x:Class="CLab.Views.CellaCompilazioneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:converters="clr-namespace:CLab.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityLocale"/>
        <converters:EnumToVisibilityConverter x:Key="EnumToVisibilityLocale"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*" MinWidth="160"/>
        </Grid.ColumnDefinitions>

        <!-- Colonna 0: solo il controllo che serve al tipo di campo, senza più
             etichette impilate sopra — una riga alta 34px, tranne Testo libero
             che resta un'area a più righe (è l'unico caso davvero lungo). -->
        <StackPanel Grid.Column="0" VerticalAlignment="Top">

            <!-- Sì / No -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="34"
                    Visibility="{Binding TipoCampo, Converter={StaticResource EnumToVisibilityLocale}, ConverterParameter=SiNo}">
                <CheckBox x:Name="ChkSiNo" Style="{DynamicResource ModuleCheckBoxStyle}"
                      IsChecked="{Binding ValoreBooleano, Mode=OneWay}"
                      Checked="ChkSiNo_Checked" Unchecked="ChkSiNo_Unchecked"/>
                <TextBlock Text="Completato" FontSize="13" Foreground="{StaticResource BrushTestoPrimario}"
                       Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Testo libero -->
            <StackPanel Visibility="{Binding TipoCampo, Converter={StaticResource EnumToVisibilityLocale}, ConverterParameter=TestoLibero}">
                <TextBox AcceptsReturn="True" TextWrapping="Wrap" Height="90" Width="260"
                     VerticalContentAlignment="Top"
                     MaxLength="{Binding TestoLunghezzaMassimaEffettiva}"
                     Text="{Binding ValoreTesto, UpdateSourceTrigger=LostFocus}"/>
            </StackPanel>

            <!-- Numero -->
            <Grid Height="34" Visibility="{Binding TipoCampo, Converter={StaticResource EnumToVisibilityLocale}, ConverterParameter=Numero}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="{StaticResource BrushBordo}" BorderThickness="1" CornerRadius="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource BrushSfondoChiaro}" CornerRadius="4,0,0,4" Padding="10,0"
                            Visibility="{Binding EImporto, Converter={StaticResource BoolToVisibilityLocale}}">
                            <TextBlock Text="€" Foreground="{StaticResource BrushTestoSecondario}" VerticalAlignment="Center" FontSize="12"/>
                        </Border>
                        <TextBox Grid.Column="1" BorderThickness="0" TextAlignment="Right" Padding="8,0" VerticalContentAlignment="Center"
                             Text="{Binding ValoreNumero, UpdateSourceTrigger=LostFocus, StringFormat=N2}"/>
                    </Grid>
                </Border>
                <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Padding="6" Margin="4,0,0,0"
                    Click="PulisciNumero_Click" ToolTip="Svuota">
                    <iconPacks:PackIconBootstrapIcons Kind="XLg" Width="10" Height="10" Foreground="{StaticResource BrushTestoSecondario}"/>
                </Button>
            </Grid>

            <!-- Tendina (+ eventuale importo abbinato): affiancati sulla stessa
                 riga invece che impilati verticalmente, per restare allineati
                 col resto del pannello. -->
            <StackPanel Orientation="Horizontal" Height="34"
                    Visibility="{Binding TipoCampo, Converter={StaticResource EnumToVisibilityLocale}, ConverterParameter=Tendina}">
                <ComboBox Width="150" ItemsSource="{Binding Opzioni}" SelectedItem="{Binding ValoreTendina}"/>
                <Button Style="{StaticResource BtnIcon}" Padding="6" Margin="4,0,0,0"
                    Click="PulisciTendina_Click" ToolTip="Svuota stato">
                    <iconPacks:PackIconBootstrapIcons Kind="XLg" Width="10" Height="10" Foreground="{StaticResource BrushTestoSecondario}"/>
                </Button>

                <Border Width="1" Margin="12,4" Background="{StaticResource BrushBordoLeggero}"
                    Visibility="{Binding TendinaRichiedeImporto, Converter={StaticResource BoolToVisibilityLocale}}"/>

                <Grid Visibility="{Binding TendinaRichiedeImporto, Converter={StaticResource BoolToVisibilityLocale}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="{StaticResource BrushBordo}" BorderThickness="1" CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource BrushSfondoChiaro}" CornerRadius="4,0,0,4" Padding="10,0">
                                <TextBlock Text="€" Foreground="{StaticResource BrushTestoSecondario}" VerticalAlignment="Center" FontSize="12"/>
                            </Border>
                            <TextBox Grid.Column="1" BorderThickness="0" TextAlignment="Right" Padding="8,0" VerticalContentAlignment="Center"
                                 Text="{Binding ValoreNumero, UpdateSourceTrigger=LostFocus, StringFormat=N2}"/>
                        </Grid>
                    </Border>
                    <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Padding="6" Margin="4,0,0,0"
                        Click="PulisciNumero_Click" ToolTip="Svuota importo">
                        <iconPacks:PackIconBootstrapIcons Kind="XLg" Width="10" Height="10" Foreground="{StaticResource BrushTestoSecondario}"/>
                    </Button>
                </Grid>
            </StackPanel>

        </StackPanel>

        <!-- Nota: resta sempre visibile come richiesto, ma non è più un blocco
             fisso da 110px largo quanto mezzo pannello — è una riga sola, alta
             come gli altri campi, che occupa solo lo spazio che avanza. Il
             tooltip mostra il testo intero se supera la larghezza disponibile. -->
        <Grid Grid.Column="2" Height="34" VerticalAlignment="Top">
            <TextBox Text="{Binding Commento, UpdateSourceTrigger=LostFocus}"
                 VerticalContentAlignment="Center"
                 mah:TextBoxHelper.Watermark="  Nota (facoltativa)"
                 ToolTip="{Binding Commento}"/>
        </Grid>

    </Grid>
</UserControl>