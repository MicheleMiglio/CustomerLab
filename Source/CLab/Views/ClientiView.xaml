                                                <iconPacks:PackIconBootstrapIcons Kind="Gear" Width="12" Height="12" Foreground="{StaticResource BrushTestoSecondario}"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="PROGRAMMA" Style="{StaticResource FieldLabel}"/>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0"
                          ItemsSource="{Binding Programmi}"
                          DisplayMemberPath="Nome"
                          SelectedItem="{Binding Dettaglio.FormProgramma}"/>
                                            <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Padding="6" Margin="4,0,0,0"
                        Command="{Binding ApriGestioneProgrammiCommand}" ToolTip="Gestisci programmi">
                                                <iconPacks:PackIconBootstrapIcons Kind="Gear" Width="12" Height="12" Foreground="{StaticResource BrushTestoSecondario}"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="INTERMEDIARIO" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Dettaglio.FormIntermediario, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Note: altezza ridotta, niente sezione a parte -->
                                <TextBlock Text="NOTE" Style="{StaticResource FieldLabel}" Margin="0,15,0,4"/>
                                <TextBox Text="{Binding Dettaglio.FormNote, UpdateSourceTrigger=PropertyChanged}"
             AcceptsReturn="True" TextWrapping="Wrap" Height="55"
             VerticalContentAlignment="Top" Margin="0,0,0,14"/>

                                <Border BorderBrush="{StaticResource BrushBordo}" BorderThickness="0,0,0,1" Margin="0,0,0,16"/>

                                <!-- ===================== CONTATTI (invariati, non toccare) ===================== -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="TELEFONI" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding Dettaglio.TelefoniCliente}" Margin="0,0,0,6">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource BrushSfondoChiaro}" BorderBrush="{StaticResource BrushBordo}"
                                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0" Style="{StaticResource BtnIcon}"
                                        Command="{Binding DataContext.ImpostaTelefonoPrincipaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Padding="4" ToolTip="Principale"
                                        VerticalAlignment="Center">
                                                                <iconPacks:PackIconBootstrapIcons Kind="StarFill" Width="12" Height="12"
                                        Foreground="{Binding Principale, Converter={StaticResource PrincipaleColore}}"/>
                                                            </Button>
                                                            <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                                            Cursor="Hand" Tag="{Binding}"
                                            MouseLeftButtonUp="ContattoTelefono_Click">
                                                                <TextBlock Text="{Binding Etichetta}" FontSize="10" Foreground="{StaticResource BrushTestoSecondario}"
                                               Visibility="{Binding Etichetta, Converter={StaticResource BoolToVisibility}}"/>
                                                                <TextBlock Text="{Binding Valore}" FontSize="13" Foreground="{StaticResource BrushTestoPrimario}"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Style="{StaticResource BtnIcon}"
                                        Padding="4" ToolTip="Modifica"
                                        Tag="{Binding}" Click="ModificaTelefono_Click"
                                        VerticalAlignment="Center">
                                                                <iconPacks:PackIconBootstrapIcons Kind="Pencil" Width="12" Height="12" Foreground="{StaticResource BrushTestoSecondario}"/>
                                                            </Button>
                                                            <Button Grid.Column="3" Style="{StaticResource BtnIconRed}"
                                        Command="{Binding DataContext.RimuoviTelefonoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Padding="4" ToolTip="Rimuovi"
                                        VerticalAlignment="Center">
                                                                <iconPacks:PackIconBootstrapIcons Kind="Trash" Width="12" Height="12" Foreground="{StaticResource BrushDanger}"/>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border BorderBrush="{StaticResource BrushInfoBorder}" BorderThickness="1" CornerRadius="6"
                    Background="{StaticResource BrushInfoLight}" Padding="10,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="ETICHETTA" Style="{StaticResource FieldLabel}"/>
                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="NUMERO" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Grid.Row="1" Grid.Column="0"
                             Text="{Binding Dettaglio.NuovoTelefonoEtichetta, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBox Grid.Row="1" Grid.Column="2"
                             Text="{Binding Dettaglio.NuovoTelefonoValore, UpdateSourceTrigger=PropertyChanged}"/>
                                                <Button Grid.Row="1" Grid.Column="4"
                            Style="{StaticResource BtnPrimary}"
                            Command="{Binding SalvaTelefonoCommand}"
                            Padding="10,0" Height="34">
                                                    <iconPacks:PackIconBootstrapIcons Kind="Plus" Width="13" Height="13" Foreground="White"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="EMAIL" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding Dettaglio.EmailCliente}" Margin="0,0,0,6">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource BrushSfondoChiaro}" BorderBrush="{StaticResource BrushBordo}"
                                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0" Style="{StaticResource BtnIcon}"
                                        Command="{Binding DataContext.ImpostaEmailPrincipaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Padding="4" ToolTip="Principale"
                                        VerticalAlignment="Center">
                                                                <iconPacks:PackIconBootstrapIcons Kind="StarFill" Width="12" Height="12"
                                        Foreground="{Binding Principale, Converter={StaticResource PrincipaleColore}}"/>
                                                            </Button>
                                                            <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                                            Cursor="Hand" Tag="{Binding}"
                                            MouseLeftButtonUp="ContattoEmail_Click">
                                                                <TextBlock Text="{Binding Etichetta}" FontSize="10" Foreground="{StaticResource BrushTestoSecondario}"
                                               Visibility="{Binding Etichetta, Converter={StaticResource BoolToVisibility}}"/>
                                                                <TextBlock Text="{Binding Valore}" FontSize="13" Foreground="{StaticResource BrushTestoPrimario}"
                                               TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Style="{StaticResource BtnIcon}"
                                        Padding="4" ToolTip="Modifica"
                                        Tag="{Binding}" Click="ModificaEmail_Click"
                                        VerticalAlignment="Center">
                                                                <iconPacks:PackIconBootstrapIcons Kind="Pencil" Width="12" Height="12" Foreground="{StaticResource BrushTestoSecondario}"/>
                                                            </Button>
                                                            <Button Grid.Column="3" Style="{StaticResource BtnIconRed}"
                                        Command="{Binding DataContext.RimuoviEmailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Padding="4" ToolTip="Rimuovi"
                                        VerticalAlignment="Center">
                                                                <iconPacks:PackIconBootstrapIcons Kind="Trash" Width="12" Height="12" Foreground="{StaticResource BrushDanger}"/>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border BorderBrush="{StaticResource BrushInfoBorder}" BorderThickness="1" CornerRadius="6"
                    Background="{StaticResource BrushInfoLight}" Padding="10,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="ETICHETTA" Style="{StaticResource FieldLabel}"/>
                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="INDIRIZZO" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Grid.Row="1" Grid.Column="0"
                             Text="{Binding Dettaglio.NuovaEmailEtichetta, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBox Grid.Row="1" Grid.Column="2"
                             Text="{Binding Dettaglio.NuovaEmailValore, UpdateSourceTrigger=PropertyChanged}"/>
                                                <Button Grid.Row="1" Grid.Column="4"
                            Style="{StaticResource BtnPrimary}"
                            Command="{Binding SalvaEmailCommand}"
                            Padding="10,0" Height="34">
                                                    <iconPacks:PackIconBootstrapIcons Kind="Plus" Width="13" Height="13" Foreground="White"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </views:ModalDialogControl.Contenuto>
        </views:ModalDialogControl>

        <!-- GESTIONE REFERENTI -->
        <Border Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource OverlayScuroStyle}"
            Visibility="{Binding PannelloReferentiAperto, Converter={StaticResource BoolToVisibility}}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding ChiudiGestioneReferentiCommand}"/>
            </Border.InputBindings>
        </Border>
        <Border Grid.Row="0" Grid.RowSpan="2" Width="360" HorizontalAlignment="Right"
            Style="{StaticResource PanelLateraleStyle}"
            Visibility="{Binding PannelloReferentiAperto, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Gestisci studi" Style="{StaticResource ModuleTitleStyle}"/>
                        <Button Grid.Column="1" Style="{StaticResource BtnIconGhost}" Command="{Binding ChiudiGestioneReferentiCommand}" VerticalAlignment="Top">
                            <iconPacks:PackIconBootstrapIcons Kind="XLg" Width="14" Height="14" Foreground="{StaticResource BrushTestoSecondario}"/>
                        </Button>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,16">

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NuovoReferenteTesto, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="  Nuovo studio…"/>
                            <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Margin="5,0,0,0" Height="30" Width="35" Padding="12,3" Command="{Binding AggiungiReferenteCommand}">
                                <iconPacks:PackIconBootstrapIcons Kind="Plus" Width="10" Height="10" Foreground="{StaticResource BrushPrimary}"/>
                            </Button>
                        </Grid>

                        <TextBlock Text="ATTIVI" Style="{StaticResource FieldLabel}"/>
                        <ItemsControl ItemsSource="{Binding ReferentiTutti}" Margin="0,4,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushSfondoChiaro}" CornerRadius="5" Padding="0,0" Margin="0,0,0,5" 
                                        Visibility="{Binding Attivo, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding Nome, UpdateSourceTrigger=LostFocus}"
                                                 BorderThickness="0" Background="Transparent" FontSize="12"
                                                 LostFocus="Referente_LostFocus" Tag="{Binding}"/>
                                            <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Padding="10"
                                                Command="{Binding DataContext.EliminaReferenteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="Elimina/disattiva">
                                                <iconPacks:PackIconBootstrapIcons Kind="Trash" Width="11" Height="11" Foreground="{StaticResource BrushTestoSecondario}" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="DISATTIVATI" Style="{StaticResource FieldLabel}"/>
                        <ItemsControl ItemsSource="{Binding ReferentiTutti}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushSfondoChiaro}" CornerRadius="5" Padding="8,6" Margin="0,0,0,5"
                                        Visibility="{Binding Attivo, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Nome}" FontSize="12" Foreground="{StaticResource BrushTestoSecondario}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Padding="4"
                                                Command="{Binding DataContext.RiattivaReferenteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="Riattiva">
                                                <iconPacks:PackIconBootstrapIcons Kind="ArrowCounterclockwise" Width="11" Height="11" Foreground="{StaticResource BrushPrimary}"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- GESTIONE PROGRAMMI -->
        <Border Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource OverlayScuroStyle}"
            Visibility="{Binding PannelloProgrammiAperto, Converter={StaticResource BoolToVisibility}}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding ChiudiGestioneProgrammiCommand}"/>
            </Border.InputBindings>
        </Border>
        <Border Grid.Row="0" Grid.RowSpan="2" Width="360" HorizontalAlignment="Right"
            Style="{StaticResource PanelLateraleStyle}"
            Visibility="{Binding PannelloProgrammiAperto, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Gestisci programmi" Style="{StaticResource ModuleTitleStyle}"/>
                        <Button Grid.Column="1" Style="{StaticResource BtnIconGhost}" Command="{Binding ChiudiGestioneProgrammiCommand}" VerticalAlignment="Top">
                            <iconPacks:PackIconBootstrapIcons Kind="XLg" Width="14" Height="14" Foreground="{StaticResource BrushTestoSecondario}"/>
                        </Button>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,16">
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NuovoProgrammaTesto, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="  Nuovo programma"/>
                            <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Margin="5,0,0,0" Height="30" Width="35" Padding="12,3" Command="{Binding AggiungiProgrammaCommand}">
                                <iconPacks:PackIconBootstrapIcons Kind="Plus" Width="10" Height="10" Foreground="{StaticResource BrushPrimary}"/>
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Programmi}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushSfondoChiaro}" CornerRadius="5" Padding="0,0" Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding Nome, UpdateSourceTrigger=LostFocus}"
                                                 BorderThickness="0" Background="Transparent" FontSize="12"
                                                 LostFocus="Programma_LostFocus" Tag="{Binding}"/>
                                            <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Padding="10"
                                                Command="{Binding DataContext.EliminaProgrammaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="Elimina">
                                                <iconPacks:PackIconBootstrapIcons Kind="Trash" Width="11" Height="11" Foreground="{StaticResource BrushTestoSecondario}"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
