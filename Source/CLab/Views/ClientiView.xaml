                                                   Foreground="{StaticResource BrushTestoSecondario}"
                                                   Visibility="{Binding Etichetta, Converter={StaticResource BoolToVisibility}}"/>
                                                                    </StackPanel>

                                                                    <iconPacks:PackIconBootstrapIcons
