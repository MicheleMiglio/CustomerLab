<UserControl x:Class="CLab.Views.ClientiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:local="clr-namespace:CLab.Models"
             xmlns:converters="clr-namespace:CLab.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:views="clr-namespace:CLab.Views">

    <!-- ============================================================ -->
    <!-- CLIENTI CLab 2.0: griglia moderna + modal unico che commuta   -->
    <!-- tra SCHEDA (read-only, tab Anagrafica/Situazione) e MODIFICA. -->
    <!-- Percorsi: doppio click → scheda; matita → modifica;           -->
    <!-- "Nuovo cliente" → inserimento. Comandi e logica del           -->
    <!-- ViewModel invariati, linguaggio visivo di Fatture/Studi.      -->
    <!-- ============================================================ -->

    <UserControl.Resources>
        <ResourceDictionary>

            <ObjectDataProvider x:Key="TipiContatto" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:TipoContatto"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <ObjectDataProvider x:Key="StatiCliente" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:StatoCliente"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <converters:PrincipaleColoreConverter x:Key="PrincipaleColore"/>
            <converters:StatoSemanticoTestoConverter x:Key="StatoBadge"/>
            <converters:StatoSemanticoForeConverter  x:Key="StatoBadgeFore"/>

            <!-- Chip filtro (segmented): stesso pattern di Fatture — ghost,
                 hover neutro, selezione wash + testo primario. -->
            <Style x:Key="ChipFiltro" TargetType="Button">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Padding" Value="12,4"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushHoverNeutro}"/>
                                </Trigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="Sel"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushSidebarSelectedBadge}"/>
                                </MultiDataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ChipStatoTutti" TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding FiltroStato}" Value="Tutti">
                        <Setter Property="Tag" Value="Sel"/>
                        <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ChipStatoAttivi" TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding FiltroStato}" Value="Attivi">
                        <Setter Property="Tag" Value="Sel"/>
                        <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ChipStatoStandBy" TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding FiltroStato}" Value="Stand by">
                        <Setter Property="Tag" Value="Sel"/>
                        <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ChipStatoCessati" TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding FiltroStato}" Value="Cessati">
                        <Setter Property="Tag" Value="Sel"/>
                        <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Azioni inline della griglia: icone ghost, feedback in hover -->
            <Style x:Key="AzioneGriglia" TargetType="Button">
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushHoverNeutro}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Elimina: neutro a riposo, rosso solo come feedback di hover -->
            <Style x:Key="AzioneGrigliaElimina" TargetType="Button" BasedOn="{StaticResource AzioneGriglia}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource BrushStatoCessato}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Situazione Cliente: card di sezione leggere -->
            <Style x:Key="CardSituazione" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BrushSfondoChiaro}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushBordo}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
                <Setter Property="Padding" Value="12,10"/>
            </Style>

            <Style x:Key="ClientiColumnHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridColumnHeader">
                            <Grid>
                                <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{StaticResource BrushBordoLeggero}"
                    BorderThickness="0,0,0,1">

                                    <Grid>
                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="Center"/>

                                        <TextBlock x:Name="freccia"
                               Text="▼"
                               FontSize="8"
                               Foreground="{StaticResource BrushPrimary}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,1,12,0"
                               Visibility="Collapsed"/>
                                    </Grid>
                                </Border>

                                <Thumb x:Name="PART_LeftHeaderGripper"
                   HorizontalAlignment="Left"
                   Width="4"
                   Cursor="SizeWE">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Rectangle Fill="Transparent"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>

                                <Thumb x:Name="PART_RightHeaderGripper"
                   HorizontalAlignment="Right"
                   Width="4"
                   Cursor="SizeWE">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Rectangle Fill="Transparent"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>

                            <ControlTemplate.Triggers>

                                <Trigger Property="SortDirection" Value="Ascending">
                                    <Setter TargetName="freccia"
                        Property="Text"
                        Value="▲"/>
                                    <Setter TargetName="freccia"
                        Property="Visibility"
                        Value="Visible"/>
                                    <Setter TargetName="bd"
                        Property="BorderBrush"
                        Value="{StaticResource BrushPrimary}"/>
                                    <Setter Property="Foreground"
                        Value="{StaticResource BrushTestoPrimario}"/>
                                </Trigger>

                                <Trigger Property="SortDirection" Value="Descending">
                                    <Setter TargetName="freccia"
                        Property="Text"
                        Value="▼"/>
                                    <Setter TargetName="freccia"
                        Property="Visibility"
                        Value="Visible"/>
                                    <Setter TargetName="bd"
                        Property="BorderBrush"
                        Value="{StaticResource BrushPrimary}"/>
                                    <Setter Property="Foreground"
                        Value="{StaticResource BrushTestoPrimario}"/>
                                </Trigger>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd"
                        Property="Background"
                        Value="{StaticResource BrushSfondoChiaro}"/>
                                </Trigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>        
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER: titolo + pulsante primario, allineamenti degli altri moduli -->
        <Border Grid.Row="0"
            Style="{StaticResource ModuleHeaderBorderStyle}" Padding="28,0"
            Height="64">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Clienti" Style="{StaticResource ModuleTitleStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BtnPrimary}" Height="32" MinWidth="120" Padding="12,0"
                        Margin="10,0,0,0" Command="{Binding NuovoCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBootstrapIcons Kind="Plus" Width="11" Height="11"
                            Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Nuovo cliente" VerticalAlignment="Center"/>
                    </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- AREA TABELLA -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- FILTRI: chips stato + azzera + contatore + ricerca -->
            <Grid Grid.Row="0" Margin="28,10,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Chips stato: [Tutti] [Attivi] [Stand by] [Cessati] -->
                <Border Grid.Column="0" Background="{StaticResource BrushSfondoFine}"
                        CornerRadius="{StaticResource RadiusSmall}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Tutti" Style="{StaticResource ChipStatoTutti}"
                                Command="{Binding ImpostaStatoFiltroCommand}" CommandParameter="Tutti"/>
                        <Button Content="Attivi" Style="{StaticResource ChipStatoAttivi}"
                                Command="{Binding ImpostaStatoFiltroCommand}" CommandParameter="Attivi"/>
                        <Button Content="Stand by" Style="{StaticResource ChipStatoStandBy}"
                                Command="{Binding ImpostaStatoFiltroCommand}" CommandParameter="Stand by"/>
                        <Button Content="Cessati" Style="{StaticResource ChipStatoCessati}"
                                Command="{Binding ImpostaStatoFiltroCommand}" CommandParameter="Cessati"/>
                    </StackPanel>
                </Border>

                <!-- Azzera filtri: visibile solo quando serve -->
                <Button Grid.Column="2" Style="{StaticResource ChipFiltro}" 
                        Command="{Binding AzzeraFiltriCommand}" ToolTip="Rimuove tutti i filtri"
                        Visibility="{Binding HaFiltriAttivi, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,0,20,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBootstrapIcons Kind="Eraser" Width="11" Height="11"
                            Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Azzera filtri" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="3" Text="{Binding ContatoreTesto}" FontSize="11"
                       Foreground="{StaticResource BrushTestoSecondario}" VerticalAlignment="Center"
                       Margin="0,0,16,0"/>

                <!-- Ricerca compatta con cancella rapido -->
                <Border Grid.Column="4" Width="250" Height="32" Background="White"
                    BorderBrush="{StaticResource BrushBordo}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconBootstrapIcons Grid.Column="0" Kind="Search" Width="13" Height="13"
                            Foreground="{StaticResource BrushTestoSecondario}" Margin="10,0,0,0"
                            VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
        Text="{Binding FiltroTesto, UpdateSourceTrigger=PropertyChanged}"
        BorderThickness="0" Background="Transparent" FontSize="12"
        Foreground="{StaticResource BrushTestoPrimario}"
        VerticalContentAlignment="Center"
        mah:TextBoxHelper.Watermark="  Cerca studio per nome…"/>
                        <Button Grid.Column="2" Width="22" Height="22" Margin="0,0,4,0"
                            Style="{StaticResource AzioneGriglia}" Click="CancellaRicerca_Click"
                            ToolTip="Cancella ricerca"
                            Visibility="{Binding FiltroTesto, Converter={StaticResource BoolToVisibility}}">
                            <iconPacks:PackIconBootstrapIcons Kind="XLg" Width="10" Height="10"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- TABELLA: righe ariose, hover neutro, doppio click = scheda cliente -->
            <DataGrid Grid.Row="1" x:Name="gridClienti" ItemsSource="{Binding ClientiFiltrati}"
                  Style="{StaticResource ModuleDataGridStyle}"
                  RowHeight="46" Margin="28,12,28,24"
                  VerticalAlignment="Top"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                  MouseDoubleClick="gridClienti_MouseDoubleClick">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader"
           BasedOn="{StaticResource ClientiColumnHeaderStyle}"/>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource ModuleDataGridCellStyle}"/>
                </DataGrid.CellStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource ModuleDataGridRowClickableSelectedStyle}"/>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="RAGIONE SOCIALE" Width="1.6*" SortMemberPath="RagioneSociale">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="14,0">
                                    <TextBlock Text="{Binding RagioneSociale}"
                                           FontSize="13" FontWeight="Medium" Foreground="{StaticResource BrushTestoPrimario}"
                                           TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding PartitaIva, StringFormat='P.IVA {0}'}"
                                           FontSize="11" Foreground="{StaticResource BrushTestoSecondario}" Margin="0,2,0,0"
                                           Visibility="{Binding PartitaIva, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="STUDIO" Binding="{Binding ReferenteNome}" Width="1.1*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="14,0"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="CONTATTI" Width="1.2*" SortMemberPath="TelefonoPrincipale">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="14,0">
                                    <TextBlock Text="{Binding TelefonoPrincipale}"
                                           FontSize="12" Foreground="{StaticResource BrushTestoSecondario}"
                                           Visibility="{Binding TelefonoPrincipale, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="{Binding EmailPrincipale}"
                                           FontSize="11" Foreground="{StaticResource BrushTestoSecondario}" Margin="0,2,0,0"
                                           Visibility="{Binding EmailPrincipale, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="CONTABILITÀ" Binding="{Binding TipoContabilita}" Width="0.9*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="14,0"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="STATO" Width="110" SortMemberPath="Stato">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <views:StatusBadgeControl Stato="{Binding Stato}"
                                      HorizontalAlignment="Left"
                                      Margin="14,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="76">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Matita: apre DIRETTAMENTE "Modifica cliente" -->
                                    <Button Style="{StaticResource AzioneGriglia}"
                                        Command="{Binding DataContext.ModificaDaGrigliaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" ToolTip="Modifica">
                                        <iconPacks:PackIconBootstrapIcons Kind="Pencil" Width="13" Height="13"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                                    <Button Style="{StaticResource AzioneGrigliaElimina}" Margin="4,0,0,0"
                                        Command="{Binding DataContext.EliminaClienteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" ToolTip="Elimina">
                                        <iconPacks:PackIconBootstrapIcons Kind="Trash" Width="13" Height="13"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty state: nessun cliente / nessun risultato -->
            <StackPanel Grid.Row="1" Margin="28,70,28,24" HorizontalAlignment="Center"
Visibility="{Binding NessunClienteVisibile, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding NessunClienteTesto}" FontSize="14"
    Foreground="{StaticResource BrushTestoSecondario}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- MODAL CLIENTE (ModalDialogControl condiviso): commuta in-place tra
             SCHEDA read-only (footer nascosto, header con tabs+Modifica) e
             MODIFICA/NUOVO (footer Annulla/Salva, azione "Visualizza scheda").
             Larghezza ampia (LarghezzaExtra) per la quantità di dati del modulo. -->
        <views:ModalDialogControl Grid.Row="0" Grid.RowSpan="2"
            IsAperto="{Binding OverlayAperto}"
            Titolo="{Binding TitoloPannello}"
            Sottotitolo="{Binding PannelloSottoTitolo}"
            ComandoChiudi="{Binding ChiudiOverlayCommand}"
            ComandoSalva="{Binding SalvaCommand}"
            MostraFooter="{Binding ModalitaModifica}"
            LarghezzaExtra="800"
            HaModificheNonSalvate="{Binding Dettaglio.HaModifiche}">

            <views:ModalDialogControl.HeaderExtra>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- SCHEDA READ-ONLY: tabs Anagrafica/Situazione + "Modifica" -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding ModalitaModifica, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                        <Button Content="Anagrafica" Command="{Binding MostraSchedaAnagraficaCommand}"
                                Margin="0,0,16,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabUnderlineButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MostraSituazioneCliente}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Situazione" Command="{Binding MostraSchedaSituazioneCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabUnderlineButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MostraSituazioneCliente}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Azione contestuale dell'header -->
                    <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Height="30" MinWidth="100" Padding="12,0"
                            Command="{Binding AttivaModificaCommand}" Visibility="{Binding ModalitaModifica, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBootstrapIcons Kind="Pencil" Width="11" Height="11"
                                Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Modifica" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- MODIFICA: passaggio rapido alla scheda ("Visualizza scheda →"),
                         disponibile solo per un cliente esistente -->
                    <Button Grid.Column="1" Style="{StaticResource LinkAzione}" VerticalAlignment="Center"
                            Command="{Binding VaiSchedaCommand}"
                            Visibility="{Binding SchedaDisponibileInModifica, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Visualizza scheda →"/>
                    </Button>
                </Grid>
            </views:ModalDialogControl.HeaderExtra>

            <views:ModalDialogControl.Contenuto>
                <Grid VerticalAlignment="Stretch" MinHeight="520">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled"
              Loaded="ScrollViewerModifica_Loaded">
                        <StackPanel>

                            <!-- ========== SCHEDA READ-ONLY (doppio click) ========== -->
                            <StackPanel Visibility="{Binding ModalitaModifica, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}" Margin="0,0,12,0">

                                <StackPanel Visibility="{Binding MostraSituazioneCliente, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="1.15*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- ========================================================= -->
                                        <!-- COLONNA 1: DATI ANAGRAFICI                                -->
                                        <!-- ========================================================= -->

                                        <StackPanel Grid.Column="0">

                                            <StackPanel Margin="0,0,0,16">
                                                <TextBlock Text="RAGIONE SOCIALE"
                           Style="{StaticResource FieldLabel}"/>
                                                <TextBlock Text="{Binding Dettaglio.FormRagioneSociale}"
                           Style="{StaticResource FieldValue}"/>
                                            </StackPanel>

                                            <StackPanel Margin="0,0,0,16">
                                                <TextBlock Text="P.IVA"
                           Style="{StaticResource FieldLabel}"/>
