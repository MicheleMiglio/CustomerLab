                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>

                                                            <Border
                                Background="{StaticResource BrushSfondoChiaro}"
                                BorderBrush="{StaticResource BrushBordo}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,9"
                                Margin="0,0,0,6">

                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="32"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <Border Grid.Column="0"
                                            Width="28"
                                            Height="28"
                                            CornerRadius="4"
                                            Background="{StaticResource BrushSuccessLight}"
                                            HorizontalAlignment="Left">

                                                                        <iconPacks:PackIconBootstrapIcons
                                            Kind="Envelope"
                                            Width="13"
                                            Height="13"
                                            Foreground="{StaticResource BrushSuccess}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                                                    </Border>

                                                                    <StackPanel Grid.Column="1"
                                                Margin="8,0"
                                                VerticalAlignment="Center">

                                                                        <TextBlock Text="{Binding Valore}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource BrushTestoPrimario}"
                                                   TextTrimming="CharacterEllipsis"/>

                                                                        <TextBlock Text="{Binding Etichetta}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource BrushTestoSecondario}"
                                                   Visibility="{Binding Etichetta, Converter={StaticResource BoolToVisibility}}"/>
                                                                    </StackPanel>

                                                                    <iconPacks:PackIconBootstrapIcons
                                        Grid.Column="2"
                                        Kind="StarFill"
                                        Width="11"
                                        Height="11"
                                        Foreground="{StaticResource BrushAccent}"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding Principale, Converter={StaticResource BoolToVisibility}}"/>

                                                                </Grid>
                                                            </Border>

                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Text="Nessuna email"
                           FontSize="12"
                           Foreground="{StaticResource BrushTestoSecondario}">
                                                    <TextBlock.Visibility>
                                                        <Binding Path="Dettaglio.EmailCliente.Count"
                                 Converter="{StaticResource BoolToVisibility}"
                                 ConverterParameter="Inverti"/>
                                                    </TextBlock.Visibility>
                                                </TextBlock>

                                            </StackPanel>

                                        </StackPanel>

                                    </Grid>

                                    <!-- ============================================================= -->
                                    <!-- NOTE: occupano le prime due colonne, NON quella contatti     -->
                                    <!-- ============================================================= -->

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="1.15*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Visibility="{Binding SituazioneHaNote, Converter={StaticResource BoolToVisibility}}">

                                            <TextBlock Text="NOTE"
                       Style="{StaticResource FieldLabel}"
                       Margin="0,0,0,4"/>

                                            <TextBlock Text="{Binding Dettaglio.FormNote}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource BrushTestoPrimario}"/>

                                        </StackPanel>

                                    </Grid>

                                </StackPanel>

                                <!-- TAB SITUAZIONE: riepilogo operativo read-only -->
                                <StackPanel Visibility="{Binding MostraSituazioneCliente, Converter={StaticResource BoolToVisibility}}">

                                    <!-- ============================================================ -->
                                    <!-- STUDIO                                                        -->
                                    <!-- ============================================================ -->

                                    <Border Style="{StaticResource CardSituazione}"
            Margin="0,0,0,16"
            Visibility="{Binding SituazioneHaStudio, Converter={StaticResource BoolToVisibility}}">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="30"
                    Height="30"
                    CornerRadius="5"
                    Background="{StaticResource BrushInfoLight}"
                    VerticalAlignment="Center">

                                                <iconPacks:PackIconBootstrapIcons
                    Kind="Buildings"
                    Width="14"
                    Height="14"
                    Foreground="{StaticResource BrushPrimary}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center">

                                                <TextBlock Text="STUDIO"
                           Style="{StaticResource FieldLabel}"/>

                                                <TextBlock Text="{Binding SituazioneStudioNome}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{StaticResource BrushTestoPrimario}"
                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="Nessuno studio associato a questo cliente."
               FontSize="12"
               Foreground="{StaticResource BrushTestoSecondario}"
               Margin="0,0,0,16"
               Visibility="{Binding SituazioneHaStudio, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}"/>


                                    <!-- ============================================================ -->
                                    <!-- ADEMPIMENTI + TODO                                            -->
                                    <!-- ============================================================ -->

                                    <Grid Margin="0,0,0,16">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>


                                        <!-- ======================================================== -->
                                        <!-- ADEMPIMENTI                                               -->
                                        <!-- ======================================================== -->

                                        <StackPanel Grid.Column="0">

                                            <TextBlock Style="{StaticResource SectionTitle}"
                       Margin="0,0,0,8">

                <Run Text="ADEMPIMENTI – ANNO "/>
                <Run Text="{Binding SituazioneAnno, Mode=OneWay}"/>

                                            </TextBlock>

                                            <Border Style="{StaticResource CardSituazione}">

                                                <StackPanel>

                                                    <!-- Nessuna attività -->
                                                    <TextBlock Text="Nessuna attività configurata per questo cliente."
                               FontSize="12"
                               Foreground="{StaticResource BrushTestoSecondario}"
                               TextWrapping="Wrap"
                               Visibility="{Binding SituazioneHaAdempimenti, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}"/>


                                                    <!-- Conteggi -->
                                                    <StackPanel Visibility="{Binding SituazioneHaAdempimenti, Converter={StaticResource BoolToVisibility}}">

                                                        <!-- In ritardo -->
                                                        <Grid Margin="0,0,0,8">

                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Orientation="Horizontal">

                                                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="{StaticResource BrushDanger}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0"/>

                                                                <TextBlock Text="In ritardo"
                                           FontSize="12"
                                           Foreground="{StaticResource BrushTestoSecondario}"
                                           VerticalAlignment="Center"/>
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="1"
                                       Text="{Binding SituazioneAdempimentiRitardo}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource BrushDanger}"
                                       VerticalAlignment="Center"/>
                                                        </Grid>


                                                        <!-- In corso -->
                                                        <Grid Margin="0,0,0,8">

                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Orientation="Horizontal">

                                                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="{StaticResource BrushPrimaryLight}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0"/>

                                                                <TextBlock Text="In corso"
                                           FontSize="12"
                                           Foreground="{StaticResource BrushTestoSecondario}"
                                           VerticalAlignment="Center"/>
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="1"
                                       Text="{Binding SituazioneAdempimentiInCorso}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource BrushTestoPrimario}"
                                       VerticalAlignment="Center"/>
                                                        </Grid>


                                                        <!-- Completati -->
                                                        <Grid>

                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Orientation="Horizontal">

                                                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="{StaticResource BrushSuccess}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0"/>

                                                                <TextBlock Text="Completati"
                                           FontSize="12"
                                           Foreground="{StaticResource BrushTestoSecondario}"
                                           VerticalAlignment="Center"/>
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="1"
                                       Text="{Binding SituazioneAdempimentiCompletati}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource BrushTestoPrimario}"
                                       VerticalAlignment="Center"/>
                                                        </Grid>

                                                    </StackPanel>

                                                </StackPanel>
                                            </Border>


                                            <!-- Apri Scadenzario -->
                                            <Button Style="{StaticResource LinkAzione}"
                    HorizontalAlignment="Left"
                    Margin="4,8,0,0"
                    Command="{Binding ApriScadenzarioClienteCommand}"
                    Visibility="{Binding SituazioneHaAdempimenti, Converter={StaticResource BoolToVisibility}}">

                                                <TextBlock Text="Apri Scadenzario →"/>

                                            </Button>

                                        </StackPanel>


                                        <!-- ======================================================== -->
                                        <!-- TODO                                                       -->
                                        <!-- ======================================================== -->

                                        <StackPanel Grid.Column="2">

                                            <TextBlock Text="TODO"
                       Style="{StaticResource SectionTitle}"
                       Margin="0,0,0,8"/>

                                            <Border Style="{StaticResource CardSituazione}">

                                                <TextBlock Text="{Binding SituazioneToDoTesto}"
                           FontSize="13"
                           TextWrapping="Wrap">

                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">

                                                            <Setter Property="Foreground"
                                    Value="{StaticResource BrushTestoSecondario}"/>

                                                            <Style.Triggers>

                                                                <DataTrigger Binding="{Binding SituazioneHaToDoScaduti}"
                                             Value="True">

                                                                    <Setter Property="Foreground"
                                            Value="{StaticResource BrushDanger}"/>

                                                                    <Setter Property="FontWeight"
                                            Value="Medium"/>

                                                                </DataTrigger>

                                                            </Style.Triggers>

                                                        </Style>
                                                    </TextBlock.Style>

                                                </TextBlock>

                                            </Border>


                                            <!-- Apri ToDo -->
                                            <Button Style="{StaticResource LinkAzione}"
                    HorizontalAlignment="Left"
                    Margin="4,8,0,0"
                    Command="{Binding ApriToDoClienteCommand}">

                                                <TextBlock Text="Apri ToDo →"/>

                                            </Button>

                                        </StackPanel>

                                    </Grid>


                                    <!-- ============================================================ -->
                                    <!-- RITENUTE                                                      -->
                                    <!-- ============================================================ -->

                                    <StackPanel Margin="0,0,0,18">

                                        <TextBlock Style="{StaticResource SectionTitle}"
                   Margin="0,0,0,8">

            <Run Text="RITENUTE – ANNO "/>
            <Run Text="{Binding SituazioneAnno, Mode=OneWay}"/>

                                        </TextBlock>


                                        <Border Style="{StaticResource CardSituazione}">

                                            <Grid>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>


                                                <!-- Da versare -->
                                                <StackPanel Grid.Column="0">

                                                    <TextBlock Text="DA VERSARE"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                               Style="{StaticResource FieldLabel}"/>

                                                    <TextBlock Text="{Binding SituazioneRitenuteDaVersare}"
                               FontSize="18"
                               FontWeight="Medium"
                               Foreground="{StaticResource BrushTestoPrimario}"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                               Margin="0,3,0,0"/>

                                                </StackPanel>


                                                <!-- Versate -->
                                                <StackPanel Grid.Column="2">

                                                    <TextBlock Text="VERSATE"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                               Style="{StaticResource FieldLabel}"/>

                                                    <TextBlock Text="{Binding SituazioneRitenuteVersate}"
                               FontSize="18"
                               FontWeight="Medium"
                               Foreground="{StaticResource BrushTestoPrimario}"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                               Margin="0,3,0,0"/>

                                                </StackPanel>


                                                <!-- No Ravvedimento -->
                                                <StackPanel Grid.Column="4">

                                                    <TextBlock Text="SENZA RAVVEDIMENTO"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                               Style="{StaticResource FieldLabel}"/>

                                                    <TextBlock Text="{Binding SituazioneRitenuteNoRavv}"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="Medium"
                               Foreground="{StaticResource BrushTestoPrimario}"
                               Margin="0,3,0,0"/>

                                                </StackPanel>


                                                <!-- Anomalie -->
                                                <StackPanel Grid.Column="6">

                                                    <TextBlock Text="ANOMALIE"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                               Style="{StaticResource FieldLabel}"/>

                                                    <TextBlock Text="{Binding SituazioneRitenuteAnomalie}"
                               FontSize="18"
                               FontWeight="Medium"
                               Foreground="{StaticResource BrushTestoPrimario}"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                               Margin="0,3,0,0"/>

                                                </StackPanel>


                                                <!-- Apri Ritenute -->
                                                <Button Grid.Column="7"
                        Style="{StaticResource LinkAzione}"
                        VerticalAlignment="Center"
                        Margin="24,0,0,0"
                        Command="{Binding ApriRitenuteClienteCommand}">

                                                    <TextBlock Text="Apri Ritenute →"/>

                                                </Button>

                                            </Grid>

                                        </Border>

                                    </StackPanel>


                                    <!-- ============================================================ -->
                                    <!-- ATTIVITÀ RECENTI                                              -->
                                    <!-- ============================================================ -->

                                    <StackPanel Margin="0,0,0,4"
                Visibility="{Binding SituazioneHaTimeline, Converter={StaticResource BoolToVisibility}}">

                                        <TextBlock Text="ATTIVITÀ RECENTI"
                   Style="{StaticResource SectionTitle}"
                   Margin="0,0,0,8"/>


                                        <Border Style="{StaticResource CardSituazione}">

                                            <ItemsControl ItemsSource="{Binding SituazioneTimeline}">

                                                <ItemsControl.ItemTemplate>

                                                    <DataTemplate>

                                                        <Grid Margin="0,0,0,8">

                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="90"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>


                                                            <!-- Data -->
                                                            <TextBlock Grid.Column="0"
                                       Text="{Binding DataTesto}"
                                       FontSize="11"
                                       Foreground="{StaticResource BrushTestoSecondario}"
                                       VerticalAlignment="Center"/>


                                                            <!-- Punto timeline -->
                                                            <Ellipse Grid.Column="1"
                                     Width="6"
                                     Height="6"
                                     Fill="{StaticResource BrushPrimaryLight}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,10,0"/>


                                                            <!-- Evento -->
                                                            <TextBlock Grid.Column="2"
                                       Text="{Binding Testo}"
                                       FontSize="12"
                                       Foreground="{StaticResource BrushTestoPrimario}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>

                                                        </Grid>

                                                    </DataTemplate>

                                                </ItemsControl.ItemTemplate>

                                            </ItemsControl>

                                        </Border>

                                    </StackPanel>

                                </StackPanel>
                            </StackPanel>

                            <!-- ========== MODIFICA / NUOVO CLIENTE ========== -->
                            <!-- ========== MODIFICA / NUOVO CLIENTE ========== -->
                            <StackPanel Visibility="{Binding ModalitaModifica, Converter={StaticResource BoolToVisibility}}">

                                <!-- ===================== ANAGRAFICA (compatta) ===================== -->
                                
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="500"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="RAGIONE SOCIALE *" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Dettaglio.FormRagioneSociale, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="STATO" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding Source={StaticResource StatiCliente}}"
                      SelectedItem="{Binding Dettaglio.FormStato}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Riga a 3 colonne: P.IVA | Codice Fiscale | Tipo Contabilità -->
                                <Grid Margin="0,12,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="PARTITA IVA" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Dettaglio.FormPartitaIva, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="CODICE FISCALE" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Dettaglio.FormCodiceFiscale, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="TIPO CONTABILITÀ" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox SelectedValue="{Binding Dettaglio.FormTipoContabilita}"
                      SelectedValuePath="Content" Margin="0,4,0,0">
                                            <ComboBoxItem Content="Ordinaria"/>
                                            <ComboBoxItem Content="Semplificata"/>
                                            <ComboBoxItem Content="Professionista"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Riga a 3 colonne: Referente | Programma | Intermediario -->
                                <Grid Margin="0,12,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="STUDIO *" Style="{StaticResource FieldLabel}"/>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0"
                          ItemsSource="{Binding ReferentiAttivi}"
                          DisplayMemberPath="Nome"
                          SelectedItem="{Binding Dettaglio.FormReferente}"/>
