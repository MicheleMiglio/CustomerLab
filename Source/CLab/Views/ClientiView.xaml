<UserControl x:Class="CLab.Views.ClientiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:local="clr-namespace:CLab.Models"
             xmlns:converters="clr-namespace:CLab.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">

    <UserControl.Resources>
        <ResourceDictionary>

            <ObjectDataProvider x:Key="TipiContatto" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:TipoContatto"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="StatiCliente" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:StatoCliente"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:PrincipaleColoreConverter x:Key="PrincipaleColore"/>
        <converters:StatoBadgeConverter       x:Key="StatoBadge"/>
        <converters:StatoBadgeForeConverter   x:Key="StatoBadgeFore"/>

        <!-- FASE 5 — Situazione Cliente: card di sezione e CTA leggere -->
        <Style x:Key="CardSituazione" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushSfondoChiaro}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBordo}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <Style x:Key="LinkAzione" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
            Style="{StaticResource ModuleHeaderBorderStyle}" Padding="28,0"
            Height="64">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Clienti" Style="{StaticResource ModuleTitleStyle}"/>
                <TextBlock Text="GESTIONE ANAGRAFICHE E CONTATTI" Style="{StaticResource ModuleSubtitleStyle}"/>
            </StackPanel>
        </Border>

        <!-- AREA TABELLA -->
        <Grid Grid.Row="1" Grid.Column="0" >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar ricerca -->
            <Grid Grid.Row="0" Margin="28,16,28,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White"
                    BorderBrush="{StaticResource BrushBordo}" BorderThickness="1"
                    CornerRadius="6" Height="34">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconBootstrapIcons Grid.Column="0"
                        Kind="Search" Width="13" Height="13" Foreground="{StaticResource BrushTestoSecondario}"
                        Margin="10,0,6,0"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                             Text="{Binding FiltroTesto, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Background="Transparent"
                             FontSize="13" Foreground="{StaticResource BrushTestoPrimario}"
                             VerticalContentAlignment="Center" Height="32"
                             mah:TextBoxHelper.Watermark="  Cerca cliente, P.IVA, referente…"/>
                    </Grid>
                </Border>
                <TextBlock Grid.Column="2"
                       Text="{Binding ContatoreTesto}"
                       FontSize="11" Foreground="{StaticResource BrushTestoSecondario}"
                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Grid.Column="3" Style="{StaticResource BtnOutlineGold}"
                    Command="{Binding NuovoCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBootstrapIcons Kind="Plus"
                        Width="11" Height="11"
                        Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Nuovo cliente" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- DataGrid -->
            <DataGrid Grid.Row="1" x:Name="gridClienti"
                  ItemsSource="{Binding ClientiFiltrati}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single"
                  BorderThickness="1" BorderBrush="{StaticResource BrushBordo}"
                  RowHeight="52" HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  Background="White" RowBackground="White"
                  AlternatingRowBackground="{StaticResource BrushSfondoAlternato}"
                  Margin="28,0,28,24"
                  MouseDoubleClick="gridClienti_MouseDoubleClick">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModuleDataGridColumnHeaderStyle}"/>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource ModuleDataGridCellStyle}"/>
                </DataGrid.CellStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource ModuleDataGridRowClickableSelectedStyle}"/>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="RAGIONE SOCIALE" Width="1.6*" SortMemberPath="RagioneSociale">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="14,0">
                                    <TextBlock Text="{Binding RagioneSociale}"
                                           FontSize="13" FontWeight="Medium" Foreground="{StaticResource BrushTestoPrimario}"/>
                                    <TextBlock Text="{Binding PartitaIva, StringFormat='P.IVA {0}'}"
                                           FontSize="11" Foreground="{StaticResource BrushTestoSecondario}" Margin="0,2,0,0"
                                           Visibility="{Binding PartitaIva, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="REFERENTE" Binding="{Binding ReferenteNome}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize"   Value="12"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding"    Value="14,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="CONTATTI" Width="*" SortMemberPath="TelefonoPrincipale">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="14,0">
                                    <TextBlock Text="{Binding TelefonoPrincipale}"
                                           FontSize="12" Foreground="{StaticResource BrushTestoSecondario}"
                                           Visibility="{Binding TelefonoPrincipale, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="{Binding EmailPrincipale}"
                                           FontSize="11" Foreground="{StaticResource BrushTestoSecondario}" Margin="0,2,0,0"
                                           Visibility="{Binding EmailPrincipale, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="CONTABILITÀ" Binding="{Binding TipoContabilita}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize"   Value="12"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding"    Value="14,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="STATO" Width="*" SortMemberPath="Stato">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                    <Ellipse Width="6" Height="6" Margin="0,0,6,0"
                                         Fill="{Binding Stato, Converter={StaticResource StatoBadgeFore}}"/>
                                    <TextBlock Text="{Binding Stato, Converter={StaticResource StatoBadge}}"
                                           FontSize="12" Foreground="{StaticResource BrushTestoSecondario}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Style="{StaticResource BtnIcon}"
                                        Command="{Binding DataContext.ApriDettaglioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" ToolTip="Dettaglio">
                                        <iconPacks:PackIconBootstrapIcons Kind="Eye"
                                        Width="14" Height="14" Foreground="{StaticResource BrushTestoSecondario}"/>
                                    </Button>
                                    <Button Style="{StaticResource BtnIconRed}" Margin="3,0,0,0"
                                        Command="{Binding DataContext.EliminaClienteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" ToolTip="Elimina">
                                        <iconPacks:PackIconBootstrapIcons Kind="Trash"
                                        Width="14" Height="14" Foreground="{StaticResource BrushTestoSecondario}"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- OVERLAY SCURO -->
        <Border Grid.Row="0" Grid.RowSpan="2"
    Grid.Column="0"
    x:Name="OverlayScuro"
    Visibility="Collapsed"
    Style="{StaticResource OverlayScuroStyle}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding ChiudiOverlayCommand}"/>
            </Border.InputBindings>
        </Border>

        <!-- PANNELLO LATERALE -->
        <Border Grid.Row="0" Grid.RowSpan="2"
    x:Name="PannelloLaterale"
    HorizontalAlignment="Right"
    VerticalAlignment="Stretch"
    Visibility="Collapsed"
    Width="400"
    Style="{StaticResource PanelLateraleStyle}"
    RenderTransformOrigin="1,0.5">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PannelloTranslate" X="400"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header pannello -->
                <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Dettaglio.FormRagioneSociale}"
                                       Style="{StaticResource ModuleTitleStyle}"/>
                                <TextBlock Text="{Binding PannelloSottoTitolo}"
                                       Style="{StaticResource ModuleSubtitleStyle}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource BtnIconGhost}"
                                Command="{Binding ChiudiOverlayCommand}"
                                ToolTip="Chiudi" VerticalAlignment="Top">
                                <iconPacks:PackIconBootstrapIcons Kind="XLg"
                                Width="14" Height="14" Foreground="{StaticResource BrushTestoSecondario}"/>
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,14,0,0"
                            Visibility="{Binding ModalitaModifica, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- FASE 5: schede del dettaglio cliente -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Anagrafica" Command="{Binding MostraSchedaAnagraficaCommand}"
                                    Margin="0,0,16,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TabUnderlineButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MostraSituazioneCliente}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Situazione" Command="{Binding MostraSchedaSituazioneCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TabUnderlineButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MostraSituazioneCliente}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <Button Grid.Column="1" Style="{StaticResource BtnOutlineGold}"
                                Command="{Binding AttivaModificaCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconBootstrapIcons Kind="Pencil"
                                    Width="11" Height="11" Foreground="{StaticResource BrushAccent}"
                                    Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Modifica" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Corpo scrollabile -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,20,22,4">
                    <StackPanel>

                        <!-- FASE 5: le schede Anagrafica (lettura + modifica) sono nascoste sulla scheda Situazione -->
                        <StackPanel Visibility="{Binding MostraSituazioneCliente, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">

                        <!-- VISTA SOLA LETTURA -->
                        <StackPanel Visibility="{Binding ModalitaModifica, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                                    <TextBlock Text="P.IVA / C.F." Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding Dettaglio.FormPartitaIva}" Style="{StaticResource FieldValue}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,16">
                                    <TextBlock Text="CONTABILITÀ" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding Dettaglio.FormTipoContabilita}" Style="{StaticResource FieldValue}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                                    <TextBlock Text="REFERENTE" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding Dettaglio.FormReferente}" Style="{StaticResource FieldValue}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16">
                                    <TextBlock Text="INTERMEDIARIO" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding Dettaglio.FormIntermediario}" Style="{StaticResource FieldValue}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,16">
                                    <TextBlock Text="PROGRAMMA" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding Dettaglio.FormProgramma}" Style="{StaticResource FieldValue}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,16">
                                    <TextBlock Text="STATO" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Margin="0,0,6,0"
                                             Fill="{Binding Dettaglio.FormStato, Converter={StaticResource StatoBadgeFore}}"/>
                                        <TextBlock Text="{Binding Dettaglio.FormStato, Converter={StaticResource StatoBadge}}"
                                               FontSize="13" Foreground="{StaticResource BrushTestoSecondario}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Border BorderBrush="{StaticResource BrushBordo}" BorderThickness="0,1,0,0" Margin="0,4,0,16"/>

                            <!-- Telefoni read-only -->
                            <TextBlock Text="TELEFONI" Style="{StaticResource SectionTitle}"/>
                            <ItemsControl ItemsSource="{Binding Dettaglio.TelefoniCliente}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushSfondoChiaro}" BorderBrush="{StaticResource BrushBordo}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,9" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="28" Height="28"
                                                    CornerRadius="4" Background="{StaticResource BrushInfoLight}" HorizontalAlignment="Left">
                                                    <iconPacks:PackIconBootstrapIcons Kind="Telephone"
                                                    Width="13" Height="13" Foreground="{StaticResource BrushPrimary}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Valore}"
                                                           FontSize="13" FontWeight="Medium" Foreground="{StaticResource BrushTestoPrimario}"/>
                                                    <TextBlock Text="{Binding Etichetta}"
                                                           FontSize="10" Foreground="{StaticResource BrushTestoSecondario}"
                                                           Visibility="{Binding Etichetta, Converter={StaticResource BoolToVisibility}}"/>
                                                </StackPanel>
                                                <iconPacks:PackIconBootstrapIcons Grid.Column="2"
                                                Kind="StarFill" Width="11" Height="11" Foreground="{StaticResource BrushAccent}"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding Principale, Converter={StaticResource BoolToVisibility}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Nessun telefono" FontSize="12" Foreground="{StaticResource BrushTestoSecondario}" Margin="0,0,0,4">
                                <TextBlock.Visibility>
                                    <Binding Path="Dettaglio.TelefoniCliente.Count"
                                         Converter="{StaticResource BoolToVisibility}"
                                         ConverterParameter="Inverti"/>
                                </TextBlock.Visibility>
                            </TextBlock>

                            <Border BorderBrush="{StaticResource BrushBordo}" BorderThickness="0,1,0,0" Margin="0,12,0,16"/>

                            <!-- Email read-only -->
                            <TextBlock Text="EMAIL" Style="{StaticResource SectionTitle}"/>
                            <ItemsControl ItemsSource="{Binding Dettaglio.EmailCliente}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushSfondoChiaro}" BorderBrush="{StaticResource BrushBordo}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,9" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="28" Height="28"
                                                    CornerRadius="4" Background="{StaticResource BrushSuccessLight}" HorizontalAlignment="Left">
                                                    <iconPacks:PackIconBootstrapIcons Kind="Envelope"
                                                    Width="13" Height="13" Foreground="{StaticResource BrushSuccess}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Valore}"
                                                           FontSize="13" FontWeight="Medium" Foreground="{StaticResource BrushTestoPrimario}"/>
                                                    <TextBlock Text="{Binding Etichetta}"
                                                           FontSize="10" Foreground="{StaticResource BrushTestoSecondario}"
                                                           Visibility="{Binding Etichetta, Converter={StaticResource BoolToVisibility}}"/>
                                                </StackPanel>
                                                <iconPacks:PackIconBootstrapIcons Grid.Column="2"
                                                Kind="StarFill" Width="11" Height="11" Foreground="{StaticResource BrushAccent}"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding Principale, Converter={StaticResource BoolToVisibility}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Nessuna email" FontSize="12" Foreground="{StaticResource BrushTestoSecondario}" Margin="0,0,0,4">
                                <TextBlock.Visibility>
                                    <Binding Path="Dettaglio.EmailCliente.Count"
                                         Converter="{StaticResource BoolToVisibility}"
                                         ConverterParameter="Inverti"/>
                                </TextBlock.Visibility>
                            </TextBlock>
                        </StackPanel>

                        <!-- VISTA MODIFICA -->
                        <StackPanel Visibility="{Binding ModalitaModifica, Converter={StaticResource BoolToVisibility}}">

                            <TextBlock Text="RAGIONE SOCIALE *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Dettaglio.FormRagioneSociale, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="P.IVA / C.F." Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Dettaglio.FormPartitaIva, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="TIPO CONTABILITÀ" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox SelectedValue="{Binding Dettaglio.FormTipoContabilita}"
                                          SelectedValuePath="Content"
                                          Margin="0,0,0,0">
                                        <ComboBoxItem Content="Ordinaria"/>
                                        <ComboBoxItem Content="Semplificata"/>
                                        <ComboBoxItem Content="Professionista"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="REFERENTE *" Style="{StaticResource FieldLabel}"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
          ItemsSource="{Binding ReferentiAttivi}"
          DisplayMemberPath="Nome"
          SelectedItem="{Binding Dettaglio.FormReferente}"/>
                                        <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Padding="6" Margin="4,0,0,0"
        Command="{Binding ApriGestioneReferentiCommand}" ToolTip="Gestisci referenti">
                                            <iconPacks:PackIconBootstrapIcons Kind="Gear" Width="12" Height="12" Foreground="{StaticResource BrushTestoSecondario}"/>
                                        </Button>
                                    </Grid>

                                    <TextBlock Text="PROGRAMMA" Style="{StaticResource FieldLabel}"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
          ItemsSource="{Binding Programmi}"
          DisplayMemberPath="Nome"
          SelectedItem="{Binding Dettaglio.FormProgramma}"/>
                                        <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Padding="6" Margin="4,0,0,0"
        Command="{Binding ApriGestioneProgrammiCommand}" ToolTip="Gestisci programmi">
                                            <iconPacks:PackIconBootstrapIcons Kind="Gear" Width="12" Height="12" Foreground="{StaticResource BrushTestoSecondario}"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="INTERMEDIARIO" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Dettaglio.FormIntermediario, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="STATO" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Source={StaticResource StatiCliente}}"
                                  SelectedItem="{Binding Dettaglio.FormStato}" Margin="0,0,0,16"/>

                            <Border BorderBrush="{StaticResource BrushBordo}" BorderThickness="0,1,0,0" Margin="0,0,0,16"/>

                            <!-- Telefoni modifica -->
                            <TextBlock Text="TELEFONI" Style="{StaticResource SectionTitle}"/>
                            <ItemsControl ItemsSource="{Binding Dettaglio.TelefoniCliente}" Margin="0,0,0,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushSfondoChiaro}" BorderBrush="{StaticResource BrushBordo}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,8" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Style="{StaticResource BtnIcon}"
                                                    Command="{Binding DataContext.ImpostaTelefonoPrincipaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Padding="4" ToolTip="Principale"
                                                    VerticalAlignment="Center">
                                                    <iconPacks:PackIconBootstrapIcons Kind="StarFill" Width="12" Height="12"
                                                    Foreground="{Binding Principale, Converter={StaticResource PrincipaleColore}}"/>
                                                </Button>
                                                <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                                                        Cursor="Hand" Tag="{Binding}"
                                                        MouseLeftButtonUp="ContattoTelefono_Click">
                                                    <TextBlock Text="{Binding Etichetta}" FontSize="10" Foreground="{StaticResource BrushTestoSecondario}"
                                                           Visibility="{Binding Etichetta, Converter={StaticResource BoolToVisibility}}"/>
                                                    <TextBlock Text="{Binding Valore}" FontSize="13" Foreground="{StaticResource BrushTestoPrimario}"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource BtnIcon}"
                                                    Padding="4" ToolTip="Modifica"
                                                    Tag="{Binding}" Click="ModificaTelefono_Click"
                                                    VerticalAlignment="Center">
                                                    <iconPacks:PackIconBootstrapIcons Kind="Pencil" Width="12" Height="12" Foreground="{StaticResource BrushTestoSecondario}"/>
                                                </Button>
                                                <Button Grid.Column="3" Style="{StaticResource BtnIconRed}"
                                                    Command="{Binding DataContext.RimuoviTelefonoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Padding="4" ToolTip="Rimuovi"
                                                    VerticalAlignment="Center">
                                                    <iconPacks:PackIconBootstrapIcons Kind="Trash" Width="12" Height="12" Foreground="{StaticResource BrushDanger}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border BorderBrush="{StaticResource BrushInfoBorder}" BorderThickness="1" CornerRadius="6"
                                Background="{StaticResource BrushInfoLight}" Padding="10,10" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ETICHETTA" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="NUMERO"    Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Row="1" Grid.Column="0"
                                         Text="{Binding Dettaglio.NuovoTelefonoEtichetta, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Row="1" Grid.Column="2"
                                         Text="{Binding Dettaglio.NuovoTelefonoValore, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Row="1" Grid.Column="4"
                                        Style="{StaticResource BtnPrimary}"
                                        Command="{Binding SalvaTelefonoCommand}"
                                        Padding="10,0" Height="34">
                                        <iconPacks:PackIconBootstrapIcons Kind="Plus" Width="13" Height="13" Foreground="White"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border BorderBrush="{StaticResource BrushBordo}" BorderThickness="0,1,0,0" Margin="0,0,0,16"/>

                            <!-- Email modifica -->
                            <TextBlock Text="EMAIL" Style="{StaticResource SectionTitle}"/>
                            <ItemsControl ItemsSource="{Binding Dettaglio.EmailCliente}" Margin="0,0,0,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushSfondoChiaro}" BorderBrush="{StaticResource BrushBordo}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,8" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Style="{StaticResource BtnIcon}"
                                                    Command="{Binding DataContext.ImpostaEmailPrincipaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Padding="4" ToolTip="Principale"
                                                    VerticalAlignment="Center">
                                                    <iconPacks:PackIconBootstrapIcons Kind="StarFill" Width="12" Height="12"
                                                    Foreground="{Binding Principale, Converter={StaticResource PrincipaleColore}}"/>
                                                </Button>
                                                <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                                                        Cursor="Hand" Tag="{Binding}"
                                                        MouseLeftButtonUp="ContattoEmail_Click">
                                                    <TextBlock Text="{Binding Etichetta}" FontSize="10" Foreground="{StaticResource BrushTestoSecondario}"
                                                           Visibility="{Binding Etichetta, Converter={StaticResource BoolToVisibility}}"/>
                                                    <TextBlock Text="{Binding Valore}" FontSize="13" Foreground="{StaticResource BrushTestoPrimario}"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource BtnIcon}"
                                                    Padding="4" ToolTip="Modifica"
                                                    Tag="{Binding}" Click="ModificaEmail_Click"
                                                    VerticalAlignment="Center">
                                                    <iconPacks:PackIconBootstrapIcons Kind="Pencil" Width="12" Height="12" Foreground="{StaticResource BrushTestoSecondario}"/>
                                                </Button>
                                                <Button Grid.Column="3" Style="{StaticResource BtnIconRed}"
                                                    Command="{Binding DataContext.RimuoviEmailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Padding="4" ToolTip="Rimuovi"
                                                    VerticalAlignment="Center">
                                                    <iconPacks:PackIconBootstrapIcons Kind="Trash" Width="12" Height="12" Foreground="{StaticResource BrushDanger}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border BorderBrush="{StaticResource BrushInfoBorder}" BorderThickness="1" CornerRadius="6"
                                Background="{StaticResource BrushInfoLight}" Padding="10,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ETICHETTA"  Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="INDIRIZZO"  Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Row="1" Grid.Column="0"
                                         Text="{Binding Dettaglio.NuovaEmailEtichetta, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Row="1" Grid.Column="2"
                                         Text="{Binding Dettaglio.NuovaEmailValore, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Row="1" Grid.Column="4"
                                        Style="{StaticResource BtnPrimary}"
                                        Command="{Binding SalvaEmailCommand}"
                                        Padding="10,0" Height="34">
                                        <iconPacks:PackIconBootstrapIcons Kind="Plus" Width="13" Height="13" Foreground="White"/>
                                    </Button>
                                </Grid>
                            </Border>

                        </StackPanel>
                        </StackPanel>

                        <!-- FASE 5: SITUAZIONE CLIENTE — riepilogo operativo read-only -->
                        <StackPanel Visibility="{Binding MostraSituazioneCliente, Converter={StaticResource BoolToVisibility}}">

                            <!-- Stato del cliente -->
                            <Border Background="{StaticResource BrushSfondoChiaro}" BorderBrush="{StaticResource BrushBordo}"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}" Padding="12,10" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0"
                                         Fill="{Binding Dettaglio.FormStato, Converter={StaticResource StatoBadgeFore}}"/>
                                    <TextBlock Text="{Binding Dettaglio.FormStato, Converter={StaticResource StatoBadge}}" FontSize="13" FontWeight="Medium"
                                           Foreground="{StaticResource BrushTestoPrimario}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Adempimenti: stessa semantica dello Scadenzario -->
                            <TextBlock Style="{StaticResource SectionTitle}">
                                <Run Text="ADEMPIMENTI · ANNO "/><Run Text="{Binding SituazioneAnno, Mode=OneWay}"/>
                            </TextBlock>
                            <Border Style="{StaticResource CardSituazione}" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Nessuna attività configurata per questo cliente." FontSize="12"
                                        Foreground="{StaticResource BrushTestoSecondario}"
                                        Visibility="{Binding SituazioneHaAdempimenti, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}"/>

                                    <StackPanel Visibility="{Binding SituazioneHaAdempimenti, Converter={StaticResource BoolToVisibility}}">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource BrushDanger}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="In ritardo" FontSize="12" Foreground="{StaticResource BrushTestoSecondario}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SituazioneAdempimentiRitardo}" FontSize="13" FontWeight="Medium"
                                                Foreground="{StaticResource BrushDanger}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource BrushPrimaryLight}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="In corso" FontSize="12" Foreground="{StaticResource BrushTestoSecondario}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SituazioneAdempimentiInCorso}" FontSize="13" FontWeight="Medium"
                                                Foreground="{StaticResource BrushTestoPrimario}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource BrushSuccess}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Completati" FontSize="12" Foreground="{StaticResource BrushTestoSecondario}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SituazioneAdempimentiCompletati}" FontSize="13" FontWeight="Medium"
                                                Foreground="{StaticResource BrushTestoPrimario}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Button Style="{StaticResource LinkAzione}" HorizontalAlignment="Left" Margin="4,0,0,10"
                                Command="{Binding ApriScadenzarioClienteCommand}"
                                Visibility="{Binding SituazioneHaAdempimenti, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Apri Scadenzario →"/>
                            </Button>
                            <Button Style="{StaticResource LinkAzione}" HorizontalAlignment="Left" Margin="4,0,0,14"
                                Command="{Binding ApriRitardiClienteCommand}"
                                Visibility="{Binding SituazioneHaRitardi, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Vedi solo i ritardi →" Foreground="{StaticResource BrushDanger}" FontWeight="Medium"/>
                            </Button>

                            <Border BorderBrush="{StaticResource BrushBordo}" BorderThickness="0,1,0,0" Margin="0,0,0,16"/>

                            <!-- ToDo collegati al cliente -->
                            <TextBlock Text="TODO" Style="{StaticResource SectionTitle}"/>
                            <Border Style="{StaticResource CardSituazione}" Margin="0,0,0,8">
                                <TextBlock Text="{Binding SituazioneToDoTesto}" FontSize="12"
                                    TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SituazioneHaToDoScaduti}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                                                    <Setter Property="FontWeight" Value="Medium"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <Button Style="{StaticResource LinkAzione}" HorizontalAlignment="Left" Margin="4,0,0,14"
                                Command="{Binding ApriToDoClienteCommand}">
                                <TextBlock Text="Apri ToDo →"/>
                            </Button>

                            <Border BorderBrush="{StaticResource BrushBordo}" BorderThickness="0,1,0,0" Margin="0,0,0,16"/>

                            <!-- Ritenute d'acconto dell'anno corrente -->
                            <TextBlock Style="{StaticResource SectionTitle}">
                                <Run Text="RITENUTE · ANNO "/><Run Text="{Binding SituazioneAnno, Mode=OneWay}"/>
                            </TextBlock>
                            <Border Style="{StaticResource CardSituazione}" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding SituazioneRitenuteTesto}" FontSize="12" TextWrapping="Wrap"
                                        Foreground="{StaticResource BrushTestoSecondario}"/>
                                    <TextBlock FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                        Visibility="{Binding SituazioneHaRitenute, Converter={StaticResource BoolToVisibility}}">
                                        <Run Text="{Binding SituazioneRitenuteVersate, Mode=OneWay}"/><Run Text=" versate · "/><Run Text="{Binding SituazioneRitenuteAnomalie, Mode=OneWay}"/><Run Text=" anomalie"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource LinkAzione}" HorizontalAlignment="Left" Margin="4,0,0,4"
                                Command="{Binding ApriRitenuteClienteCommand}">
                                <TextBlock Text="Apri Ritenute →"/>
                            </Button>

                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Salva / Annulla -->
                <Border Grid.Row="2" BorderBrush="{StaticResource BrushBordo}" BorderThickness="0,1,0,0"
                    Padding="22,14"
                    Visibility="{Binding ModalitaModifica, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Salva"
                            Command="{Binding SalvaCommand}"
                            Style="{StaticResource BtnPrimary}"
                            HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="2" Content="Annulla"
                            Command="{Binding ChiudiOverlayCommand}"
                            Style="{StaticResource BtnOutline}"/>
                    </Grid>
                </Border>

            </Grid>
        </Border>
        <!-- GESTIONE REFERENTI -->
        <Border Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource OverlayScuroStyle}"
            Visibility="{Binding PannelloReferentiAperto, Converter={StaticResource BoolToVisibility}}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding ChiudiGestioneReferentiCommand}"/>
            </Border.InputBindings>
        </Border>
        <Border Grid.Row="0" Grid.RowSpan="2" Width="360" HorizontalAlignment="Right"
            Style="{StaticResource PanelLateraleStyle}"
            Visibility="{Binding PannelloReferentiAperto, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Gestisci referenti" Style="{StaticResource ModuleTitleStyle}"/>
                        <Button Grid.Column="1" Style="{StaticResource BtnIconGhost}" Command="{Binding ChiudiGestioneReferentiCommand}" VerticalAlignment="Top">
                            <iconPacks:PackIconBootstrapIcons Kind="XLg" Width="14" Height="14" Foreground="{StaticResource BrushTestoSecondario}"/>
                        </Button>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,16">

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NuovoReferenteTesto, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="  Nuovo referente…"/>
                            <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Margin="6,0,0,0" Command="{Binding AggiungiReferenteCommand}">
                                <iconPacks:PackIconBootstrapIcons Kind="Plus" Width="12" Height="12" Foreground="White"/>
                            </Button>
                        </Grid>

                        <TextBlock Text="ATTIVI" Style="{StaticResource FieldLabel}"/>
                        <ItemsControl ItemsSource="{Binding ReferentiTutti}" Margin="0,4,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushSfondoChiaro}" CornerRadius="5" Padding="8,6" Margin="0,0,0,5"
                                        Visibility="{Binding Attivo, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding Nome, UpdateSourceTrigger=LostFocus}"
                                                 BorderThickness="0" Background="Transparent" FontSize="12"
                                                 LostFocus="Referente_LostFocus" Tag="{Binding}"/>
                                            <Button Grid.Column="1" Style="{StaticResource BtnIconRed}" Padding="4"
                                                Command="{Binding DataContext.EliminaReferenteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="Elimina/disattiva">
                                                <iconPacks:PackIconBootstrapIcons Kind="Trash" Width="11" Height="11" Foreground="{StaticResource BrushTestoSecondario}"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="DISATTIVATI" Style="{StaticResource FieldLabel}"/>
                        <ItemsControl ItemsSource="{Binding ReferentiTutti}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushSfondoChiaro}" CornerRadius="5" Padding="8,6" Margin="0,0,0,5"
                                        Visibility="{Binding Attivo, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Nome}" FontSize="12" Foreground="{StaticResource BrushTestoSecondario}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Padding="4"
                                                Command="{Binding DataContext.RiattivaReferenteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="Riattiva">
                                                <iconPacks:PackIconBootstrapIcons Kind="ArrowCounterclockwise" Width="11" Height="11" Foreground="{StaticResource BrushAccent}"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- GESTIONE PROGRAMMI -->
        <Border Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource OverlayScuroStyle}"
            Visibility="{Binding PannelloProgrammiAperto, Converter={StaticResource BoolToVisibility}}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding ChiudiGestioneProgrammiCommand}"/>
            </Border.InputBindings>
        </Border>
        <Border Grid.Row="0" Grid.RowSpan="2" Width="360" HorizontalAlignment="Right"
            Style="{StaticResource PanelLateraleStyle}"
            Visibility="{Binding PannelloProgrammiAperto, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Gestisci programmi" Style="{StaticResource ModuleTitleStyle}"/>
                        <Button Grid.Column="1" Style="{StaticResource BtnIconGhost}" Command="{Binding ChiudiGestioneProgrammiCommand}" VerticalAlignment="Top">
                            <iconPacks:PackIconBootstrapIcons Kind="XLg" Width="14" Height="14" Foreground="{StaticResource BrushTestoSecondario}"/>
                        </Button>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,16">
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NuovoProgrammaTesto, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="  Nuovo programma…"/>
                            <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Margin="6,0,0,0" Command="{Binding AggiungiProgrammaCommand}">
                                <iconPacks:PackIconBootstrapIcons Kind="Plus" Width="12" Height="12" Foreground="White"/>
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Programmi}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushSfondoChiaro}" CornerRadius="5" Padding="8,6" Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding Nome, UpdateSourceTrigger=LostFocus}"
                                                 BorderThickness="0" Background="Transparent" FontSize="12"
                                                 LostFocus="Programma_LostFocus" Tag="{Binding}"/>
                                            <Button Grid.Column="1" Style="{StaticResource BtnIconRed}" Padding="4"
                                                Command="{Binding DataContext.EliminaProgrammaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="Elimina">
                                                <iconPacks:PackIconBootstrapIcons Kind="Trash" Width="11" Height="11" Foreground="{StaticResource BrushTestoSecondario}"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
