<UserControl x:Class="CLab.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:CLab.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:PrioritaToDoAColoreConverter x:Key="PrioritaToDoColore"/>
        <converters:PrioritaToDoASfondoConverter x:Key="PrioritaToDoSfondo"/>
        <converters:PrioritaPromemoriaAColoreConverter x:Key="PrioritaPromemoriaColore"/>

        <Style x:Key="LinkModulo" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ModuleHeaderBorderStyle}" Padding="28,0" Height="64">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Home" Style="{StaticResource ModuleTitleStyle}"/>
                <TextBlock Text="SITUAZIONE GENERALE" Style="{StaticResource ModuleSubtitleStyle}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,28">

                <StackPanel Margin="0,0,0,22">
                    <TextBlock FontSize="20" FontWeight="Medium" Foreground="{StaticResource BrushTestoPrimario}">
                        <Run Text="{Binding Saluto, Mode=OneTime}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding DataOggiTesto, Mode=OneTime}" FontSize="12"
                               Foreground="{StaticResource BrushTestoSecondario}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding SintesiGiornata}" FontSize="13"
                               Foreground="{StaticResource BrushTestoSecondario}" Margin="0,8,0,0"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BrushBordo}" BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <Grid Margin="18,16,18,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="TODO APERTI" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTestoSecondario}"/>
                                    <TextBlock Text="{Binding ToDoSezioneSottoTitolo}" FontSize="11" Foreground="{StaticResource BrushTestoSecondario}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Apri ToDo" Style="{StaticResource LinkModulo}"
                                        Command="{Binding ApriToDoCommand}" VerticalAlignment="Top"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ProssimiToDo}" Margin="6,0,6,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BrushBordo}" BorderThickness="0,0,0,1" Padding="12,10" Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                    Command="{Binding DataContext.ApriToDoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Titolo}" FontSize="13" FontWeight="Medium"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                               Foreground="{StaticResource BrushTestoPrimario}"/>
                                                    <TextBlock Text="{Binding Cliente}" FontSize="11" Foreground="{StaticResource BrushTestoSecondario}"
                                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ScadenzaTesto}" FontSize="11" HorizontalAlignment="Right">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsScaduto}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                                                                        <Setter Property="FontWeight" Value="Medium"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Border CornerRadius="10" Padding="8,2" Margin="0,6,0,0" HorizontalAlignment="Right"
                                                            Background="{Binding Priorita, Converter={StaticResource PrioritaToDoSfondo}}">
                                                        <TextBlock Text="{Binding Priorita}" FontSize="10" FontWeight="Medium"
                                                                   Foreground="{Binding Priorita, Converter={StaticResource PrioritaToDoColore}}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Nessun ToDo aperto." FontSize="12" Foreground="{StaticResource BrushTestoSecondario}"
                                       Margin="18,8,18,16"
                                       Visibility="{Binding ProssimiToDo.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BrushBordo}" BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <Grid Margin="18,16,18,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="PROMEMORIA" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTestoSecondario}"/>
                                    <TextBlock Text="{Binding PromemoriaSezioneSottoTitolo}" FontSize="11" Foreground="{StaticResource BrushTestoSecondario}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Apri promemoria" Style="{StaticResource LinkModulo}"
                                        Command="{Binding ApriPromemoriaCommand}" VerticalAlignment="Top"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding PromemoriaInEvidenza}" Margin="6,0,6,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BrushBordo}" BorderThickness="0,0,0,1" Padding="12,10" Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                    Command="{Binding DataContext.ApriPromemoriaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="3" CornerRadius="1" Margin="0,2,10,2"
                                                        Background="{Binding Priorita, Converter={StaticResource PrioritaPromemoriaColore}}"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Titolo}" FontSize="13" FontWeight="Medium"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                               Foreground="{StaticResource BrushTestoPrimario}"/>
                                                    <TextBlock Text="{Binding Descrizione}" FontSize="11"
                                                               Foreground="{StaticResource BrushTestoSecondario}" Margin="0,3,0,0"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                               Visibility="{Binding HaDescrizione, Converter={StaticResource BoolToVisibility}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Nessun promemoria." FontSize="12" Foreground="{StaticResource BrushTestoSecondario}"
                                       Margin="18,8,18,16"
                                       Visibility="{Binding PromemoriaInEvidenza.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
