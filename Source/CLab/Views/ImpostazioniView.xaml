<UserControl x:Class="CLab.Views.ImpostazioniView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <UserControl.Resources>
        <!-- Bottone rosso pieno, usato solo qui: azione distruttiva unica nell'app -->
        <Style x:Key="BtnDanger" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushDanger}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource ModuleHeaderBorderStyle}" Padding="28,0" Height="64">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Impostazioni" Style="{StaticResource ModuleTitleStyle}"/>
                <TextBlock Text="APP E DATI" Style="{StaticResource ModuleSubtitleStyle}"/>
            </StackPanel>
        </Border>

        <!-- CONTENUTO -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,28" MaxWidth="620" HorizontalAlignment="Left">

                <!-- Applicazione -->
                <TextBlock Text="VERSIONE APPLICAZIONE" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding Versione}" Style="{StaticResource FieldValue}" TextWrapping="Wrap" Margin="0,0,0,30"/>
                
                <!-- Dati -->
                <TextBlock Text="POSIZIONE ARCHIVIO" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding PercorsoDatabase}" Style="{StaticResource FieldValue}" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="Apri cartella" Style="{StaticResource BtnOutline}" Margin="0,10,0,30"
        Command="{Binding ApriCartellaDatiCommand}" VerticalAlignment="Top" HorizontalAlignment="Left" Width="120"/>
                
                <TextBlock Text="DIMENSIONE DATABASE" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding DimensioneDatabaseTesto}" Style="{StaticResource FieldValue}" TextWrapping="Wrap" Margin="0,0,0,24"/>

                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource BrushTestoSecondario}" Margin="0,0,0,24">
    Tutti i dati sono salvati in questo unico file, sul computer. Non esiste un backup automatico:
    per essere al sicuro, crea periodicamente un backup di questo file (es. su una chiavetta o su
    un cloud come Google Drive/OneDrive), specialmente prima di aggiornare il programma.
                </TextBlock>

                <!-- FASE 9: MANUTENZIONE — backup database -->
                <TextBlock Text="MANUTENZIONE" Style="{StaticResource SectionTitle}"/>
                <Border Background="{StaticResource BrushSfondoChiaro}" BorderBrush="{StaticResource BrushBordo}"
                        BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Backup database" FontSize="14" FontWeight="Medium"
                                   Foreground="{StaticResource BrushTestoPrimario}" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource BrushTestoSecondario}" Margin="0,0,0,14">
                            Crea una copia completa e sicura del database CLab in una cartella a tua scelta.
                            Il backup non modifica i dati correnti.
                        </TextBlock>
                        <Button Style="{StaticResource BtnPrimary}" Content="Esegui backup"
                                Command="{Binding EseguiBackupCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Zona pericolosa -->
                <Border Background="{StaticResource BrushDangerLight}" BorderBrush="{StaticResource BrushDanger}"
                        BorderThickness="1" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Elimina tutti i dati" FontSize="14" FontWeight="Medium"
                                   Foreground="{StaticResource BrushDanger}" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource BrushDanger}" Margin="0,0,0,14">
                            Cancella definitivamente clienti, referenti, programmi, attività, scadenze e fatture.
                            Non può essere annullato. Assicurati di avere una copia del file sopra, se ti serve conservarli.
                        </TextBlock>
                        <TextBlock Text="Scrivi ELIMINA per confermare" Style="{StaticResource FieldLabel}"
                                   Foreground="{StaticResource BrushDanger}"/>
                        <TextBox Text="{Binding TestoConferma, UpdateSourceTrigger=PropertyChanged}"
                                 Width="220" HorizontalAlignment="Left" Padding="3,2" Margin="0,4,0,14"/>
                        <Button Style="{StaticResource BtnDanger}"
                                HorizontalAlignment="Left"
                                Command="{Binding EliminaDatiCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBootstrapIcons Kind="Trash"
Width="11" Height="11"
 VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
