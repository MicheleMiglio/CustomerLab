<UserControl x:Class="CLab.Views.ImpostazioniView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <UserControl.Resources>
        
        <Style x:Key="CardImpostazioni" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBordoLeggero}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <!-- Titolo interno alle sezioni -->
        <Style x:Key="TitoloSezioneImpostazioni"
               TargetType="TextBlock"
               BasedOn="{StaticResource SectionTitleTextStyle}">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Testo descrittivo secondario -->
        <Style x:Key="DescrizioneImpostazioni" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Bottone rosso: rimane esclusivo dell'azione distruttiva -->
        <Style x:Key="BtnDanger" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushDanger}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>


    <!-- ============================================================ -->
    <!-- PAGINA                                                        -->
    <!-- ============================================================ -->

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">        
        <Grid MaxWidth="1400"
      HorizontalAlignment="Stretch"
      Margin="28,20,28,28">

            <Grid.RowDefinitions>
                <!-- Titolo -->
                <RowDefinition Height="Auto"/>

                <!-- Applicazione + Manutenzione -->
                <RowDefinition Height="Auto"/>

                <!-- Sicurezza: modulo Password -->
                <RowDefinition Height="Auto"/>

                <!-- Zona pericolosa -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- ============================================================ -->
            <!-- HEADER                                                        -->
            <!-- ============================================================ -->

            <TextBlock Grid.Row="0"
               Text="Impostazioni"
               Style="{StaticResource ModuleTitleStyle}"
               Margin="0,0,0,20"/>


            <!-- ============================================================ -->
            <!-- APPLICAZIONE + MANUTENZIONE                                   -->
            <!-- ============================================================ -->

            <Grid Grid.Row="1"
          Margin="0,0,0,16">

                <Grid.ColumnDefinitions>
                    <!-- Applicazione: più spazio perché contiene il percorso -->
                    <ColumnDefinition Width="2*"/>

                    <!-- Spaziatura -->
                    <ColumnDefinition Width="16"/>

                    <!-- Manutenzione -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- ======================================================== -->
                <!-- APPLICAZIONE                                               -->
                <!-- ======================================================== -->

                <Border Grid.Column="0"
                Style="{StaticResource CardImpostazioni}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <!-- Titolo -->
                        <TextBlock Grid.Row="0"
                           Text="Applicazione"
                           Style="{StaticResource TitoloSezioneImpostazioni}"/>


                        <!-- Contenuto -->
                        <Grid Grid.Row="1">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>


                            <!-- VERSIONE -->
                            <StackPanel Grid.Row="0"
                                Margin="0,0,0,18">

                                <TextBlock Text="VERSIONE APPLICAZIONE"
                                   Style="{StaticResource FieldLabel}"/>

                                <TextBlock Text="{Binding Versione}"
                                   Style="{StaticResource FieldValue}"
                                   TextWrapping="Wrap"/>

                            </StackPanel>


                            <!-- POSIZIONE ARCHIVIO -->
                            <StackPanel Grid.Row="1"
                                Margin="0,0,0,18">

                                <TextBlock Text="POSIZIONE ARCHIVIO"
                                   Style="{StaticResource FieldLabel}"/>

                                <TextBlock Text="{Binding PercorsoDatabase}"
                                   Style="{StaticResource FieldValue}"
                                   TextWrapping="Wrap"/>

                                <Button Content="Apri cartella"
                                Style="{StaticResource BtnOutline}"
                                Margin="0,10,0,0"
                                Command="{Binding ApriCartellaDatiCommand}"
                                HorizontalAlignment="Left"
                                Width="120"/>

                            </StackPanel>


                            <!-- DIMENSIONE DATABASE -->
                            <StackPanel Grid.Row="2"
                                Margin="0,0,0,18">

                                <TextBlock Text="DIMENSIONE DATABASE"
                                   Style="{StaticResource FieldLabel}"/>

                                <TextBlock Text="{Binding DimensioneDatabaseTesto}"
                                   Style="{StaticResource FieldValue}"
                                   TextWrapping="Wrap"/>

                            </StackPanel>


                            <!-- INFORMAZIONE BACKUP -->
                            <TextBlock Grid.Row="3"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{StaticResource BrushTestoSecondario}">
                        Tutti i dati sono salvati in questo unico file, sul computer.
                        Non esiste un backup automatico: per essere al sicuro, crea
                        periodicamente un backup di questo file (es. su una chiavetta
                        o su un cloud come Google Drive/OneDrive), specialmente prima
                        di aggiornare il programma.
                            </TextBlock>

                        </Grid>

                    </Grid>

                </Border>


                <!-- ======================================================== -->
                <!-- MANUTENZIONE                                               -->
                <!-- ======================================================== -->

                <Border Grid.Column="2"
                Style="{StaticResource CardImpostazioni}">

                    <StackPanel>

                        <TextBlock Text="Backup database"
                           Style="{StaticResource TitoloSezioneImpostazioni}"/>

                        <TextBlock TextWrapping="Wrap"
                           Style="{StaticResource DescrizioneImpostazioni}"
                           Margin="0,0,0,14">
                    Crea una copia completa e sicura del database CLab in una
                    cartella a tua scelta. Il backup non modifica i dati correnti.
                        </TextBlock>

                        <Button Command="{Binding EseguiBackupCommand}" MaxWidth="140" HorizontalAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
                                    <Setter Property="Padding" Value="14,7"/>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBootstrapIcons Kind="Download" Width="12" Height="12"
VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Esegui backup" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                </Border>

            </Grid>

            <!-- ============================================================ -->
            <!-- SICUREZZA: MODULO PASSWORD                                    -->
            <!-- ============================================================ -->

            <Border Grid.Row="2"
                    Style="{StaticResource CardImpostazioni}"
                    Margin="0,0,0,16">

                <StackPanel>

                    <TextBlock Text="Modulo Password"
                               Style="{StaticResource TitoloSezioneImpostazioni}"/>

                    <TextBlock Style="{StaticResource DescrizioneImpostazioni}"
                               Margin="0,0,0,14">
                        L'archivio delle credenziali è protetto da una password principale:
                        il database contiene solo dati cifrati (AES-256-GCM) e la chiave resta
                        in memoria unicamente a sessione aperta, per 15 minuti dall'ultima attività.
                    </TextBlock>

                    <TextBlock Text="STATO"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBlock Text="{Binding PasswordStato}"
                               Style="{StaticResource FieldValue}"
                               Margin="0,0,0,14"/>

                    <Button Command="{Binding BloccaPasswordCommand}"
                            HorizontalAlignment="Left"
                            Visibility="{Binding PasswordSbloccato, Converter={StaticResource BoolToVisibility}}">

                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource BtnOutline}">
                                <Setter Property="Padding" Value="14,7"/>
                            </Style>
                        </Button.Style>

                        <StackPanel Orientation="Horizontal">

                            <iconPacks:PackIconBootstrapIcons
                                Kind="Lock"
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center"
                                Margin="0,0,7,0"/>

                            <TextBlock Text="Blocca ora"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <!-- Recupero: solo se il modulo è già configurato -->
                    <StackPanel Visibility="{Binding PasswordConfigurato, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,18,0,0">

                        <TextBlock Text="Reimposta la password principale"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource BrushTestoPrimario}"/>

                        <TextBlock Style="{StaticResource DescrizioneImpostazioni}"
                                   Margin="0,4,0,12">
                            Con il codice di recupero mostrato alla prima configurazione puoi
                            impostare una nuova password principale: le credenziali salvate
                            restano invariate e il codice resta valido.
                        </TextBlock>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CODICE DI RECUPERO"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox AutomationProperties.AutomationId="RecoveryCodeImpostazioni"
                                         Margin="0,4,0,0"
                                         ToolTip="Formato XXXX-XXXX-XXXX-XXXX"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="NUOVA PASSWORD PRINCIPALE"
                                           Style="{StaticResource FieldLabel}"/>
                                <PasswordBox AutomationProperties.AutomationId="NuovaMasterImpostazioni"
                                             Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="CONFERMA NUOVA PASSWORD PRINCIPALE"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,12,0,0"/>

                        <PasswordBox AutomationProperties.AutomationId="NuovaMasterConfermaImpostazioni"
                                     Margin="0,4,0,12"
                                     MaxWidth="360"
                                     HorizontalAlignment="Left"/>

                        <Button Command="{Binding ReimpostaPasswordCommand}"
                                HorizontalAlignment="Left"
                                ToolTip="Reimposta la password principale del modulo Password">

                            <Button.Style>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource BtnOutline}">
                                    <Setter Property="Padding" Value="14,7"/>
                                </Style>
                            </Button.Style>

                            <StackPanel Orientation="Horizontal">

                                <iconPacks:PackIconBootstrapIcons
                                    Kind="ArrowCounterclockwise"
                                    Width="12"
                                    Height="12"
                                    VerticalAlignment="Center"
                                    Margin="0,0,7,0"/>

                                <TextBlock Text="Reimposta password principale"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                    </StackPanel>

                    <TextBlock Text="{Binding PasswordMessaggio}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource BrushDanger}"
                               Margin="0,14,0,0"
                               Visibility="{Binding PasswordMessaggio, Converter={StaticResource BoolToVisibility}}"/>

                </StackPanel>

            </Border>

            <Border Grid.Row="3"
        Style="{StaticResource CardImpostazioni}">

                <StackPanel>

                    <TextBlock Text="Elimina tutti i dati"
                           Style="{StaticResource TitoloSezioneImpostazioni}"/>

                    <!-- Descrizione -->
                    <TextBlock TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{StaticResource BrushTestoSecondario}"
                   Margin="0,0,0,5">
            Cancella definitivamente clienti, referenti, programmi,
            attività, scadenze e fatture. L'operazione non può essere annullata.
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{StaticResource BrushTestoSecondario}"
                   Margin="0,0,0,20">            
            Assicurati di avere una copia del database se vuoi conservarne i dati.
                    </TextBlock>


                    <!-- Conferma -->
                    <TextBlock Style="{StaticResource FieldLabel}"
                   Foreground="{StaticResource BrushTestoSecondario}">
            Per confermare, scrivi <Run Text="ELIMINA"
                                       Foreground="{StaticResource BrushDanger}"
                                       FontWeight="SemiBold"/>
                    </TextBlock>

                    <TextBox Text="{Binding TestoConferma, UpdateSourceTrigger=PropertyChanged}"
                 Width="220"
                 HorizontalAlignment="Left"
                 Padding="5,1"
                 Margin="0,5,0,14"/>


                    <!-- Azione distruttiva -->
                    <Button Style="{StaticResource BtnDanger}"
                HorizontalAlignment="Left"
                Command="{Binding EliminaDatiCommand}">

                        <StackPanel Orientation="Horizontal">

                            <iconPacks:PackIconBootstrapIcons Kind="Trash"
                                                  Width="12"
                                                  Height="12"
                                                  VerticalAlignment="Center"/>

                            <TextBlock Text="Elimina dati"
                           Margin="7,0,0,0"
                           VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                </StackPanel>

            </Border>

        </Grid>
        
    </ScrollViewer>

</UserControl>