<UserControl x:Class="CLab.Views.PasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:views="clr-namespace:CLab.Views">

    <!-- ============================================================ -->
    <!-- MODULO PASSWORD                                              -->
    <!-- Archivio locale di credenziali: nel database i dati non sono  -->
    <!-- mai in chiaro (payload JSON cifrato AES-256-GCM). La password -->
    <!-- NON compare nella lista e non è mai una proprietà del         -->
    <!-- ViewModel: vive solo nei PasswordBox (non bindabili), che il  -->
    <!-- code-behind aggancia al ViewModel quando l'albero visuale è   -->
    <!-- pronto, riconoscendoli per AutomationId e non per x:Name: il  -->
    <!-- contenuto di ModalDialogControl ha un namescope proprio       -->
    <!-- (nessun x:Name dentro il modal, quindi nessun errore MC3093). -->
    <!-- ============================================================ -->

    <UserControl.Resources>

        <!-- ========================================================= -->
        <!-- AZIONI GRIGLIA                                            -->
        <!-- ========================================================= -->

        <Style x:Key="AzionePassword" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                        Value="{StaticResource BrushHoverNeutro}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource BrushTestoPrimario}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AzionePasswordElimina"
               TargetType="Button"
               BasedOn="{StaticResource AzionePassword}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground"
                            Value="{StaticResource BrushStatoCessato}"/>
                    <Setter Property="Background"
                            Value="{StaticResource BrushHoverNeutro}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ========================================================= -->
        <!-- CAMPI PASSWORD                                            -->
        <!-- ========================================================= -->

        <Style x:Key="CampoPasswordCopia"
               TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="CampoPasswordLabel"
               TargetType="TextBlock"
               BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="BottoneIconaCampo"
               TargetType="Button"
               BasedOn="{StaticResource BtnIconGhost}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Card delle sezioni di accesso (configurazione, sblocco e
             recupero): stessa superficie bianca delle card di Impostazioni,
             così la schermata di accesso resta coerente con il resto di CLab. -->
        <Style x:Key="CardPassword" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBordoLeggero}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
            <Setter Property="Padding" Value="22"/>
        </Style>

        <!-- Esito delle operazioni di accesso (errore o conferma) -->
        <Style x:Key="MessaggioPassword" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Esito dei campi del form (copia, generatore, appunti) -->
        <Style x:Key="FeedbackPassword" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

    </UserControl.Resources>

    <Grid>

        <!-- Righe: header, ricerca, sezioni di accesso (configurazione /
             sblocco, entrambe a scomparsa), lista. Le tre zone "grandi"
             non sono mai visibili insieme: le sezioni di accesso stanno
             prima della riga star, così quando sono attive restano in cima. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- HEADER                                                     -->
        <!-- ========================================================= -->

        <Border Grid.Row="0"
                Style="{StaticResource ModuleHeaderBorderStyle}"
                Padding="28,0">

            <Grid VerticalAlignment="Center">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Password"
                               Style="{StaticResource ModuleTitleStyle}"/>
                    <TextBlock Text="{Binding Stato}"
                               Style="{StaticResource ModuleSubtitleStyle}"/>
                </StackPanel>

                <!-- Lock manuale: disponibile solo a sessione aperta -->
                <Button Grid.Column="1"
                        Command="{Binding LockCommand}"
                        ToolTip="Blocca il modulo e cancella le password dalla memoria"
                        Margin="0,0,10,0"
                        Visibility="{Binding MostraElenco, Converter={StaticResource BoolToVisibility}}">

                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource BtnOutline}">
                            <Setter Property="Padding" Value="14,7"/>
                        </Style>
                    </Button.Style>

                    <StackPanel Orientation="Horizontal">

                        <iconPacks:PackIconBootstrapIcons
                            Kind="Lock"
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            Margin="0,0,7,0"/>

                        <TextBlock Text="Blocca"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

                <!-- Aggiungi: solo a sessione aperta -->
                <Button Grid.Column="2"
                        Command="{Binding AggiungiCommand}"
                        ToolTip="Aggiungi password"
                        Visibility="{Binding MostraElenco, Converter={StaticResource BoolToVisibility}}">

                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource BtnPrimary}">
                            <Setter Property="Padding" Value="14,7"/>
                        </Style>
                    </Button.Style>

                    <StackPanel Orientation="Horizontal">

                        <iconPacks:PackIconBootstrapIcons
                            Kind="Plus"
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            Margin="0,0,7,0"/>

                        <TextBlock Text="Aggiungi password"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

            </Grid>

        </Border>

        <!-- ========================================================= -->
        <!-- CONFIGURAZIONE INIZIALE                                    -->
        <!-- ========================================================= -->

        <Border Grid.Row="2"
                Style="{StaticResource CardPassword}"
                Width="560"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="28,24,28,0"
                Visibility="{Binding MostraConfigurazione, Converter={StaticResource BoolToVisibility}}">

            <StackPanel>

                <TextBlock Text="Configura il modulo"
                           Style="{StaticResource SectionTitleTextStyle}"/>

                <TextBlock Text="Scegli la password principale: protegge tutte le credenziali salvate su questo computer e non viene mai salvata da nessuna parte. Al termine il codice di recupero verrà mostrato una sola volta."
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,6,0,20"/>

                <TextBlock Text="Password principale"
                           Style="{StaticResource CampoPasswordLabel}"/>

                <PasswordBox AutomationProperties.AutomationId="PasswordConfigurazione"
                             Margin="0,0,0,16"/>

                <TextBlock Text="Conferma password principale"
                           Style="{StaticResource CampoPasswordLabel}"/>

                <PasswordBox AutomationProperties.AutomationId="PasswordConfigurazioneConferma"
                             Margin="0,0,0,16"/>

                <TextBlock Text="{Binding Messaggio}"
                           Style="{StaticResource MessaggioPassword}"
                           Visibility="{Binding Messaggio, Converter={StaticResource BoolToVisibility}}"/>

                <Button Command="{Binding ConfiguraCommand}"
                        HorizontalAlignment="Left"
                        ToolTip="Configura il modulo Password">

                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource BtnPrimary}">
                            <Setter Property="Padding" Value="14,7"/>
                        </Style>
                    </Button.Style>

                    <StackPanel Orientation="Horizontal">

                        <iconPacks:PackIconBootstrapIcons
                            Kind="ShieldLock"
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            Margin="0,0,7,0"/>

                        <TextBlock Text="Configura modulo"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

            </StackPanel>

        </Border>

        <!-- ========================================================= -->
        <!-- SBLOCCO E RECUPERO                                         -->
        <!-- ========================================================= -->

        <Grid Grid.Row="3"
              Margin="28,24,28,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Visibility="{Binding MostraSblocco, Converter={StaticResource BoolToVisibility}}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Sblocco con la password principale -->
            <Border Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource CardPassword}"
                    VerticalAlignment="Top">

                <StackPanel>

                    <TextBlock Text="Sblocca il modulo"
                               Style="{StaticResource SectionTitleTextStyle}"/>

                    <TextBlock Text="Inserisci la password principale. Il modulo si blocca da solo dopo 15 minuti di inattività."
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,6,0,20"/>

                    <TextBlock Text="Password principale"
                               Style="{StaticResource CampoPasswordLabel}"/>

                    <PasswordBox AutomationProperties.AutomationId="PasswordSblocco"
                                 Margin="0,0,0,16"/>

                    <Button Command="{Binding SbloccaCommand}"
                            HorizontalAlignment="Left"
                            ToolTip="Sblocca il modulo">

                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource BtnPrimary}">
                                <Setter Property="Padding" Value="14,7"/>
                            </Style>
                        </Button.Style>

                        <StackPanel Orientation="Horizontal">

                            <iconPacks:PackIconBootstrapIcons
                                Kind="Unlock"
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center"
                                Margin="0,0,7,0"/>

                            <TextBlock Text="Sblocca"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                </StackPanel>

            </Border>

            <!-- Recupero con il codice di recupero -->
            <Border Grid.Row="0"
                    Grid.Column="2"
                    Style="{StaticResource CardPassword}"
                    VerticalAlignment="Top">

                <StackPanel>

                    <TextBlock Text="Recupero"
                               Style="{StaticResource SectionTitleTextStyle}"/>

                    <TextBlock Text="Hai dimenticato la password principale? Con il codice di recupero puoi impostarne una nuova: le credenziali salvate restano le stesse e il codice resta valido."
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,6,0,20"/>

                    <TextBlock Text="Codice di recupero"
                               Style="{StaticResource CampoPasswordLabel}"/>

                    <TextBox AutomationProperties.AutomationId="TextBoxRecovery"
                             Margin="0,0,0,16"
                             ToolTip="Formato XXXX-XXXX-XXXX-XXXX"/>

                    <TextBlock Text="Nuova password principale"
                               Style="{StaticResource CampoPasswordLabel}"/>

                    <PasswordBox AutomationProperties.AutomationId="PasswordNuovaMaster"
                                 Margin="0,0,0,16"/>

                    <TextBlock Text="Conferma nuova password principale"
                               Style="{StaticResource CampoPasswordLabel}"/>

                    <PasswordBox AutomationProperties.AutomationId="PasswordNuovaConferma"
                                 Margin="0,0,0,16"/>

                    <Button Command="{Binding RecuperaCommand}"
                            HorizontalAlignment="Left"
                            ToolTip="Reimposta la password principale">

                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource BtnOutline}">
                                <Setter Property="Padding" Value="14,7"/>
                            </Style>
                        </Button.Style>

                        <StackPanel Orientation="Horizontal">

                            <iconPacks:PackIconBootstrapIcons
                                Kind="ArrowCounterclockwise"
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center"
                                Margin="0,0,7,0"/>

                            <TextBlock Text="Reimposta password principale"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                </StackPanel>

            </Border>

            <!-- Esito dell'ultima operazione (errore o conferma) -->
            <TextBlock Grid.Row="1"
                       Grid.ColumnSpan="3"
                       Text="{Binding Messaggio}"
                       Style="{StaticResource MessaggioPassword}"
                       Margin="0,16,0,0"
                       Visibility="{Binding Messaggio, Converter={StaticResource BoolToVisibility}}"/>

        </Grid>

        <!-- ========================================================= -->
        <!-- RICERCA                                                    -->
        <!-- ========================================================= -->

        <Border Grid.Row="1"
                Margin="28,16,28,0"
                Visibility="{Binding MostraElenco, Converter={StaticResource BoolToVisibility}}">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Height="36"
                        MaxWidth="520"
                        HorizontalAlignment="Left"
                        Background="White"
                        BorderBrush="{StaticResource BrushBordoLeggero}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusSmall}">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <iconPacks:PackIconBootstrapIcons
                            Grid.Column="0"
                            Kind="Search"
                            Width="14"
                            Height="14"
                            Foreground="{StaticResource BrushTestoTerziario}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding FiltroTesto, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 Padding="0,0,10,0"
                                 ToolTip="Cerca per nome, sito, username o note"/>

                    </Grid>

                </Border>

                <TextBlock Grid.Column="1"
                           Text="{Binding Voci.Count, StringFormat={}{0} password}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BrushTestoTerziario}"
                           FontSize="12"
                           Margin="16,0,0,0"/>

            </Grid>

        </Border>

        <!-- ========================================================= -->
        <!-- LISTA                                                      -->
        <!-- ========================================================= -->

        <Grid Grid.Row="4"
              Margin="28,16,28,24"
              Visibility="{Binding MostraElenco, Converter={StaticResource BoolToVisibility}}">

            <!-- Empty state -->

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Voci.Count}"
                                         Value="0">
                                <Setter Property="Visibility"
                                        Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <iconPacks:PackIconBootstrapIcons
                    Kind="Key"
                    Width="30"
                    Height="30"
                    Foreground="{StaticResource BrushTestoTerziario}"
                    HorizontalAlignment="Center"/>

                <TextBlock Text="Nessuna password"
                           Style="{StaticResource SectionTitleTextStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>

                <TextBlock Text="{Binding EmptyStateTesto}"
                           Style="{StaticResource SecondaryTextStyle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           MaxWidth="420"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>

                <Button Command="{Binding AggiungiCommand}"
                        HorizontalAlignment="Center"
                        Margin="0,16,0,0"
                        ToolTip="Aggiungi password">

                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource BtnPrimary}">
                            <Setter Property="Padding" Value="14,7"/>
                        </Style>
                    </Button.Style>

                    <StackPanel Orientation="Horizontal">

                        <iconPacks:PackIconBootstrapIcons
                            Kind="Plus"
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            Margin="0,0,7,0"/>

                        <TextBlock Text="Aggiungi password"/>

                    </StackPanel>

                </Button>

            </StackPanel>

            <!-- DataGrid -->

            <!-- DataGrid -->

            <DataGrid x:Name="VociDataGrid"
                      ItemsSource="{Binding Voci}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      IsReadOnly="True"
                      Style="{StaticResource ModuleDataGridStyle}"
                      HeadersVisibility="Column"
                      MouseDoubleClick="VociDataGrid_MouseDoubleClick">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Nome"
                                        Binding="{Binding Nome}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="Sito"
                                        Binding="{Binding Sito}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="Username"
                                        Binding="{Binding Username}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="Aggiornata"
                                        Binding="{Binding AggiornataDisplay}"
                                        Width="150"/>

                    <!-- PASSWORD NON PRESENTE NELLA LISTA -->

                    <DataGridTemplateColumn Header=""
                                            Width="100">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">

                                    <Button Style="{StaticResource AzionePassword}"
                                            Command="{Binding DataContext.ModificaVoceCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Modifica">

                                        <iconPacks:PackIconBootstrapIcons
                                            Kind="Pencil"
                                            Width="13"
                                            Height="13"/>

                                    </Button>

                                    <Button Style="{StaticResource AzionePasswordElimina}"
                                            Command="{Binding DataContext.EliminaVoceCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Elimina"
                                            Margin="4,0,0,0">

                                        <iconPacks:PackIconBootstrapIcons
                                            Kind="Trash"
                                            Width="13"
                                            Height="13"/>

                                    </Button>

                                </StackPanel>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Grid>

        <!-- ========================================================= -->
        <!-- MODAL NUOVA / MODIFICA                                    -->
        <!-- ========================================================= -->

        <views:ModalDialogControl
            Grid.Row="0"
            Grid.RowSpan="5"
            IsAperto="{Binding PannelloAperto}"
            Titolo="{Binding TitoloPannello}"
            ComandoChiudi="{Binding AnnullaCommand}"
            ComandoSalva="{Binding SalvaCommand}"
            HaModificheNonSalvate="{Binding HaModifiche}">

            <views:ModalDialogControl.Contenuto>

                <StackPanel>

                    <!-- NOME -->

                    <TextBlock Text="Nome"
                               Style="{StaticResource CampoPasswordLabel}"/>

                    <TextBox Text="{Binding FormNome,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16"/>

                    <!-- SITO -->

                    <TextBlock Text="Sito"
                               Style="{StaticResource CampoPasswordLabel}"/>

                    <Grid Margin="0,0,0,16">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding FormSito,
                                                UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Grid.Column="1"
                                Style="{StaticResource BottoneIconaCampo}"
                                Command="{Binding CopiaCampoCommand}"
                                CommandParameter="sito"
                                ToolTip="Copia sito"
                                Margin="8,0,0,0">

                            <iconPacks:PackIconBootstrapIcons
                                Kind="Copy"
                                Width="14"
                                Height="14"/>

                        </Button>

                    </Grid>

                    <!-- USERNAME -->

                    <TextBlock Text="Username"
                               Style="{StaticResource CampoPasswordLabel}"/>

                    <Grid Margin="0,0,0,16">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding FormUsername,
                                                UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Grid.Column="1"
                                Style="{StaticResource BottoneIconaCampo}"
                                Command="{Binding CopiaCampoCommand}"
                                CommandParameter="username"
                                ToolTip="Copia username"
                                Margin="8,0,0,0">

                            <iconPacks:PackIconBootstrapIcons
                                Kind="Copy"
                                Width="14"
                                Height="14"/>

                        </Button>

                    </Grid>

                    <!-- PASSWORD -->

                    <TextBlock Text="Password"
                               Style="{StaticResource CampoPasswordLabel}"/>

                    <Grid Margin="0,0,0,8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- PasswordBox mascherata -->

                        <PasswordBox
                                     Grid.Column="0"
                                     AutomationProperties.AutomationId="PasswordForm"
                                     PasswordChanged="PwForm_PasswordChanged"
                                     Visibility="{Binding PasswordFormVisibile, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}"/>

                        <!-- Campo in chiaro -->

                        <TextBox
                                 Grid.Column="0"
                                 AutomationProperties.AutomationId="PasswordFormChiara"
                                 Visibility="{Binding PasswordFormVisibile, Converter={StaticResource BoolToVisibility}}"
                                 TextChanged="TxtFormChiara_TextChanged"
                                 VerticalContentAlignment="Center"/>

                        <!-- Mostra / nascondi -->

                        <Button Grid.Column="1"
                                Style="{StaticResource BottoneIconaCampo}"
                                Command="{Binding TogglePasswordCommand}"
                                ToolTip="{Binding EtichettaTogglePassword}"
                                Margin="8,0,0,0">

                            <iconPacks:PackIconBootstrapIcons
                                Width="14"
                                Height="14">
                                <iconPacks:PackIconBootstrapIcons.Style>
                                    <Style TargetType="iconPacks:PackIconBootstrapIcons">
                                        <Setter Property="Kind" Value="Eye"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PasswordFormVisibile}" Value="True">
                                                <Setter Property="Kind" Value="EyeSlash"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </iconPacks:PackIconBootstrapIcons.Style>
                            </iconPacks:PackIconBootstrapIcons>

                        </Button>

                        <!-- Copia -->

                        <Button Grid.Column="2"
                                Style="{StaticResource BottoneIconaCampo}"
                                Command="{Binding CopiaCampoCommand}"
                                CommandParameter="password"
                                ToolTip="Copia password"
                                Margin="4,0,0,0">

                            <iconPacks:PackIconBootstrapIcons
                                Kind="Copy"
                                Width="14"
                                Height="14"/>

                        </Button>

                    </Grid>

                    <!-- Esito della copia degli altri campi -->
                    <TextBlock Text="{Binding FeedbackCopia}"
                               Style="{StaticResource FeedbackPassword}"
                               Margin="0,0,0,16"
                               Visibility="{Binding FeedbackCopia, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- GENERATORE -->

                    <Border Background="{StaticResource BrushSidebarHover}"
                            BorderBrush="{StaticResource BrushBordoLeggero}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSmall}"
                            Padding="12"
                            Margin="0,0,0,16">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Parametri del generatore: lunghezza e categorie -->
                            <StackPanel Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Margin="0,12,0,0">

                                <TextBlock Text="{Binding LunghezzaTesto}"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTestoSecondario}"/>

                                <Slider Minimum="8"
                                        Maximum="64"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding Lunghezza}"
                                        Margin="0,2,0,6"
                                        ToolTip="Lunghezza della password (da 8 a 64 caratteri)"/>

                                <StackPanel Orientation="Horizontal">

                                    <CheckBox Content="Maiuscole"
                                              IsChecked="{Binding UsaMaiuscole}"
                                              Style="{StaticResource ModuleCheckBoxStyle}"
                                              Margin="0,0,14,0"/>

                                    <CheckBox Content="Minuscole"
                                              IsChecked="{Binding UsaMinuscole}"
                                              Style="{StaticResource ModuleCheckBoxStyle}"
                                              Margin="0,0,14,0"/>

                                    <CheckBox Content="Numeri"
                                              IsChecked="{Binding UsaNumeri}"
                                              Style="{StaticResource ModuleCheckBoxStyle}"
                                              Margin="0,0,14,0"/>

                                    <CheckBox Content="Simboli"
                                              IsChecked="{Binding UsaSimboli}"
                                              Style="{StaticResource ModuleCheckBoxStyle}"/>

                                </StackPanel>

                            </StackPanel>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="0">

                                <TextBlock Text="Genera password"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource BrushTestoPrimario}"/>

                                <TextBlock Text="Genera una password casuale sicura."
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTestoSecondario}"
                                           Margin="0,3,0,0"/>

                            </StackPanel>

                            <Button Grid.Row="0"
                                    Grid.Column="1"
                                    Command="{Binding GeneraCommand}"
                                    ToolTip="Genera password">

                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource BtnOutline}">
                                        <Setter Property="Padding" Value="12,6"/>
                                    </Style>
                                </Button.Style>

                                <StackPanel Orientation="Horizontal">

                                    <iconPacks:PackIconBootstrapIcons
                                        Kind="ArrowRepeat"
                                        Width="12"
                                        Height="12"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0"/>

                                    <TextBlock Text="Genera"/>

                                </StackPanel>

                            </Button>

                            <Grid Grid.Row="2"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="2"
                                  Margin="0,12,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <PasswordBox
                                             Grid.Column="0"
                                             AutomationProperties.AutomationId="PasswordGenerata"/>

                                <Button Grid.Column="1"
                                        Style="{StaticResource BottoneIconaCampo}"
                                        Command="{Binding UsaGenerataCommand}"
                                        ToolTip="Usa password generata"
                                        Margin="8,0,0,0">

                                    <iconPacks:PackIconBootstrapIcons
                                        Kind="Check2"
                                        Width="14"
                                        Height="14"/>

                                </Button>

                                <Button Grid.Column="2"
                                        Style="{StaticResource BottoneIconaCampo}"
                                        Command="{Binding CopiaGenerataCommand}"
                                        ToolTip="Copia password generata"
                                        Margin="4,0,0,0">

                                    <iconPacks:PackIconBootstrapIcons
                                        Kind="Copy"
                                        Width="14"
                                        Height="14"/>

                                </Button>

                            </Grid>

                        </Grid>

                    </Border>

                    <!-- Esito del generatore e della copia negli appunti -->
                    <TextBlock Text="{Binding FeedbackGeneratore}"
                               Style="{StaticResource FeedbackPassword}"
                               Visibility="{Binding FeedbackGeneratore, Converter={StaticResource BoolToVisibility}}"/>

                    <TextBlock Text="{Binding FeedbackClipboard}"
                               Style="{StaticResource FeedbackPassword}"
                               Visibility="{Binding FeedbackClipboard, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- NOTE -->

                    <TextBlock Text="Note"
                               Style="{StaticResource CampoPasswordLabel}"/>

                    <TextBox Text="{Binding FormNote,
                                            UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             Height="90"/>

                    <!-- Errore del form (es. nome mancante) -->
                    <TextBlock Text="{Binding VoceFeedback}"
                               Style="{StaticResource MessaggioPassword}"
                               Margin="0,14,0,0"
                               Visibility="{Binding VoceFeedback, Converter={StaticResource BoolToVisibility}}"/>

                </StackPanel>

            </views:ModalDialogControl.Contenuto>

        </views:ModalDialogControl>

        <!-- ========================================================= -->
        <!-- CODICE DI RECUPERO: MOSTRATO UNA SOLA VOLTA                -->
        <!-- ========================================================= -->

        <Grid Grid.Row="0"
              Grid.RowSpan="5"
              Visibility="{Binding MostraRecoveryCode, Converter={StaticResource BoolToVisibility}}">

            <Border Style="{StaticResource OverlayScuroStyle}"/>

            <Border Background="White"
                    BorderBrush="{StaticResource BrushBordoLeggero}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLarge}"
                    Effect="{StaticResource PanelShadowEffect}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="520"
                    Padding="26">

                <StackPanel>

                    <TextBlock Text="Codice di recupero"
                               Style="{StaticResource SectionTitleTextStyle}"/>

                    <TextBlock Text="Conserva questo codice in un posto sicuro: viene mostrato una sola volta e serve a reimpostare la password principale se la dimentichi. Non è recuperabile in alcun modo."
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,8,0,16"/>

                    <Border Background="{StaticResource BrushSfondoFine}"
                            BorderBrush="{StaticResource BrushBordoLeggero}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSmall}"
                            Padding="14">

                        <TextBox Text="{Binding RecoveryCodeMonouso, Mode=OneWay}"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="18"
                                 FontFamily="{StaticResource FontFamilyNumeric}"
                                 HorizontalAlignment="Center"/>

                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">

                        <Button Command="{Binding CopiaRecoveryCodeCommand}"
                                Style="{StaticResource BtnOutline}"
                                Content="Copia codice"/>

                        <Button Command="{Binding ChiudiRecoveryCodeCommand}"
                                Style="{StaticResource BtnPrimary}"
                                Content="Ho salvato il codice"
                                Margin="10,0,0,0"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>