<UserControl x:Class="CLab.Views.PasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:views="clr-namespace:CLab.Views">

    <!-- ============================================================ -->
    <!-- MODULO PASSWORD                                              -->
    <!-- Archivio locale di credenziali: nel database i dati non sono  -->
    <!-- mai in chiaro (payload JSON cifrato AES-256-GCM). La password -->
    <!-- NON compare nella lista e non è mai una proprietà del         -->
    <!-- ViewModel: vive solo nei PasswordBox (non bindabili), che il  -->
    <!-- code-behind aggancia al ViewModel quando l'albero visuale è   -->
    <!-- pronto, riconoscendoli per AutomationId e non per x:Name: il  -->
    <!-- contenuto di ModalDialogControl ha un namescope proprio       -->
    <!-- (nessun x:Name dentro il modal, quindi nessun errore MC3093). -->
    <!-- ============================================================ -->

    <UserControl.Resources>

        <!-- ========================================================= -->
        <!-- AZIONI GRIGLIA                                            -->
        <!-- ========================================================= -->

        <Style x:Key="AzionePassword" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushHoverNeutro}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Elimina: neutra a riposo, rosso solo come feedback di hover. -->
        <Style x:Key="AzionePasswordElimina" TargetType="Button" BasedOn="{StaticResource AzionePassword}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrushStatoCessato}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Header di colonna: identico a Fatture (indicatore ▲/▼ sulla colonna ordinata). -->
        <Style x:Key="PasswordColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource BrushBordoLeggero}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="Center"/>
                                    <TextBlock x:Name="freccia" Text="▼" FontSize="8"
                                        Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Margin="0,1,12,0" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left"
                                Width="4" Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Rectangle Fill="Transparent"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                                Width="4" Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Rectangle Fill="Transparent"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="freccia" Property="Text" Value="▲"/>
                                <Setter TargetName="freccia" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="freccia" Property="Text" Value="▼"/>
                                <Setter TargetName="freccia" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushSfondoChiaro}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================================================= -->
        <!-- CAMPI PASSWORD                                            -->
        <!-- ========================================================= -->

        <!-- Celle della griglia: stesso testo di Studi (13 Medium per la
             colonna principale, 12 secondario per le altre, ellissi). -->
        <Style x:Key="PasswordCellaPrimaria" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="PasswordCellaSecondaria" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="CampoPasswordLabel"
               TargetType="TextBlock"
               BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="BottoneIconaCampo"
               TargetType="Button"
               BasedOn="{StaticResource BtnIconGhost}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Card delle sezioni di accesso (configurazione, sblocco e
             recupero): stessa superficie bianca delle card di Impostazioni,
             così la schermata di accesso resta coerente con il resto di CLab. -->
        <Style x:Key="CardPassword" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBordoLeggero}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
            <Setter Property="Padding" Value="22"/>
        </Style>

        <!-- Esito delle operazioni di accesso (errore o conferma) -->
        <Style x:Key="MessaggioPassword" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Esito dei campi del form (copia, generatore, appunti) -->
        <Style x:Key="FeedbackPassword" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

    </UserControl.Resources>

    <Grid>

        <!-- Righe: header, ricerca, sezioni di accesso (configurazione /
             sblocco, entrambe a scomparsa), lista. Le tre zone "grandi"
             non sono mai visibili insieme: le sezioni di accesso stanno
             prima della riga star, così quando sono attive restano in cima. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- HEADER                                                     -->
        <!-- ========================================================= -->

        <Border Grid.Row="0"
                Style="{StaticResource ModuleHeaderBorderStyle}"
                Padding="28,0">

            <Grid VerticalAlignment="Center">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Password"
                               Style="{StaticResource ModuleTitleStyle}"/>
                </StackPanel>

                <!-- Lock manuale: disponibile solo a sessione aperta -->
                <Button Grid.Column="1"
                        Command="{Binding LockCommand}"
                        ToolTip="Blocca il modulo e cancella le password dalla memoria"
                        Margin="0,0,10,0"
                        Visibility="{Binding MostraElenco, Converter={StaticResource BoolToVisibility}}">

                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource BtnOutline}">
                            <Setter Property="Padding" Value="14,7"/>
                        </Style>
                    </Button.Style>

                    <StackPanel Orientation="Horizontal">

                        <iconPacks:PackIconBootstrapIcons
                            Kind="Lock"
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            Margin="0,0,7,0"/>

                        <TextBlock Text="Blocca"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

                <!-- Aggiungi: solo a sessione aperta -->
                <Button Grid.Column="2"
                        Command="{Binding AggiungiCommand}"
                        ToolTip="Aggiungi password"
                        Visibility="{Binding MostraElenco, Converter={StaticResource BoolToVisibility}}">

                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource BtnPrimary}">
                            <Setter Property="Padding" Value="14,7"/>
                        </Style>
                    </Button.Style>

                    <StackPanel Orientation="Horizontal">

                        <iconPacks:PackIconBootstrapIcons
                            Kind="Plus"
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            Margin="0,0,7,0"/>

                        <TextBlock Text="Aggiungi password"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

            </Grid>

        </Border>

        <!-- ========================================================= -->
        <!-- CONFIGURAZIONE INIZIALE                                    -->
        <!-- ========================================================= -->

        <Border Grid.Row="2"
        Style="{StaticResource CardPassword}"
        Width="560"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Margin="28,20,28,0"
        Visibility="{Binding MostraConfigurazione,
                             Converter={StaticResource BoolToVisibility}}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- TITOLO                                             -->
                <!-- ================================================= -->

                <TextBlock Grid.Row="0"
                   Text="Configura il modulo"
                   Style="{StaticResource SectionTitleTextStyle}"/>


                <!-- ================================================= -->
                <!-- DESCRIZIONE                                         -->
                <!-- ================================================= -->

                <TextBlock Grid.Row="1"
                   Text="Scegli una password principale (almeno 8 caratteri) per proteggere le credenziali salvate su questo computer. Non viene memorizzata: se la dimentichi potrai reimpostarla solo con il codice di recupero, che ti mostreremo una sola volta al termine."
                   Style="{StaticResource SecondaryTextStyle}"
                   Margin="0,6,0,22"
                   TextWrapping="Wrap"/>


                <!-- ================================================= -->
                <!-- PASSWORD                                           -->
                <!-- ================================================= -->

                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- PASSWORD PRINCIPALE -->
                    <StackPanel Grid.Column="0">

                        <TextBlock Text="PASSWORD PRINCIPALE"
                           Style="{StaticResource CampoPasswordLabel}"/>

                        <PasswordBox AutomationProperties.AutomationId="PasswordConfigurazione"
                             Margin="0,5,0,0"/>

                    </StackPanel>


                    <!-- CONFERMA -->
                    <StackPanel Grid.Column="2">

                        <TextBlock Text="CONFERMA PASSWORD"
                           Style="{StaticResource CampoPasswordLabel}"/>

                        <PasswordBox AutomationProperties.AutomationId="PasswordConfigurazioneConferma"
                             Margin="0,5,0,0"/>

                    </StackPanel>

                </Grid>


                <!-- ================================================= -->
                <!-- MESSAGGIO + AZIONE                                  -->
                <!-- ================================================= -->

                <Grid Grid.Row="3"
              Margin="0,18,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- MESSAGGIO -->
                    <Border Grid.Row="0"
                    Margin="0,0,0,14"
                    Padding="14,11"
                    Background="{StaticResource BrushDangerLight}"
                    BorderThickness="1"
                    BorderBrush="{StaticResource BrushDangerLight}"
                    CornerRadius="4"
                    Visibility="{Binding Messaggio,
                                         Converter={StaticResource BoolToVisibility}}">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icona -->
                            <iconPacks:PackIconBootstrapIcons
                        Grid.Column="1"
                        Kind="InfoCircle"
                        Width="14"
                        Height="14"
                        Foreground="{StaticResource BrushDanger}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"/>

                            <!-- Testo -->
                            <TextBlock Grid.Column="2"
                               Text="{Binding Messaggio}"
                               Style="{StaticResource MessaggioPassword}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="8,0,0,0"/>

                        </Grid>

                    </Border>


                    <!-- PULSANTE -->
                    <Button Grid.Row="1"
                    Command="{Binding ConfiguraCommand}"
                    HorizontalAlignment="Left"
                    ToolTip="Configura il modulo Password">

                        <Button.Style>
                            <Style TargetType="Button"
                           BasedOn="{StaticResource BtnPrimary}">
                                <Setter Property="Padding"
                                Value="14,7"/>
                            </Style>
                        </Button.Style>

                        <StackPanel Orientation="Horizontal">

                            <iconPacks:PackIconBootstrapIcons
                        Kind="ShieldLock"
                        Width="12"
                        Height="12"
                        VerticalAlignment="Center"
                        Margin="0,0,7,0"/>

                            <TextBlock Text="Configura modulo"
                               VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                </Grid>

            </Grid>

        </Border>

        <!-- ========================================================= -->
        <!-- SBLOCCO E RECUPERO                                         -->
        <!-- ========================================================= -->

        <Grid Grid.Row="3"
      Margin="28,28,28,0"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Top"
      Visibility="{Binding MostraSblocco, Converter={StaticResource BoolToVisibility}}">

            <Grid.ColumnDefinitions>
                <!-- Sblocco -->
                <ColumnDefinition Width="1.0*"/>

                <!-- Spazio centrale -->
                <ColumnDefinition Width="24"/>

                <!-- Recupero -->
                <ColumnDefinition Width="1.0*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <!-- Card -->
                <RowDefinition Height="Auto"/>

                <!-- Feedback -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- ========================================================= -->
            <!-- SBLOCCO                                                     -->
            <!-- ========================================================= -->

            <Border Grid.Row="0"
            Grid.Column="0"
            Style="{StaticResource CardPassword}"
            VerticalAlignment="Stretch">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- Titolo -->

                    <TextBlock Grid.Row="0"
                       Text="Sblocca il modulo"
                       Style="{StaticResource SectionTitleTextStyle}"/>


                    <!-- Descrizione -->

                    <TextBlock Grid.Row="1"
                       Text="Inserisci la password principale per accedere alle tue credenziali. Il modulo si blocca automaticamente dopo 15 minuti di inattività."
                       Style="{StaticResource SecondaryTextStyle}"
                       Margin="0,6,0,24"
                       TextWrapping="Wrap"/>


                    <!-- Campo -->

                    <Grid Grid.Row="2">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                           Text="PASSWORD PRINCIPALE"
                           Style="{StaticResource CampoPasswordLabel}"/>

                        <PasswordBox Grid.Row="1"
                             AutomationProperties.AutomationId="PasswordSblocco"
                             Height="36"
                             Margin="0,6,0,0"/>

                    </Grid>


                    <!-- Spazio elastico -->

                    <Border Grid.Row="3"
                    Background="Transparent"/>


                    <!-- Azione -->

                    <Button Grid.Row="4"
                    Command="{Binding SbloccaCommand}"
                            IsDefault="True"
                    HorizontalAlignment="Left"
                    Margin="0,24,0,0"
                    ToolTip="Sblocca il modulo">

                        <Button.Style>
                            <Style TargetType="Button"
                           BasedOn="{StaticResource BtnPrimary}">
                                <Setter Property="Padding"
                                Value="16,8"/>
                            </Style>
                        </Button.Style>

                        <StackPanel Orientation="Horizontal">

                            <iconPacks:PackIconBootstrapIcons
                        Kind="Unlock"
                        Width="13"
                        Height="13"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"/>

                            <TextBlock Text="Sblocca"
                               VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                </Grid>

            </Border>

            <!-- ========================================================= -->
            <!-- RECUPERO PASSWORD                                           -->
            <!-- ========================================================= -->

            <Border Grid.Row="0"
            Grid.Column="2"
            Style="{StaticResource CardPassword}"
            VerticalAlignment="Stretch">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- Titolo -->

                    <TextBlock Grid.Row="0"
                       Text="Password dimenticata?"
                       Style="{StaticResource SectionTitleTextStyle}"/>


                    <!-- Descrizione -->

                    <TextBlock Grid.Row="1"
                       Text="Con il codice di recupero puoi impostare una nuova password principale. Le credenziali salvate resteranno invariate."
                       Style="{StaticResource SecondaryTextStyle}"
                       Margin="0,6,0,24"
                       TextWrapping="Wrap"/>


                    <!-- Codice di recupero -->

                    <Grid Grid.Row="2">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                           Text="CODICE DI RECUPERO"
                           Style="{StaticResource CampoPasswordLabel}"/>

                        <TextBox Grid.Row="1"
                         AutomationProperties.AutomationId="TextBoxRecovery"
                         Height="36"
                         Margin="0,6,0,0"
                         ToolTip="Formato XXXX-XXXX-XXXX-XXXX"/>

                    </Grid>


                    <!-- Password + conferma -->

                    <Grid Grid.Row="3"
                  Margin="0,20,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <!-- Nuova password -->

                        <Grid Grid.Column="0">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                               Text="NUOVA PASSWORD"
                               Style="{StaticResource CampoPasswordLabel}"/>

                            <PasswordBox Grid.Row="1"
                                 AutomationProperties.AutomationId="PasswordNuovaMaster"
                                 Height="36"
                                 Margin="0,6,0,0"/>

                        </Grid>


                        <!-- Conferma -->

                        <Grid Grid.Column="2">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                               Text="CONFERMA PASSWORD"
                               Style="{StaticResource CampoPasswordLabel}"/>

                            <PasswordBox Grid.Row="1"
                                 AutomationProperties.AutomationId="PasswordNuovaConferma"
                                 Height="36"
                                 Margin="0,6,0,0"/>

                        </Grid>

                    </Grid>


                    <!-- Spazio elastico -->

                    <Border Grid.Row="4"
                    Background="Transparent"/>


                    <!-- Azione -->

                    <Button Grid.Row="5"
                    Command="{Binding RecuperaCommand}"
                    HorizontalAlignment="Left"
                    Margin="0,24,0,0"
                    ToolTip="Reimposta la password principale">

                        <Button.Style>
                            <Style TargetType="Button"
                           BasedOn="{StaticResource BtnOutline}">
                                <Setter Property="Padding"
                                Value="16,8"/>
                            </Style>
                        </Button.Style>

                        <StackPanel Orientation="Horizontal">

                            <iconPacks:PackIconBootstrapIcons
                        Kind="ArrowCounterclockwise"
                        Width="13"
                        Height="13"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"/>

                            <TextBlock Text="Reimposta password principale"
                               VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                </Grid>

            </Border>


            <!-- ========================================================= -->
            <!-- FEEDBACK                                                    -->
            <!-- ========================================================= -->

            <Border Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="0,16,0,0"
            Padding="14,11"
            Background="{StaticResource BrushDangerLight}"
            BorderThickness="1"
            CornerRadius="4"
            Visibility="{Binding Messaggio, Converter={StaticResource BoolToVisibility}}">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icona -->

                    <iconPacks:PackIconBootstrapIcons
                Grid.Column="1"
                Kind="InfoCircle"
                Width="14"
                Height="14"
                Foreground="{StaticResource BrushDanger}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"/>


                    <!-- Messaggio -->

                    <TextBlock Grid.Column="2"
                       Text="{Binding Messaggio}"
                       Style="{StaticResource MessaggioPassword}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="8,0,0,0"/>

                </Grid>

            </Border>

        </Grid>

        <!-- ========================================================= -->
        <!-- RICERCA                                                    -->
        <!-- ========================================================= -->

        <!-- Contatore (totale reale delle password salvate) a sinistra,
             ricerca compatta a destra: stesso schema di Studi/Attività. -->
        <Grid Grid.Row="1"
              Margin="28,0,28,0"
              Visibility="{Binding MostraElenco, Converter={StaticResource BoolToVisibility}}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="{Binding TotaleVoci, StringFormat={}{0} password}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource BrushTestoSecondario}"/>

                <!-- Esito delle azioni inline (copia / mostra) -->
                <TextBlock Text="{Binding FeedbackLista}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource BrushTestoSecondario}"
                           Margin="16,0,0,0"
                           Visibility="{Binding FeedbackLista, Converter={StaticResource BoolToVisibility}}"/>

            </StackPanel>

            <Border Grid.Column="0"
                    Width="250"
                    Height="32"
                    Background="White"
                    BorderBrush="{StaticResource BrushBordo}"
                    BorderThickness="1"
                    HorizontalAlignment="Left"
                    CornerRadius="6">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <iconPacks:PackIconBootstrapIcons
                        Grid.Column="0"
                        Kind="Search"
                        Width="13"
                        Height="13"
                        Foreground="{StaticResource BrushTestoSecondario}"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"/>

                    <TextBox Grid.Column="1"
                             Text="{Binding FiltroTesto, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="12"
                             Foreground="{StaticResource BrushTestoPrimario}"
                             VerticalContentAlignment="Center"
                             mah:TextBoxHelper.Watermark="  Cerca password…"
                             ToolTip="Cerca per nome, sito, username o note"/>

                    <Button Grid.Column="2"
                            Style="{StaticResource AzionePassword}"
                            Width="22"
                            Height="22"
                            Margin="0,0,4,0"
                            Command="{Binding CancellaRicercaCommand}"
                            ToolTip="Cancella ricerca"
                            Visibility="{Binding FiltroTesto, Converter={StaticResource BoolToVisibility}}">
                        <iconPacks:PackIconBootstrapIcons Kind="XLg"
                                                          Width="10"
                                                          Height="10"
                                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>

                </Grid>

            </Border>

        </Grid>

        <!-- ========================================================= -->
        <!-- LISTA                                                      -->
        <!-- ========================================================= -->

        <Grid Grid.Row="3"
              Margin="28,16,28,24"
              Visibility="{Binding MostraElenco, Converter={StaticResource BoolToVisibility}}">

            <!-- Empty state: messaggio contestuale (archivio vuoto / nessun risultato),
                 stesso schema di Fatture e Studi. -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding Voci.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                <TextBlock Text="{Binding EmptyStateTesto}"
                           FontSize="14"
                           Foreground="{StaticResource BrushTestoSecondario}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- DataGrid -->

            <DataGrid x:Name="VociDataGrid"
                      ItemsSource="{Binding Voci}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      IsReadOnly="True"
                      Style="{StaticResource ModuleDataGridStyle}"
                      AlternationCount="2"
                      RowHeight="44"
                      HeadersVisibility="Column"
                      MouseDoubleClick="VociDataGrid_MouseDoubleClick">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader"
                           BasedOn="{StaticResource PasswordColumnHeaderStyle}"/>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow"
                           BasedOn="{StaticResource ModuleDataGridRowClickableSelectedStyle}"/>
                </DataGrid.RowStyle>

                <DataGrid.Columns>

                    <DataGridTextColumn Header="NOME"
                                        Binding="{Binding Nome}"
                                        Width="1.5*"
                                        ElementStyle="{StaticResource PasswordCellaPrimaria}"/>

                    <DataGridTextColumn Header="SITO"
                                        Binding="{Binding Sito}"
                                        Width="1.5*"
                                        ElementStyle="{StaticResource PasswordCellaSecondaria}"/>

                    <!-- USERNAME + copia inline -->
                    <DataGridTemplateColumn Header="USERNAME" Width="1.7*" SortMemberPath="Username">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="{Binding Username}"
                                               Style="{StaticResource PasswordCellaSecondaria}"/>
                                    <Button Style="{StaticResource AzionePassword}"
                                            Grid.Column="0" Margin="10,0,0,0"
                                            Command="{Binding DataContext.CopiaUsernameRigaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="Copia username">
                                        <iconPacks:PackIconBootstrapIcons Kind="Copy" Width="13" Height="13"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- PASSWORD: maschera + mostra/nascondi + copia inline.
                         Il valore in chiaro non sta nella lista: viene decifrato
                         solo all'azione. -->
                    <DataGridTemplateColumn Header="PASSWORD" Width="1.7*" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="2" Text="{Binding PasswordDisplay}"
                                               Style="{StaticResource PasswordCellaSecondaria}"/>
                                    <Button Grid.Column="0" Margin="10,0,0,0" Style="{StaticResource AzionePassword}"
                                            Command="{Binding DataContext.MostraPasswordRigaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="Mostra / nascondi password">
                                        <iconPacks:PackIconBootstrapIcons Width="13" Height="13"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                            <iconPacks:PackIconBootstrapIcons.Style>
                                                <Style TargetType="iconPacks:PackIconBootstrapIcons">
                                                    <Setter Property="Kind" Value="Eye"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PasswordMostrata}" Value="True">
                                                            <Setter Property="Kind" Value="EyeSlash"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </iconPacks:PackIconBootstrapIcons.Style>
                                        </iconPacks:PackIconBootstrapIcons>
                                    </Button>
                                    <Button Style="{StaticResource AzionePassword}"
                                            Grid.Column="1" Margin="2,0,6,0"
                                            Command="{Binding DataContext.CopiaPasswordRigaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="Copia password">
                                        <iconPacks:PackIconBootstrapIcons Kind="Copy" Width="13" Height="13"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="AGGIORNATA"
                                        Binding="{Binding AggiornataDisplay}"
                                        SortMemberPath="UpdatedAt"
                                        Width="1*"
                                        ElementStyle="{StaticResource PasswordCellaSecondaria}"/>

                    <DataGridTemplateColumn Header="" Width="72" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource AzionePassword}"
                                            Command="{Binding DataContext.ModificaVoceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="Modifica">
                                        <iconPacks:PackIconBootstrapIcons Kind="Pencil" Width="13" Height="13"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                                    <Button Style="{StaticResource AzionePasswordElimina}"
                                            Margin="2,0,5,0"
                                            Command="{Binding DataContext.EliminaVoceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="Elimina">
                                        <iconPacks:PackIconBootstrapIcons Kind="Trash" Width="13" Height="13"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Grid>

        <!-- ========================================================= -->
        <!-- MODAL NUOVA / MODIFICA                                    -->
        <!-- ========================================================= -->

        <views:ModalDialogControl
    Grid.Row="0"
    Grid.RowSpan="5"
            LarghezzaExtra="500"
    IsAperto="{Binding PannelloAperto}"
    Titolo="{Binding TitoloPannello}"
    ComandoChiudi="{Binding AnnullaCommand}"
    ComandoSalva="{Binding SalvaCommand}"
    HaModificheNonSalvate="{Binding HaModifiche}">

            <views:ModalDialogControl.Contenuto>

                <StackPanel>

                    <!-- ================================================= -->
                    <!-- DATI PRINCIPALI                                  -->
                    <!-- ================================================= -->

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- NOME -->
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="NOME"
                               Style="{StaticResource FieldLabel}"/>

                            <TextBox Text="{Binding FormNome,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,5,0,0"/>
                        </StackPanel>

                        <!-- SITO -->
                        <StackPanel Grid.Row="1"
                            Margin="0,14,0,0">
                            <TextBlock Text="SITO"
                               Style="{StaticResource FieldLabel}"/>

                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                 Text="{Binding FormSito,
                                                UpdateSourceTrigger=PropertyChanged}"/>

                                <Button Grid.Column="1"
                                Style="{StaticResource BottoneIconaCampo}"
                                Command="{Binding CopiaCampoCommand}"
                                CommandParameter="sito"
                                ToolTip="Copia sito"
                                Margin="8,0,0,0">
                                    <iconPacks:PackIconBootstrapIcons
                                Kind="Copy"
                                Width="14"
                                Height="14"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- USERNAME -->
                        <StackPanel Grid.Row="2"
                            Margin="0,14,0,0">

                            <TextBlock Text="USERNAME"
                               Style="{StaticResource FieldLabel}"/>

                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                 Text="{Binding FormUsername,
                                                UpdateSourceTrigger=PropertyChanged}"/>

                                <Button Grid.Column="1"
                                Style="{StaticResource BottoneIconaCampo}"
                                Command="{Binding CopiaCampoCommand}"
                                CommandParameter="username"
                                ToolTip="Copia username"
                                Margin="8,0,0,0">
                                    <iconPacks:PackIconBootstrapIcons
                                Kind="Copy"
                                Width="14"
                                Height="14"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- PASSWORD -->
                        <StackPanel Grid.Row="3"
                            Grid.Column="2"
                            Margin="0,14,0,0">

                            <TextBlock Text="PASSWORD"
                               Style="{StaticResource FieldLabel}"/>

                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Password mascherata -->
                                <PasswordBox Grid.Column="0"
                                     AutomationProperties.AutomationId="PasswordForm"
                                     PasswordChanged="PwForm_PasswordChanged"
                                     Visibility="{Binding PasswordFormVisibile,
                                                          Converter={StaticResource BoolToVisibility},
                                                          ConverterParameter=Inverti}"/>

                                <!-- Password in chiaro -->
                                <TextBox Grid.Column="0"
                                 AutomationProperties.AutomationId="PasswordFormChiara"
                                 Visibility="{Binding PasswordFormVisibile,
                                                      Converter={StaticResource BoolToVisibility}}"
                                 TextChanged="TxtFormChiara_TextChanged"
                                 VerticalContentAlignment="Center"/>

                                <!-- Mostra / nascondi -->
                                <Button Grid.Column="1"
                                Style="{StaticResource BottoneIconaCampo}"
                                Command="{Binding TogglePasswordCommand}"
                                ToolTip="{Binding EtichettaTogglePassword}"
                                Margin="8,0,0,0">

                                    <iconPacks:PackIconBootstrapIcons
                                Width="14"
                                Height="14">

                                        <iconPacks:PackIconBootstrapIcons.Style>
                                            <Style TargetType="iconPacks:PackIconBootstrapIcons">

                                                <Setter Property="Kind"
                                                Value="Eye"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PasswordFormVisibile}"
                                                         Value="True">
                                                        <Setter Property="Kind"
                                                        Value="EyeSlash"/>
                                                    </DataTrigger>
                                                </Style.Triggers>

                                            </Style>
                                        </iconPacks:PackIconBootstrapIcons.Style>

                                    </iconPacks:PackIconBootstrapIcons>
                                </Button>

                                <!-- Copia -->
                                <Button Grid.Column="2"
                                Style="{StaticResource BottoneIconaCampo}"
                                Command="{Binding CopiaCampoCommand}"
                                CommandParameter="password"
                                ToolTip="Copia password"
                                Margin="4,0,0,0">

                                    <iconPacks:PackIconBootstrapIcons
                                Kind="Copy"
                                Width="14"
                                Height="14"/>
                                </Button>

                            </Grid>
                        </StackPanel>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- FEEDBACK COPIA                                   -->
                    <!-- ================================================= -->

                    <TextBlock Text="{Binding FeedbackCopia}"
                       Style="{StaticResource FeedbackPassword}"
                       Margin="0,5,0,0"
                       Visibility="{Binding FeedbackCopia,
                                            Converter={StaticResource BoolToVisibility}}"/>


                    <!-- ================================================= -->
                    <!-- GENERATORE                                        -->
                    <!-- ================================================= -->

                    <Border BorderBrush="{StaticResource BrushBordoLeggero}"
                    BorderThickness="0,1,0,0"
                    Margin="0,20,0,0"
                    Padding="0,10,0,0">

                        <StackPanel>

                            <!-- HEADER GENERATORE -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">

                                    <TextBlock Text="Genera password"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource BrushTestoPrimario}"/>

                                    <TextBlock Text="Crea una password casuale sicura e usala nel campo Password."
                                       FontSize="11"
                                       Foreground="{StaticResource BrushTestoSecondario}"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                Command="{Binding GeneraCommand}"
                                ToolTip="Genera password"
                                VerticalAlignment="Center">

                                    <Button.Style>
                                        <Style TargetType="Button"
                                       BasedOn="{StaticResource BtnOutline}">
                                            <Setter Property="Padding"
                                            Value="12,6"/>
                                        </Style>
                                    </Button.Style>

                                    <StackPanel Orientation="Horizontal">

                                        <iconPacks:PackIconBootstrapIcons
                                    Kind="ArrowRepeat"
                                    Width="12"
                                    Height="12"
                                    VerticalAlignment="Center"
                                    Margin="0,0,6,0"/>

                                        <TextBlock Text="Genera"
                                           VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Button>
                            </Grid>


                            <!-- LUNGHEZZA -->
                            <TextBlock Text="{Binding LunghezzaTesto}"
                               FontSize="11"
                               Foreground="{StaticResource BrushTestoSecondario}"
                               Margin="0,18,0,0"/>

                            <Slider Minimum="8"
                            Maximum="64"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding Lunghezza}"
                            Margin="0,3,0,0"
                            ToolTip="Lunghezza della password (da 8 a 64 caratteri)"/>


                            <!-- CARATTERI -->
                            <TextBlock Text="CARATTERI UTILIZZATI"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,17,0,7"/>

                            <WrapPanel Orientation="Horizontal">

                                <StackPanel Orientation="Horizontal"
                                    Margin="0,0,24,0">

                                    <CheckBox Style="{StaticResource ModuleCheckBoxStyle}"
                                      IsChecked="{Binding UsaMaiuscole}"
                                      VerticalAlignment="Center"/>

                                    <TextBlock Text="Maiuscole"
                                       Margin="8,0,0,0"
                                       Foreground="{StaticResource BrushTestoPrimario}"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                    Margin="0,0,24,0">

                                    <CheckBox Style="{StaticResource ModuleCheckBoxStyle}"
                                      IsChecked="{Binding UsaMinuscole}"
                                      VerticalAlignment="Center"/>

                                    <TextBlock Text="Minuscole"
                                       Margin="8,0,0,0"
                                       Foreground="{StaticResource BrushTestoPrimario}"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                    Margin="0,0,24,0">

                                    <CheckBox Style="{StaticResource ModuleCheckBoxStyle}"
                                      IsChecked="{Binding UsaNumeri}"
                                      VerticalAlignment="Center"/>

                                    <TextBlock Text="Numeri"
                                       Margin="8,0,0,0"
                                       Foreground="{StaticResource BrushTestoPrimario}"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">

                                    <CheckBox Style="{StaticResource ModuleCheckBoxStyle}"
                                      IsChecked="{Binding UsaSimboli}"
                                      VerticalAlignment="Center"/>

                                    <TextBlock Text="Simboli"
                                       Margin="8,0,0,0"
                                       Foreground="{StaticResource BrushTestoPrimario}"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                                </StackPanel>

                            </WrapPanel>


                            <!-- PASSWORD GENERATA -->
                            <TextBlock Text="PASSWORD GENERATA"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,20,0,0"/>

                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <PasswordBox Grid.Column="0"
                                     AutomationProperties.AutomationId="PasswordGenerata"/>

                                <Button Grid.Column="1"
                                Style="{StaticResource BottoneIconaCampo}"
                                Command="{Binding UsaGenerataCommand}"
                                ToolTip="Usa password generata"
                                Margin="8,0,0,0">

                                    <iconPacks:PackIconBootstrapIcons
                                Kind="Check2"
                                Width="14"
                                Height="14"/>
                                </Button>

                                <Button Grid.Column="2"
                                Style="{StaticResource BottoneIconaCampo}"
                                Command="{Binding CopiaGenerataCommand}"
                                ToolTip="Copia password generata"
                                Margin="4,0,0,0">

                                    <iconPacks:PackIconBootstrapIcons
                                Kind="Copy"
                                Width="14"
                                Height="14"/>
                                </Button>
                            </Grid>


                            <!-- FEEDBACK GENERATORE -->
                            <TextBlock Text="{Binding FeedbackGeneratore}"
                               Style="{StaticResource FeedbackPassword}"
                               Margin="0,8,0,0"
                               Visibility="{Binding FeedbackGeneratore,
                                                    Converter={StaticResource BoolToVisibility}}"/>

                            <TextBlock Text="{Binding FeedbackClipboard}"
                               Style="{StaticResource FeedbackPassword}"
                               Margin="0,3,0,0"
                               Visibility="{Binding FeedbackClipboard,
                                                    Converter={StaticResource BoolToVisibility}}"/>

                        </StackPanel>

                    </Border>


                    <!-- ================================================= -->
                    <!-- NOTE                                               -->
                    <!-- ================================================= -->

                    <!--<Border BorderBrush="{StaticResource BrushBordoLeggero}"
                    BorderThickness="0,1,0,0"
                    Margin="0,24,0,0"
                    Padding="0,18,0,0">

                        <StackPanel>

                            <TextBlock Text="NOTE (FACOLTATIVE)"
                               Style="{StaticResource FieldLabel}"/>

                            <TextBox Text="{Binding FormNote,
                                            UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="80"
                             VerticalContentAlignment="Top"
                             Margin="0,5,0,0"/>

                        </StackPanel>

                    </Border>-->


                    <!-- ================================================= -->
                    <!-- ERRORE FORM                                       -->
                    <!-- ================================================= -->

                    <Border Margin="0,16,0,0"
                    Padding="12,10"
                    Background="{StaticResource BrushDangerLight}"
                    BorderBrush="{StaticResource BrushDangerLight}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding VoceFeedback,
                                         Converter={StaticResource BoolToVisibility}}">

                        <TextBlock Text="{Binding VoceFeedback}"
                           Style="{StaticResource MessaggioPassword}"
                           TextWrapping="Wrap"/>
                    </Border>

                </StackPanel>

            </views:ModalDialogControl.Contenuto>

        </views:ModalDialogControl>

        <!-- ========================================================= -->
        <!-- CODICE DI RECUPERO: MOSTRATO UNA SOLA VOLTA                -->
        <!-- ========================================================= -->

        <Grid Grid.Row="0"
              Grid.RowSpan="5"
              Visibility="{Binding MostraRecoveryCode, Converter={StaticResource BoolToVisibility}}">

            <Border Style="{StaticResource OverlayScuroStyle}"/>

            <Border Background="White"
                    BorderBrush="{StaticResource BrushBordoLeggero}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLarge}"
                    Effect="{StaticResource PanelShadowEffect}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="520"
                    Padding="26">

                <StackPanel>

                    <TextBlock Text="Codice di recupero"
                               Style="{StaticResource SectionTitleTextStyle}"/>

                    <TextBlock Text="Conserva questo codice in un posto sicuro: viene mostrato una sola volta e serve a reimpostare la password principale se la dimentichi. Non è recuperabile in alcun modo."
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,8,0,16"/>

                    <Border Background="{StaticResource BrushSfondoFine}"
                            BorderBrush="{StaticResource BrushBordoLeggero}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSmall}"
                            Padding="14">

                        <TextBox Text="{Binding RecoveryCodeMonouso, Mode=OneWay}"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="18"
                                 FontFamily="{StaticResource FontFamilyNumeric}"
                                 HorizontalAlignment="Center"/>

                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">

                        <Button Command="{Binding CopiaRecoveryCodeCommand}"
                                Style="{StaticResource BtnOutline}"
                                Content="Copia codice"/>

                        <Button Command="{Binding ChiudiRecoveryCodeCommand}"
                                Style="{StaticResource BtnPrimary}"
                                Content="Ho salvato il codice"
                                Margin="10,0,0,0"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>