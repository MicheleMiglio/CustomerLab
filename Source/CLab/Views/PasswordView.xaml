<UserControl x:Class="CLab.Views.PasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:views="clr-namespace:CLab.Views">

    <UserControl.Resources>

        <!-- ========================================================= -->
        <!-- AZIONI GRIGLIA                                            -->
        <!-- ========================================================= -->

        <Style x:Key="AzionePassword" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                        Value="{StaticResource BrushHoverNeutro}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource BrushTestoPrimario}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AzionePasswordElimina"
               TargetType="Button"
               BasedOn="{StaticResource AzionePassword}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground"
                            Value="{StaticResource BrushStatoCessato}"/>
                    <Setter Property="Background"
                            Value="{StaticResource BrushHoverNeutro}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ========================================================= -->
        <!-- CAMPI PASSWORD                                            -->
        <!-- ========================================================= -->

        <Style x:Key="CampoPasswordCopia"
               TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="CampoPasswordLabel"
               TargetType="TextBlock"
               BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="BottoneIconaCampo"
               TargetType="Button"
               BasedOn="{StaticResource BtnIconGhost}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- HEADER                                                     -->
        <!-- ========================================================= -->

        <Border Grid.Row="0"
                Style="{StaticResource ModuleHeaderBorderStyle}"
                Padding="28,0">

            <Grid VerticalAlignment="Center">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Password"
                           Style="{StaticResource ModuleTitleStyle}"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Command="{Binding AggiungiCommand}"
                        ToolTip="Aggiungi password">

                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource BtnPrimary}">
                            <Setter Property="Padding" Value="14,7"/>
                        </Style>
                    </Button.Style>

                    <StackPanel Orientation="Horizontal">

                        <iconPacks:PackIconBootstrapIcons
                            Kind="Plus"
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            Margin="0,0,7,0"/>

                        <TextBlock Text="Aggiungi password"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

            </Grid>

        </Border>

        <!-- ========================================================= -->
        <!-- RICERCA                                                    -->
        <!-- ========================================================= -->

        <Border Grid.Row="1"
                Margin="28,16,28,0">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Height="36"
                        MaxWidth="520"
                        HorizontalAlignment="Left"
                        Background="White"
                        BorderBrush="{StaticResource BrushBordoLeggero}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusSmall}">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <iconPacks:PackIconBootstrapIcons
                            Grid.Column="0"
                            Kind="Search"
                            Width="14"
                            Height="14"
                            Foreground="{StaticResource BrushTestoTerziario}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding FiltroTesto, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 Padding="0,0,10,0"
                                 ToolTip="Cerca per nome, sito, username o note"/>

                    </Grid>

                </Border>

                <TextBlock Grid.Column="1"
                           Text="{Binding Voci.Count, StringFormat={}{0} password}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BrushTestoTerziario}"
                           FontSize="12"
                           Margin="16,0,0,0"/>

            </Grid>

        </Border>

        <!-- ========================================================= -->
        <!-- LISTA                                                      -->
        <!-- ========================================================= -->

        <Grid Grid.Row="2"
              Margin="28,16,28,24">

            <!-- Empty state -->

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Voci.Count}"
                                         Value="0">
                                <Setter Property="Visibility"
                                        Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <iconPacks:PackIconBootstrapIcons
                    Kind="Key"
                    Width="30"
                    Height="30"
                    Foreground="{StaticResource BrushTestoTerziario}"
                    HorizontalAlignment="Center"/>

                <TextBlock Text="Nessuna password"
                           Style="{StaticResource SectionTitleTextStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>

                <TextBlock Text="Le credenziali salvate appariranno qui."
                           Style="{StaticResource SecondaryTextStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>

                <Button Command="{Binding AggiungiCommand}"
                        HorizontalAlignment="Center"
                        Margin="0,16,0,0"
                        ToolTip="Aggiungi password">

                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource BtnPrimary}">
                            <Setter Property="Padding" Value="14,7"/>
                        </Style>
                    </Button.Style>

                    <StackPanel Orientation="Horizontal">

                        <iconPacks:PackIconBootstrapIcons
                            Kind="Plus"
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            Margin="0,0,7,0"/>

                        <TextBlock Text="Aggiungi password"/>

                    </StackPanel>

                </Button>

            </StackPanel>

            <!-- DataGrid -->

            <DataGrid ItemsSource="{Binding Voci}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      IsReadOnly="True"
                      Style="{StaticResource ModuleDataGridStyle}"
                      HeadersVisibility="Column">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Nome"
                                        Binding="{Binding Nome}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="Sito"
                                        Binding="{Binding Sito}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="Username"
                                        Binding="{Binding Username}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="Aggiornata"
                                        Binding="{Binding AggiornataDisplay}"
                                        Width="150"/>

                    <!-- PASSWORD NON PRESENTE NELLA LISTA -->

                    <DataGridTemplateColumn Header=""
                                            Width="100">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">

                                    <Button Style="{StaticResource AzionePassword}"
                                            Command="{Binding DataContext.ModificaVoceCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Modifica">

                                        <iconPacks:PackIconBootstrapIcons
                                            Kind="Pencil"
                                            Width="13"
                                            Height="13"/>

                                    </Button>

                                    <Button Style="{StaticResource AzionePasswordElimina}"
                                            Command="{Binding DataContext.EliminaVoceCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Elimina"
                                            Margin="4,0,0,0">

                                        <iconPacks:PackIconBootstrapIcons
                                            Kind="Trash"
                                            Width="13"
                                            Height="13"/>

                                    </Button>

                                </StackPanel>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Grid>

        <!-- ========================================================= -->
        <!-- MODAL NUOVA / MODIFICA                                    -->
        <!-- ========================================================= -->

        <views:ModalDialogControl
            Grid.Row="0"
            Grid.RowSpan="3"
            IsAperto="{Binding PannelloAperto}"
            Titolo="{Binding TitoloPannello}"
            ComandoChiudi="{Binding AnnullaCommand}"
            ComandoSalva="{Binding SalvaCommand}"
            HaModificheNonSalvate="{Binding HaModifiche}">

            <views:ModalDialogControl.Contenuto>

                <StackPanel>

                    <!-- NOME -->

                    <TextBlock Text="Nome"
                               Style="{StaticResource CampoPasswordLabel}"/>

                    <TextBox Text="{Binding FormNome,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16"/>

                    <!-- SITO -->

                    <TextBlock Text="Sito"
                               Style="{StaticResource CampoPasswordLabel}"/>

                    <Grid Margin="0,0,0,16">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding FormSito,
                                                UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Grid.Column="1"
                                Style="{StaticResource BottoneIconaCampo}"
                                Command="{Binding CopiaCampoCommand}"
                                CommandParameter="sito"
                                ToolTip="Copia sito"
                                Margin="8,0,0,0">

                            <iconPacks:PackIconBootstrapIcons
                                Kind="Copy"
                                Width="14"
                                Height="14"/>

                        </Button>

                    </Grid>

                    <!-- USERNAME -->

                    <TextBlock Text="Username"
                               Style="{StaticResource CampoPasswordLabel}"/>

                    <Grid Margin="0,0,0,16">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding FormUsername,
                                                UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Grid.Column="1"
                                Style="{StaticResource BottoneIconaCampo}"
                                Command="{Binding CopiaCampoCommand}"
                                CommandParameter="username"
                                ToolTip="Copia username"
                                Margin="8,0,0,0">

                            <iconPacks:PackIconBootstrapIcons
                                Kind="Copy"
                                Width="14"
                                Height="14"/>

                        </Button>

                    </Grid>

                    <!-- PASSWORD -->

                    <TextBlock Text="Password"
                               Style="{StaticResource CampoPasswordLabel}"/>

                    <Grid Margin="0,0,0,8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- PasswordBox mascherata -->

                        <PasswordBox
                                     Grid.Column="0"
                                     PasswordChanged="PwForm_PasswordChanged"/>

                        <!-- Campo in chiaro -->

                        <TextBox
                                 Grid.Column="0"
                                 Visibility="Collapsed"
                                 VerticalContentAlignment="Center"/>

                        <!-- Mostra / nascondi -->

                        <Button Grid.Column="1"
                                Style="{StaticResource BottoneIconaCampo}"
                                Command="{Binding TogglePasswordCommand}"
                                ToolTip="Mostra o nascondi password"
                                Margin="8,0,0,0">

                            <iconPacks:PackIconBootstrapIcons
                                Kind="Eye"
                                Width="14"
                                Height="14"/>

                        </Button>

                        <!-- Copia -->

                        <Button Grid.Column="2"
                                Style="{StaticResource BottoneIconaCampo}"
                                Command="{Binding CopiaCampoCommand}"
                                CommandParameter="password"
                                ToolTip="Copia password"
                                Margin="4,0,0,0">

                            <iconPacks:PackIconBootstrapIcons
                                Kind="Copy"
                                Width="14"
                                Height="14"/>

                        </Button>

                    </Grid>

                    <!-- GENERATORE -->

                    <Border Background="{StaticResource BrushSidebarHover}"
                            BorderBrush="{StaticResource BrushBordoLeggero}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSmall}"
                            Padding="12"
                            Margin="0,0,0,16">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="0">

                                <TextBlock Text="Genera password"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource BrushTestoPrimario}"/>

                                <TextBlock Text="Genera una password casuale sicura."
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTestoSecondario}"
                                           Margin="0,3,0,0"/>

                            </StackPanel>

                            <Button Grid.Row="0"
                                    Grid.Column="1"
                                    Command="{Binding GeneraCommand}"
                                    ToolTip="Genera password">

                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource BtnOutline}">
                                        <Setter Property="Padding" Value="12,6"/>
                                    </Style>
                                </Button.Style>

                                <StackPanel Orientation="Horizontal">

                                    <iconPacks:PackIconBootstrapIcons
                                        Kind="ArrowRepeat"
                                        Width="12"
                                        Height="12"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0"/>

                                    <TextBlock Text="Genera"/>

                                </StackPanel>

                            </Button>

                            <Grid Grid.Row="1"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="2"
                                  Margin="0,12,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <PasswordBox
                                             Grid.Column="0"/>

                                <Button Grid.Column="1"
                                        Style="{StaticResource BottoneIconaCampo}"
                                        Command="{Binding UsaGenerataCommand}"
                                        ToolTip="Usa password generata"
                                        Margin="8,0,0,0">

                                    <iconPacks:PackIconBootstrapIcons
                                        Kind="Check2"
                                        Width="14"
                                        Height="14"/>

                                </Button>

                                <Button Grid.Column="2"
                                        Style="{StaticResource BottoneIconaCampo}"
                                        Command="{Binding CopiaGenerataCommand}"
                                        ToolTip="Copia password generata"
                                        Margin="4,0,0,0">

                                    <iconPacks:PackIconBootstrapIcons
                                        Kind="Copy"
                                        Width="14"
                                        Height="14"/>

                                </Button>

                            </Grid>

                        </Grid>

                    </Border>

                    <!-- NOTE -->

                    <TextBlock Text="Note"
                               Style="{StaticResource CampoPasswordLabel}"/>

                    <TextBox Text="{Binding FormNote,
                                            UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             Height="90"/>

                </StackPanel>

            </views:ModalDialogControl.Contenuto>

        </views:ModalDialogControl>

    </Grid>

</UserControl>