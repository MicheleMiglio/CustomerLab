<UserControl x:Class="CLab.Views.PromemoriaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:conv="clr-namespace:CLab.Converters"
             xmlns:models="clr-namespace:CLab.Models"
             xmlns:views="clr-namespace:CLab.Views">

    <!-- ============================================================ -->
    <!-- PROMEMORIA: bacheca con tre colonne fisse (ALTA|MEDIA|BASSA) -->
    <!-- e post-it compatti. Comandi e binding del ViewModel invariati -->
    <!-- tranne l'ordinamento, rimosso.                                -->
    <!-- ============================================================ -->

    <UserControl.Resources>
        <conv:StatoSemanticoForeConverter x:Key="PrioritaAColore"/>

        <!-- Post-it: bianco, bordo sottile, lieve rilievo -->
        <Style x:Key="PostIt" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBordoLeggero}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270"
                                      Opacity="0.07" Color="#0A1628"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitoloPostIt" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="DescrizionePostIt" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="MaxHeight" Value="54"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="DataPostIt" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTestoTerziario}"/>
        </Style>

        <!-- Azioni 30x30 sempre visibili, ghost con hover neutro -->
        <Style x:Key="AzionePostIt" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushHoverNeutro}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AzionePostItElimina" TargetType="Button" BasedOn="{StaticResource AzionePostIt}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrushStatoCessato}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Colonna -->
        <Style x:Key="ColonnaBacheca" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBordo}"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="TitoloColonna" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DotColonna" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Pillola del conteggio -->
        <Style x:Key="BadgeConteggio" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBordoLeggero}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ConteggioColonna" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
        </Style>

        <!-- Segmented control priorità nel form (invariato) -->
        <Style x:Key="SegmentContainer" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBordoLeggero}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <Style x:Key="SegmentButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushHoverNeutro}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentFormBassa" TargetType="Button" BasedOn="{StaticResource SegmentButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FormPriorita}" Value="Bassa">
                    <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                    <Setter Property="Foreground" Value="{Binding FormPriorita, Converter={StaticResource PrioritaAColore}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SegmentFormMedia" TargetType="Button" BasedOn="{StaticResource SegmentButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FormPriorita}" Value="Media">
                    <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                    <Setter Property="Foreground" Value="{Binding FormPriorita, Converter={StaticResource PrioritaAColore}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SegmentFormAlta" TargetType="Button" BasedOn="{StaticResource SegmentButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FormPriorita}" Value="Alta">
                    <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                    <Setter Property="Foreground" Value="{Binding FormPriorita, Converter={StaticResource PrioritaAColore}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Template del post-it, condiviso dalle tre colonne.
             Il Border "PostIt" è il primo antenato dei bottoni: serve
             al fade-out del code-behind (BtnElimina_Click). -->
        <DataTemplate x:Key="PostItTemplate">
            <Border Style="{StaticResource PostIt}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Accento verticale di priorità -->
                    <Border Grid.Column="0" CornerRadius="5,0,0,5"
                            Background="{Binding Priorita, Converter={StaticResource PrioritaAColore}}"/>

                    <StackPanel Grid.Column="1" Margin="14,12,8,6">

                        <TextBlock Text="{Binding Titolo}" Style="{StaticResource TitoloPostIt}"
                                   Margin="0,0,4,0"/>

                        <TextBlock Text="{Binding Descrizione}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DescrizionePostIt}">
                                    <Setter Property="Margin" Value="0,4,4,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Descrizione}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Descrizione}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Footer: data a sinistra, azioni a destra -->
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="{Binding DataCreazione, StringFormat='{}{0:d MMM yyyy}'}"
                                       Style="{StaticResource DataPostIt}"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource AzionePostIt}"
                                        Command="{Binding DataContext.ModificaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" ToolTip="Modifica">
                                    <iconPacks:PackIconBootstrapIcons Kind="Pencil" Width="13" Height="13"/>
                                </Button>
                                <Button Style="{StaticResource AzionePostItElimina}"
                                        Click="BtnElimina_Click" ToolTip="Elimina promemoria">
                                    <iconPacks:PackIconBootstrapIcons Kind="Trash" Width="13" Height="13"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource ModuleHeaderBorderStyle}" Padding="28,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Promemoria" Style="{StaticResource ModuleTitleStyle}" VerticalAlignment="Center"/>

                <Button Grid.Column="1" Command="{Binding NuovoCommand}" ToolTip="Nuovo promemoria">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
                            <Setter Property="Padding" Value="14,7"/>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBootstrapIcons Kind="Plus" Width="12" Height="12"
                            VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Nuovo promemoria" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- BACHECA: tre colonne fisse -->
        <Grid Grid.Row="1">
            <Grid Margin="28,5,28,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ALTA -->
                <Border Grid.Column="0" Style="{StaticResource ColonnaBacheca}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Margin="0,0,0,12" Padding="2,0,0,10"
                                BorderThickness="0,0,0,1" BorderBrush="{StaticResource BrushDanger}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource DotColonna}" Fill="{StaticResource BrushDanger}"/>
                                <TextBlock Text="Alta" Style="{StaticResource TitoloColonna}"/>
                                <Border Style="{StaticResource BadgeConteggio}">
                                    <TextBlock Text="{Binding PromemoriaAlta.Count}" Style="{StaticResource ConteggioColonna}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="1" Text="Nessun promemoria" HorizontalAlignment="Center" Margin="0,24,0,0"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Visibility="{Binding PromemoriaAlta.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PromemoriaAlta}" ItemTemplate="{StaticResource PostItTemplate}"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- MEDIA -->
                <Border Grid.Column="2" Style="{StaticResource ColonnaBacheca}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Margin="0,0,0,12" Padding="2,0,0,10"
                                BorderThickness="0,0,0,1" BorderBrush="{StaticResource BrushStatoStandBy}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource DotColonna}" Fill="{StaticResource BrushStatoStandBy}"/>
                                <TextBlock Text="Media" Style="{StaticResource TitoloColonna}"/>
                                <Border Style="{StaticResource BadgeConteggio}">
                                    <TextBlock Text="{Binding PromemoriaMedia.Count}" Style="{StaticResource ConteggioColonna}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="1" Text="Nessun promemoria" HorizontalAlignment="Center" Margin="0,24,0,0"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Visibility="{Binding PromemoriaMedia.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PromemoriaMedia}" ItemTemplate="{StaticResource PostItTemplate}"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- BASSA -->
                <Border Grid.Column="4" Style="{StaticResource ColonnaBacheca}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Margin="0,0,0,12" Padding="2,0,0,10"
                                BorderThickness="0,0,0,1" BorderBrush="{StaticResource BrushPrimary}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource DotColonna}" Fill="{StaticResource BrushPrimary}"/>
                                <TextBlock Text="Bassa" Style="{StaticResource TitoloColonna}"/>
                                <Border Style="{StaticResource BadgeConteggio}">
                                    <TextBlock Text="{Binding PromemoriaBassa.Count}" Style="{StaticResource ConteggioColonna}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="1" Text="Nessun promemoria" HorizontalAlignment="Center" Margin="0,24,0,0"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Visibility="{Binding PromemoriaBassa.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PromemoriaBassa}" ItemTemplate="{StaticResource PostItTemplate}"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Form nuovo/modifica (invariato) -->
        <views:ModalDialogControl Grid.Row="0" Grid.RowSpan="2"
            IsAperto="{Binding PannelloAperto}"
            Titolo="{Binding TitoloPannello}"
            ComandoChiudi="{Binding AnnullaCommand}"
            ComandoSalva="{Binding SalvaCommand}"
            HaModificheNonSalvate="{Binding HaModifiche}">

            <views:ModalDialogControl.Contenuto>
                <StackPanel>
                    <TextBlock Text="Titolo" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding FormTitolo, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,16"/>

                    <TextBlock Text="Descrizione" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding FormDescrizione, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="110"
                             VerticalContentAlignment="Top" Margin="0,4,0,16"/>

                    <TextBlock Text="Priorità" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource SegmentContainer}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Bassa" Style="{StaticResource SegmentFormBassa}"
                                    Command="{Binding ImpostaPrioritaCommand}"
                                    CommandParameter="{x:Static models:PrioritaPromemoria.Bassa}"/>
                            <Button Content="Media" Style="{StaticResource SegmentFormMedia}"
                                    Command="{Binding ImpostaPrioritaCommand}"
                                    CommandParameter="{x:Static models:PrioritaPromemoria.Media}"/>
                            <Button Content="Alta" Style="{StaticResource SegmentFormAlta}"
                                    Command="{Binding ImpostaPrioritaCommand}"
                                    CommandParameter="{x:Static models:PrioritaPromemoria.Alta}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </views:ModalDialogControl.Contenuto>
        </views:ModalDialogControl>
    </Grid>
</UserControl>
