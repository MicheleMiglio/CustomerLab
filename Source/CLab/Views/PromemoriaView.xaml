<UserControl x:Class="CLab.Views.PromemoriaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:conv="clr-namespace:CLab.Converters"
             xmlns:models="clr-namespace:CLab.Models">

    <UserControl.Resources>
        <conv:PrioritaPromemoriaAColoreConverter x:Key="PrioritaAColore"/>
        <conv:PrioritaPromemoriaASfondoConverter x:Key="PrioritaASfondo"/>

        <Style x:Key="BtnPrioritaBase" TargetType="Button" BasedOn="{StaticResource BtnOutline}">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>

        <Style x:Key="BtnPrioritaBassa" TargetType="Button" BasedOn="{StaticResource BtnPrioritaBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FormPriorita}" Value="Bassa">
                    <Setter Property="Foreground" Value="{StaticResource BrushPrimaryLight}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BrushPrimaryLight}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnPrioritaMedia" TargetType="Button" BasedOn="{StaticResource BtnPrioritaBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FormPriorita}" Value="Media">
                    <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnPrioritaAlta" TargetType="Button" BasedOn="{StaticResource BtnPrioritaBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FormPriorita}" Value="Alta">
                    <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Grid.RowSpan="3" Style="{StaticResource ModuleHeaderBorderStyle}" Padding="28,0" Height="64"
            VerticalAlignment="Top">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Promemoria" Style="{StaticResource ModuleTitleStyle}"/>
                <TextBlock Text="APPUNTI RAPIDI E POST-IT" Style="{StaticResource ModuleSubtitleStyle}"/>
            </StackPanel>
        </Border>

        <!-- TOOLBAR: ordinamento + nuovo -->
        <Grid Grid.Row="1" Margin="28,75,28,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Ordina per" FontSize="12" Foreground="{StaticResource BrushTestoSecondario}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>

                <Button Content="Data creazione" Command="{Binding MostraPerDataCommand}"
                    Padding="4,6" Margin="0,0,16,0" Cursor="Hand" Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2">
                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OrdinamentoPerPriorita}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Priorità" Command="{Binding MostraPerPrioritaCommand}"
                    Padding="4,6" Cursor="Hand" Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2">
                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OrdinamentoPerPriorita}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <Button Grid.Column="2" Style="{StaticResource BtnOutlineGold}" Command="{Binding NuovoCommand}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconBootstrapIcons Kind="Plus" Width="11" Height="11"
                        Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Nuovo promemoria" VerticalAlignment="Center" Margin="0,4"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- BACHECA -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="28,0,28,24">
            <ItemsControl ItemsSource="{Binding Promemoria}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="230" MinHeight="130" Margin="0,0,16,16" CornerRadius="10"
                            Background="White" BorderBrush="{Binding Priorita, Converter={StaticResource PrioritaAColore}}"
                            BorderThickness="1.3" Padding="14,12,10,10">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.10" BlurRadius="8" ShadowDepth="2" Direction="270"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Pill priorità -->
                                <Border Grid.Row="0" HorizontalAlignment="Left" CornerRadius="8" Padding="7,2" Margin="0,0,0,8"
                                    Background="{Binding Priorita, Converter={StaticResource PrioritaASfondo}}">
                                    <TextBlock Text="{Binding Priorita}" FontSize="10" FontWeight="Medium"
                                        Foreground="{Binding Priorita, Converter={StaticResource PrioritaAColore}}"/>
                                </Border>

                                <TextBlock Grid.Row="1" Text="{Binding Titolo}" FontSize="14" FontWeight="Medium"
                                    Foreground="{StaticResource BrushTestoPrimario}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="2" Text="{Binding Descrizione}" FontSize="13"
                                    Foreground="{StaticResource BrushTestoSecondario}" TextWrapping="Wrap"
                                    VerticalAlignment="Top"/>

                                <Grid Grid.Row="3" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding DataCreazione, StringFormat='d MMM'}"
                                        FontSize="11" Foreground="{StaticResource BrushTestoSecondario}"
                                        Opacity="0.7" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource BtnIcon}"
                                            Command="{Binding DataContext.ModificaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="Modifica">
                                            <iconPacks:PackIconBootstrapIcons Kind="Pencil" Width="12" Height="12"
                                                Foreground="{StaticResource BrushTestoSecondario}"/>
                                        </Button>
                                        <Button Style="{StaticResource BtnIconRed}" Margin="3,0,0,0"
                                            Click="BtnElimina_Click" ToolTip="Butta via">
                                            <iconPacks:PackIconBootstrapIcons Kind="Trash" Width="13" Height="13"
                                                Foreground="{StaticResource BrushTestoSecondario}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- OVERLAY + PANNELLO NUOVO/MODIFICA -->
        <Border Grid.Row="0" Grid.RowSpan="3" Cursor="Arrow"
            Visibility="{Binding PannelloAperto, Converter={StaticResource BoolToVisibility}}">
            <Border.Background>
                <SolidColorBrush Color="{StaticResource ColorPrimaryDark}" Opacity="0.35"/>
            </Border.Background>
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding AnnullaCommand}"/>
            </Border.InputBindings>
        </Border>

        <Border Grid.Row="0" Grid.RowSpan="3" Width="380" HorizontalAlignment="Right" Background="White"
            BorderBrush="{StaticResource BrushBordo}" BorderThickness="1,0,0,0"
            Visibility="{Binding PannelloAperto, Converter={StaticResource BoolToVisibility}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Direction="180" Opacity="0.12" Color="{StaticResource ColorPrimaryDark}"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource ModuleHeaderBorderStyle}" Padding="22,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding TitoloPannello}" Style="{StaticResource ModuleTitleStyle}"/>
                        <Button Grid.Column="1" Style="{StaticResource BtnIconGhost}"
                            Command="{Binding AnnullaCommand}" ToolTip="Chiudi" VerticalAlignment="Top">
                            <iconPacks:PackIconBootstrapIcons Kind="XLg" Width="14" Height="14" Foreground="{StaticResource BrushTestoSecondario}"/>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,16">

                        <TextBlock Text="TITOLO" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding FormTitolo, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,16"/>

                        <TextBlock Text="DESCRIZIONE" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding FormDescrizione, UpdateSourceTrigger=PropertyChanged}"
                            AcceptsReturn="True" TextWrapping="Wrap" Height="120"
                            VerticalContentAlignment="Top" Margin="0,4,0,16"/>

                        <TextBlock Text="PRIORITÀ" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Bassa" Style="{StaticResource BtnPrioritaBassa}"
                                Command="{Binding ImpostaPrioritaCommand}"
                                CommandParameter="{x:Static models:PrioritaPromemoria.Bassa}"/>
                            <Button Content="Media" Style="{StaticResource BtnPrioritaMedia}"
                                Command="{Binding ImpostaPrioritaCommand}"
                                CommandParameter="{x:Static models:PrioritaPromemoria.Media}"/>
                            <Button Content="Alta" Style="{StaticResource BtnPrioritaAlta}"
                                Command="{Binding ImpostaPrioritaCommand}"
                                CommandParameter="{x:Static models:PrioritaPromemoria.Alta}"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="{StaticResource BrushBordo}" BorderThickness="0,1,0,0" Padding="22,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" Content="Annulla" Command="{Binding AnnullaCommand}"
                            Style="{StaticResource BtnOutline}" Margin="0,0,10,0"/>
                        <Button Grid.Column="2" Content="Salva" Command="{Binding SalvaCommand}"
                            Style="{StaticResource BtnPrimary}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
