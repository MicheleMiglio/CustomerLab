                                Visibility="{Binding SezioneTrimestraliEspansa, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ADEMPIMENTO" FontSize="9" FontWeight="Bold"
                                    Foreground="{StaticResource BrushTestoSecondario}" VerticalAlignment="Bottom" Margin="16,0,0,5"/>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding ColonneTrimestrali}" VerticalAlignment="Bottom">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="46" Margin="0,0,4,0">
                                                <TextBlock Text="{Binding}" FontSize="9" FontWeight="Bold" TextAlignment="Center"
                                                    Foreground="{StaticResource BrushTestoSecondario}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding RigheTrimestraliFiltrate}" ItemTemplate="{StaticResource RigaAttivitaTemplate}"
                                      Visibility="{Binding SezioneTrimestraliEspansa, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>

                        <!-- ANNUALI -->
                        <StackPanel Visibility="{Binding HaRigheAnnuali, Converter={StaticResource BoolToVisibility}}">
                            <Button Command="{Binding ToggleSezioneAnnualiCommand}" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconBootstrapIcons Width="10" Height="10" Foreground="{StaticResource BrushTestoSecondario}" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <iconPacks:PackIconBootstrapIcons.Style>
                                                    <Style TargetType="iconPacks:PackIconBootstrapIcons" BasedOn="{StaticResource ChevronSezioneStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SezioneAnnualiEspansa}" Value="True">
                                                                <Setter Property="Kind" Value="ChevronDown"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </iconPacks:PackIconBootstrapIcons.Style>
                                            </iconPacks:PackIconBootstrapIcons>
                                            <TextBlock Text="ANNUALI" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushTestoSecondario}" VerticalAlignment="Center"/>
                                            <Ellipse Width="7" Height="7" Margin="8,0,0,0" VerticalAlignment="Center" Fill="{Binding StatoSezioneAnnuali, Converter={StaticResource StatoAColore}}"/>
                                        </StackPanel>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- FASE 6: intestazione colonne matrice -->
                            <Grid Margin="0,8,13,4"
                                Visibility="{Binding SezioneAnnualiEspansa, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ADEMPIMENTO" FontSize="9" FontWeight="Bold"
                                    Foreground="{StaticResource BrushTestoSecondario}" VerticalAlignment="Bottom" Margin="16,0,0,5"/>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding ColonneAnnuali}" VerticalAlignment="Bottom">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="46" Margin="0,0,4,0">
                                                <TextBlock Text="{Binding}" FontSize="9" FontWeight="Bold" TextAlignment="Center"
                                                    Foreground="{StaticResource BrushTestoSecondario}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding RigheAnnualiFiltrate}" ItemTemplate="{StaticResource RigaAttivitaTemplate}"
                                      Visibility="{Binding SezioneAnnualiEspansa, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>

                        <Grid Margin="0px, 20px" HorizontalAlignment="Left">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="NOTE CLIENTE" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="1" Text="{Binding NotaCliente, UpdateSourceTrigger=LostFocus}"
                             AcceptsReturn="True" TextWrapping="Wrap" Width="540" Height="150"
                             VerticalContentAlignment="Top" Margin="0,4,0,0"/>
                        </Grid>

                        </StackPanel><!-- FASE 8: fine area griglia -->

                        <!-- FASE 8: ELENCO — righe piatte costruite dagli stessi dati
                             già caricati dalla griglia (nessuna seconda query);
                             il click riporta sulla griglia con la stessa cella aperta,
                             quindi lo stesso identico percorso di salvataggio. -->
                        <StackPanel Visibility="{Binding MostraElenco, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding EmptyElencoTesto}" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,10"
                                Visibility="{Binding HaElencoAdempimenti, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}"/>

                            <ItemsControl ItemsSource="{Binding ElencoAdempimenti}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ApriDaElencoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Cursor="Hand"
                                            ToolTip="Apri compilazione" HorizontalContentAlignment="Stretch">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="White" BorderBrush="{StaticResource BrushBordo}"
                                                        BorderThickness="0,0,0,1" Padding="12,9">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2.2*"/>
                                                                <ColumnDefinition Width="1.2*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                <TextBlock Text="{Binding AttivitaNome}" FontSize="13" FontWeight="Medium"
                                                                    Foreground="{StaticResource BrushTestoPrimario}" TextTrimming="CharacterEllipsis"
                                                                    VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding PeriodoTesto}" FontSize="11" Margin="10,0,0,0"
                                                                    Foreground="{StaticResource BrushTestoSecondario}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding Cliente}" FontSize="11"
                                                                Foreground="{StaticResource BrushTestoSecondario}" VerticalAlignment="Center"
                                                                TextTrimming="CharacterEllipsis"/>
                                                            <local:StatusBadgeControl Grid.Column="2" Stato="{Binding Stato}" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushAccentHover}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- RITENUTE D'ACCONTO -->
        <Grid Grid.Row="3" Visibility="{Binding MostraRitenute, Converter={StaticResource BoolToVisibility}}">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding NessunClienteSelezionato, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Seleziona un cliente e un anno per iniziare" FontSize="13" Foreground="{StaticResource BrushTestoSecondario}"/>
            </StackPanel>

            <Grid Visibility="{Binding NessunClienteSelezionato, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- KPI anno (indipendenti dai filtri lista) -->
                <Border Grid.Row="0" MaxWidth="560" HorizontalAlignment="Left"
                        Background="White" BorderBrush="{StaticResource BrushBordoLeggero}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMedium}" Padding="18,12" Margin="28,16,28,0">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TOTALE" FontSize="10" FontWeight="Medium"
                                       Foreground="{StaticResource BrushTestoSecondario}"/>
                            <TextBlock Text="{Binding TotaleRitenuteTesto}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTestoPrimario}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Rectangle Width="1" Height="26" Fill="{StaticResource BrushBordoLeggero}"
                                   Margin="24,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="VERSATO" FontSize="10" FontWeight="Medium"
                                       Foreground="{StaticResource BrushTestoSecondario}"/>
                            <TextBlock Text="{Binding TotaleVersatoTesto}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushStatoAttivo}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Rectangle Width="1" Height="26" Fill="{StaticResource BrushBordoLeggero}"
                                   Margin="24,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="RESIDUO" FontSize="10" FontWeight="Medium"
                                       Foreground="{StaticResource BrushTestoSecondario}"/>
                            <TextBlock Text="{Binding ResiduoRitenuteTesto}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushPrimary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Rectangle Width="1" Height="26" Fill="{StaticResource BrushBordoLeggero}"
                                   Margin="24,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ANOMALIE" FontSize="10" FontWeight="Medium"
                                       Foreground="{StaticResource BrushTestoSecondario}"/>
                            <TextBlock Text="{Binding RitenuteAnomalie}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushDanger}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Filtri + ricerca + nuova -->
                <Grid Grid.Row="1" Margin="28,10,28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource BrushSfondoFine}"
                            CornerRadius="{StaticResource RadiusSmall}" Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Tutte" Style="{StaticResource ChipRitenuteTutte}"
                                    Command="{Binding ImpostaFiltroStatoRitenuteCommand}" CommandParameter="Tutte"/>
                            <Button Content="Da versare" Style="{StaticResource ChipRitenuteDaVersare}"
                                    Command="{Binding ImpostaFiltroStatoRitenuteCommand}" CommandParameter="Da versare"/>
                            <Button Content="Versate" Style="{StaticResource ChipRitenuteVersate}"
                                    Command="{Binding ImpostaFiltroStatoRitenuteCommand}" CommandParameter="Versate"/>
                            <Button Content="Anomalie" Style="{StaticResource ChipRitenuteAnomalie}"
                                    Command="{Binding ImpostaFiltroStatoRitenuteCommand}" CommandParameter="Anomalie"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="2" Style="{StaticResource ChipFiltro}"
                            Command="{Binding AzzeraFiltriRitenuteCommand}" ToolTip="Rimuove i filtri"
                            Visibility="{Binding HaFiltriRitenuteAttivi, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBootstrapIcons Kind="Eraser" Width="11" Height="11"
                                Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Azzera filtri" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Grid.Column="3" Width="250" Height="32" Background="White" Margin="0,0,10,0"
                            BorderBrush="{StaticResource BrushBordo}" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconBootstrapIcons Grid.Column="0" Kind="Search" Width="13" Height="13"
                                Foreground="{StaticResource BrushTestoSecondario}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Margin="0,0,5,0"
                                Text="{Binding FiltroRitenuteTesto, UpdateSourceTrigger=PropertyChanged}"
                                BorderThickness="0" Background="Transparent" FontSize="12"
                                Foreground="{StaticResource BrushTestoPrimario}"
                                VerticalContentAlignment="Center"
                                mah:TextBoxHelper.Watermark="  Cerca intestazione o n. fattura…"/>
                            <Button Grid.Column="2" Style="{StaticResource AzioneGriglia}" Width="22" Height="22"
                                Margin="0,0,4,0" Click="CancellaRicercaRitenute_Click" ToolTip="Cancella ricerca"
                                Visibility="{Binding FiltroRitenuteTesto, Converter={StaticResource BoolToVisibility}}">
                                <iconPacks:PackIconBootstrapIcons Kind="XLg" Width="10" Height="10"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Button Grid.Column="4" Style="{StaticResource BtnPrimary}" Height="32" MinWidth="118" Padding="12,0"
                            Command="{Binding NuovaRitenutaCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBootstrapIcons Kind="Plus" Width="11" Height="11"
                                Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Nuova ritenuta" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <DataGrid Grid.Row="2" x:Name="gridRitenute" ItemsSource="{Binding RitenuteFiltrate}"
                          Style="{StaticResource ModuleDataGridStyle}"
                          AlternationCount="2"
                          RowHeight="44" Margin="28,12,28,0"
                          MouseDoubleClick="gridRitenute_MouseDoubleClick">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModuleDataGridColumnHeaderStyle}"/>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource ModuleDataGridRowClickableSelectedStyle}"/>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="INTESTAZIONE" Binding="{Binding Intestazione}" Width="1.3*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="14,0"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="N. FATTURA" Binding="{Binding NumeroFattura}" Width="0.9*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="14,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="EMISSIONE" Binding="{Binding DataFattura, StringFormat=dd/MM/yyyy}" Width="0.85*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="14,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="PAG. FATTURA" Binding="{Binding DataPagamentoFattura, StringFormat=dd/MM/yyyy}" Width="0.9*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="14,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="IMPORTO R.A." Binding="{Binding ImportoRitenuta, StringFormat='€ {0:N2}'}" Width="0.9*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="14,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="PAG. R.A." Binding="{Binding ScadenzaVersamento, StringFormat=dd/MM/yyyy}" Width="0.85*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="14,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="VERSATO" Binding="{Binding ImportoVersato, StringFormat='€ {0:N2}'}" Width="0.85*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="14,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="RAVV." Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Style="{StaticResource ModuleCheckBoxStyle}"
                                              IsChecked="{Binding Ravvedimento, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleRavvedimentoRitenutaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"
                                              ToolTip="Ravvedimento operoso"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="STATO" Width="1.15*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                        <local:StatusBadgeControl Stato="{Binding StatoVersamento}"/>
                                        <iconPacks:PackIconBootstrapIcons Kind="ExclamationTriangleFill"
                                            Width="11" Height="11" Foreground="{StaticResource BrushDanger}" Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HaAnomalieData, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="{Binding DettaglioAnomalieData}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Style="{StaticResource AzioneGriglia}"
                                            Command="{Binding DataContext.ModificaRitenutaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="Modifica">
                                            <iconPacks:PackIconBootstrapIcons Kind="Pencil" Width="12" Height="12"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>
                                        <Button Style="{StaticResource AzioneGrigliaElimina}" Margin="2,0,0,0"
                                            Command="{Binding DataContext.EliminaRitenutaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="Elimina">
                                            <iconPacks:PackIconBootstrapIcons Kind="Trash" Width="12" Height="12"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="3" Margin="28,8,28,24" HorizontalAlignment="Center"
                    Visibility="{Binding HaRitenuteFiltrate, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                    <TextBlock Text="{Binding EmptyRitenuteTesto}" FontSize="14"
                        Foreground="{StaticResource BrushTestoSecondario}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <local:ModalDialogControl
                IsAperto="{Binding PannelloRitenutaAperto}"
                Titolo="{Binding TitoloPannelloRitenuta}"
                ComandoChiudi="{Binding AnnullaRitenutaCommand}"
                ComandoSalva="{Binding SalvaRitenutaCommand}"
                LarghezzaExtra="720">
                <local:ModalDialogControl.Contenuto>
                    <StackPanel>
                        <TextBlock Text="DATI FATTURA" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="INTESTAZIONE" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding FormIntestazione, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="NUMERO FATTURA" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding FormNumeroFattura, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                                <TextBlock Text="DATA FATTURA" Style="{StaticResource FieldLabel}"/>
                                <DatePicker SelectedDate="{Binding FormDataFattura}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                                <Grid Height="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="DATA PAGAMENTO FATTURA" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0"
                                            Command="{Binding PulisciDataPagamentoFatturaCommand}" ToolTip="Svuota"
                                            Visibility="{Binding FormDataPagamentoFattura, Converter={StaticResource BoolToVisibility}}">
                                        <iconPacks:PackIconBootstrapIcons Kind="XLg" Width="10" Height="10"
                                            Foreground="{StaticResource BrushTestoSecondario}"/>
                                    </Button>
                                </Grid>
                                <DatePicker SelectedDate="{Binding FormDataPagamentoFattura}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="DATI RITENUTA" Style="{StaticResource SectionTitle}" Margin="0,22,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="IMPORTO RITENUTA" Style="{StaticResource FieldLabel}"/>
                                <Border BorderBrush="{StaticResource BrushBordo}" BorderThickness="1" CornerRadius="5" Height="34" Margin="0,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource BrushSfondoChiaro}" CornerRadius="4,0,0,4" Padding="10,0">
                                            <TextBlock Text="€" Foreground="{StaticResource BrushTestoSecondario}" VerticalAlignment="Center" FontSize="12"/>
                                        </Border>
                                        <TextBox Grid.Column="1" BorderThickness="0" TextAlignment="Right" Padding="8,0"
                                                 Text="{Binding FormImportoRitenuta, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <Grid Height="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="DATA PAGAMENTO RITENUTA" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0"
                                            Command="{Binding PulisciDataPagamentoRitenutaCommand}" ToolTip="Svuota"
                                            Visibility="{Binding FormScadenzaVersamento, Converter={StaticResource BoolToVisibility}}">
                                        <iconPacks:PackIconBootstrapIcons Kind="XLg" Width="10" Height="10"
                                            Foreground="{StaticResource BrushTestoSecondario}"/>
                                    </Button>
                                </Grid>
                                <DatePicker SelectedDate="{Binding FormScadenzaVersamento}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                                <Grid Height="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="IMPORTO VERSATO" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0"
                                            Command="{Binding SegnaVersatoInteroCommand}"
                                            ToolTip="Imposta l'importo versato pari alla ritenuta e la data di pagamento di oggi">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconBootstrapIcons Kind="CheckCircle" Width="10" Height="10"
                                                Foreground="{StaticResource BrushStatoAttivo}" Margin="0,2,4,0"/>
                                            <TextBlock Text="Segna versato oggi" FontSize="10" FontWeight="Medium"
                                                       Foreground="{StaticResource BrushStatoAttivo}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" BorderBrush="{StaticResource BrushBordo}" BorderThickness="1" CornerRadius="5" Height="34">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{StaticResource BrushSfondoChiaro}" CornerRadius="4,0,0,4" Padding="10,0">
                                                <TextBlock Text="€" Foreground="{StaticResource BrushTestoSecondario}" VerticalAlignment="Center" FontSize="12"/>
                                            </Border>
                                            <TextBox Grid.Column="1" BorderThickness="0" TextAlignment="Right" Padding="8,0"
                                                     Text="{Binding FormImportoVersato, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                        </Grid>
                                    </Border>
                                    <Button Grid.Column="1" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0"
                                            Margin="8,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding PulisciImportoVersatoCommand}" ToolTip="Svuota"
                                            Visibility="{Binding FormImportoVersato, Converter={StaticResource BoolToVisibility}}">
                                        <iconPacks:PackIconBootstrapIcons Kind="XLg" Width="10" Height="10"
                                            Foreground="{StaticResource BrushTestoSecondario}"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0" VerticalAlignment="Center">
                                <TextBlock Text="RAVVEDIMENTO" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <CheckBox Style="{StaticResource ModuleCheckBoxStyle}"
                                              IsChecked="{Binding FormRavvedimento}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Versamento con ravvedimento operoso" Margin="8,0,0,0"
                                               Foreground="{StaticResource BrushTestoPrimario}" FontSize="13" VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </local:ModalDialogControl.Contenuto>
            </local:ModalDialogControl>
        </Grid>

        <!-- OVERLAY DUPLICA -->
        <Border Grid.Row="0" Grid.RowSpan="4" Style="{StaticResource OverlayScuroStyle}"
            Visibility="{Binding PannelloDuplicaAperto, Converter={StaticResource BoolToVisibility}}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding AnnullaDuplicaCommand}"/>
            </Border.InputBindings>
        </Border>

        <!-- PANNELLO DUPLICA -->
        <Border Grid.Row="0" Grid.RowSpan="4" Width="380" HorizontalAlignment="Right"
            Style="{StaticResource PanelLateraleStyle}"
            Visibility="{Binding PannelloDuplicaAperto, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Duplica attività" Style="{StaticResource ModuleTitleStyle}"/>
                        <Button Grid.Column="1" Style="{StaticResource BtnIconGhost}"
                            Command="{Binding AnnullaDuplicaCommand}" ToolTip="Chiudi" VerticalAlignment="Top">
                            <iconPacks:PackIconBootstrapIcons Kind="XLg" Width="14" Height="14"
                            Foreground="{StaticResource BrushTestoSecondario}"/>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,16">

                        <TextBlock Text="DUPLICA DA" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding ClientiDuplicabili}"
                              TextSearch.TextPath="RagioneSociale"
                              SelectedItem="{Binding ClienteSorgenteSelezionato}"
                              Margin="0,4,0,16"/>

                        <StackPanel Visibility="{Binding ClienteSorgenteSelezionato, Converter={StaticResource BoolToVisibility}}">

                            <TextBlock Text="VERRANNO ASSEGNATE" Style="{StaticResource FieldLabel}"/>
                            <ItemsControl ItemsSource="{Binding AttivitaAssegnate}" Margin="0,4,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushSfondoChiaro}" CornerRadius="4"
                                            Padding="10,7" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Nome}" FontSize="12"
                                                           Foreground="{StaticResource BrushTestoPrimario}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding Periodicita}" FontSize="10"
                                                               Foreground="{StaticResource BrushTestoSecondario}"
                                                               Background="White" Padding="6,2" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding TipoCampo, Converter={StaticResource TipoCampoLabel}}"
                                                               FontSize="10" Foreground="{StaticResource BrushTestoSecondario}"
                                                               Background="White" Padding="6,2"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Padding="4"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.RimuoviDaAssegnateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" ToolTip="Non assegnare">
                                                    <iconPacks:PackIconBootstrapIcons Kind="Dash" Width="11" Height="11"
                                                    Foreground="{StaticResource BrushTestoSecondario}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="NON VERRANNO ASSEGNATE" Style="{StaticResource FieldLabel}"/>
                            <ItemsControl ItemsSource="{Binding AttivitaNonAssegnate}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushSfondoChiaro}" CornerRadius="4"
                                            Padding="10,7" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Nome}" FontSize="12"
                                                           Foreground="{StaticResource BrushTestoSecondario}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding Periodicita}" FontSize="10"
                                                               Foreground="{StaticResource BrushTestoSecondario}"
                                                               Background="White" Padding="6,2" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding TipoCampo, Converter={StaticResource TipoCampoLabel}}"
                                                               FontSize="10" Foreground="{StaticResource BrushTestoSecondario}"
                                                               Background="White" Padding="6,2"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Padding="4"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.AggiungiAdAssegnateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" ToolTip="Assegna">
                                                    <iconPacks:PackIconBootstrapIcons Kind="Plus" Width="11" Height="11"
                                                    Foreground="{StaticResource BrushTestoSecondario}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="{StaticResource BrushBordo}" BorderThickness="0,1,0,0" Padding="22,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Salva" Command="{Binding SalvaDuplicaCommand}"
                            Style="{StaticResource BtnPrimary}" HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="2" Content="Annulla" Command="{Binding AnnullaDuplicaCommand}"
                            Style="{StaticResource BtnOutline}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
