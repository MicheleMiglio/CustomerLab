                               FontWeight="Medium"
                               Foreground="{StaticResource BrushTestoPrimario}"/>
                                    </Grid>

                                </StackPanel>

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="1" Grid.Row="0" Background="{StaticResource BrushSuccessLight}" CornerRadius="10" Padding="18" Margin="0,0,10,10">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotaleRitenuteTesto}" FontSize="26" FontWeight="Medium" Foreground="{StaticResource BrushSuccess}" HorizontalAlignment="Center"/>
                                <TextBlock Text="TOTALE RITENUTE" FontSize="10" FontWeight="Medium" Foreground="{StaticResource BrushSuccess}"
               HorizontalAlignment="Center" Margin="0,4,0,0"/>

                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Grid.Row="1" Background="{StaticResource BrushStatoStandByLight}" CornerRadius="10" Padding="18" Margin="0,0,10,0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RitenuteDaVersare}" FontSize="26" FontWeight="Medium" Foreground="{StaticResource BrushStatoStandBy}" HorizontalAlignment="Center"/>

                                <TextBlock Text="RITENUTE IN ATTESA" FontSize="10" FontWeight="Medium" Foreground="{StaticResource BrushStatoStandBy}"
               HorizontalAlignment="Center" Margin="0,4,0,0"/>

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="2" Grid.Row="1" Background="{StaticResource BrushDangerLight}" CornerRadius="10" Padding="18">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RitenuteAnomalie}" FontSize="26" FontWeight="Medium" Foreground="{StaticResource BrushDanger}" HorizontalAlignment="Center"/>

                                <TextBlock Text="ANOMALIE DA VERIFICARE" FontSize="10" FontWeight="Medium" Foreground="{StaticResource BrushDanger}"
               HorizontalAlignment="Center" Margin="0,4,0,0"/>

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="2" Grid.Row="0" Background="{StaticResource BrushInfoLight}" CornerRadius="10" Padding="18"  Margin="0,0,0,10">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotaleVersatoTesto}" FontSize="26" FontWeight="Medium" Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Center"/>

                                <TextBlock Text="TOTALE VERSATO" FontSize="10" FontWeight="Medium" Foreground="{StaticResource BrushPrimary}"
               HorizontalAlignment="Center" Margin="0,4,0,0"/>

                            </StackPanel>

                        </Border>


                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ADEMPIMENTI -->
        <Grid Grid.Row="3" Visibility="{Binding MostraAdempimenti, Converter={StaticResource BoolToVisibility}}">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding NessunClienteSelezionato, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Seleziona un cliente e un anno per iniziare" FontSize="13" Foreground="{StaticResource BrushTestoSecondario}"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding MostraEmptyState, Converter={StaticResource BoolToVisibility}}">
                <iconPacks:PackIconBootstrapIcons Kind="ClipboardData" Width="40" Height="40"
                    Foreground="{StaticResource BrushBordo}" HorizontalAlignment="Center"/>
                <TextBlock Text="Nessuna attività configurata per questo cliente"
                       FontSize="13" FontWeight="Medium" Foreground="{StaticResource BrushTestoPrimario}"
                       HorizontalAlignment="Center" Margin="0,14,0,2"/>
                <TextBlock Text="Scegli come iniziare" FontSize="12" Foreground="{StaticResource BrushTestoSecondario}"
                       HorizontalAlignment="Center" Margin="0,0,0,18"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource BtnOutlineGold}"
                        Command="{Binding ConfiguraAttivitaCommand}" Margin="0,0,10,0">
