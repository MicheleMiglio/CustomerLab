                                        <Border Grid.Column="0" Width="8" Height="8" Background="{StaticResource BrushDanger}" CornerRadius="2" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1" Text="In ritardo" FontSize="10" Foreground="{StaticResource BrushTestoSecondario}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TortaAnnuali.InRitardo}" FontSize="10" FontWeight="Medium" Foreground="{StaticResource BrushTestoPrimario}"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </UniformGrid>

                    <UniformGrid Rows="1" Columns="3">
                        <Border Background="{StaticResource BrushSuccessLight}" CornerRadius="10" Padding="30" Margin="0,0,10,0">
