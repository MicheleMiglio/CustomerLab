                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding RigheMensiliFiltrate}" ItemTemplate="{StaticResource RigaAttivitaTemplate}"
                                      Visibility="{Binding SezioneMensiliEspansa, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>

