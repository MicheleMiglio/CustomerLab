                                        <Border Grid.Column="0" Width="8" Height="8" Background="{StaticResource BrushSuccess}" CornerRadius="2" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1" Text="Completate" FontSize="10" Foreground="{StaticResource BrushTestoSecondario}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TortaAnnuali.Completate}" FontSize="10" FontWeight="Medium" Foreground="{StaticResource BrushTestoPrimario}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="8" Height="8" Background="{StaticResource BrushPrimary}" CornerRadius="2" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1" Text="Da fare ad oggi" FontSize="10" Foreground="{StaticResource BrushTestoSecondario}"/>
