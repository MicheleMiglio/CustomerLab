                                        <Border Grid.Column="0" Width="8" Height="8" Background="{StaticResource BrushDanger}" CornerRadius="2" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1" Text="In ritardo" FontSize="10" Foreground="{StaticResource BrushTestoSecondario}"/>
