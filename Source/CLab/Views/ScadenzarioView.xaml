<UserControl x:Class="CLab.Views.ScadenzarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:converters="clr-namespace:CLab.Converters"
             xmlns:local="clr-namespace:CLab.Views">

    <UserControl.Resources>
        <converters:TipoCampoLabelConverter x:Key="TipoCampoLabel"/>
        <converters:PercentoAGridLengthConverter x:Key="PercentoAGridLength"/>
        <!-- FASE 2: badge semantico unificato (chiavi locali invariate per i binding esistenti) -->
        <converters:StatoSemanticoForeConverter x:Key="StatoAColore"/>
        <converters:StatoSemanticoBackConverter x:Key="StatoASfondo"/>
        <converters:StatoSemanticoForeConverter x:Key="VersatoAColore"/>
        <converters:StatoSemanticoTestoConverter x:Key="StatoVersamentoTesto"/>
        <converters:StatoSemanticoForeConverter x:Key="StatoVersamentoAColore"/>

        <!-- Stili "presi in prestito" 1:1 da HomeView (CardHome/RigaCliccabileHome):
             la vista generale dello Scadenzario deve avere lo stesso linguaggio della
             Home, quindi qui vivono le stesse identiche regole, non una variante. -->
        <Style x:Key="CardGenerale" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBordoLeggero}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="RigaCliccabileGenerale" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrushHoverNeutro}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Contatore numerico interno alle card: copiato 1:1 da HomeView. -->
        <Style x:Key="ContatoreSecondario" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
        </Style>

        <!-- Caption "· N di M" dopo il titolo sezione: copiato 1:1 da HomeView. -->
        <Style x:Key="CaptionSezione" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTestoTerziario}"/>
        </Style>

        <!-- Link "Apri X →" in fondo card: copiato 1:1 da HomeView. -->
        <Style x:Key="LinkHome" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrushPrimaryHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- KPI flat cliccabile: copiato 1:1 da HomeView. -->
        <Style x:Key="KpiButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrushHoverNeutro}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chip filtro (segmented): stesso pattern locale di Fatture/Clienti. -->
        <Style x:Key="ChipFiltro" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushHoverNeutro}"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="Sel"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushSidebarSelectedBadge}"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChipFiltroNoHover"
       TargetType="Button"
       BasedOn="{StaticResource ChipFiltro}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                        Background="{TemplateBinding Background}"
                        CornerRadius="5"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChipStatoAttivi" TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FiltroStatoCliente}" Value="Attivi">
                    <Setter Property="Tag" Value="Sel"/>
                    <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChipStatoStandBy" TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FiltroStatoCliente}" Value="Stand by">
                    <Setter Property="Tag" Value="Sel"/>
                    <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChipStatoCessati" TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FiltroStatoCliente}" Value="Cessati">
                    <Setter Property="Tag" Value="Sel"/>
                    <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChipStatoTutti" TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FiltroStatoCliente}" Value="Tutti">
                    <Setter Property="Tag" Value="Sel"/>
                    <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChipRitenuteTutte" TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FiltroStatoRitenute}" Value="Tutte">
                    <Setter Property="Tag" Value="Sel"/>
                    <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChipRitenuteDaVersare" TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FiltroStatoRitenute}" Value="Da versare">
                    <Setter Property="Tag" Value="Sel"/>
                    <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChipRitenuteVersate" TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FiltroStatoRitenute}" Value="Versate">
                    <Setter Property="Tag" Value="Sel"/>
                    <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChipRitenuteAnomalie" TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FiltroStatoRitenute}" Value="Anomalie">
                    <Setter Property="Tag" Value="Sel"/>
                    <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AzioneGriglia" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushHoverNeutro}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Segna come versata: pattern identico a Fatture/AzioneGrigliaPagata, il verde
             è semantica e resta tale anche in hover. -->
        <Style x:Key="AzioneGrigliaPagata" TargetType="Button" BasedOn="{StaticResource AzioneGriglia}">
            <Setter Property="Foreground" Value="{StaticResource BrushStatoAttivo}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrushStatoAttivo}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AzioneGrigliaElimina" TargetType="Button" BasedOn="{StaticResource AzioneGriglia}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrushStatoCessato}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="RigaAttivitaTemplate">
            <Border Background="White" BorderBrush="{StaticResource BrushBordo}" BorderThickness="1"
                CornerRadius="8" Margin="0,0,0,6">
                <StackPanel>
                    <Button Command="{Binding ToggleEspansaCommand}" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="14,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <iconPacks:PackIconBootstrapIcons Grid.Column="0" Width="11" Height="11"
                                            Foreground="{StaticResource BrushTestoSecondario}" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <iconPacks:PackIconBootstrapIcons.Style>
                                                <Style TargetType="iconPacks:PackIconBootstrapIcons">
                                                    <Setter Property="Kind" Value="ChevronRight"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Espansa}" Value="True">
                                                            <Setter Property="Kind" Value="ChevronDown"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </iconPacks:PackIconBootstrapIcons.Style>
                                        </iconPacks:PackIconBootstrapIcons>
                                        <TextBlock Grid.Column="1" Text="{Binding Nome}" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushTestoPrimario}" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TipoCampo, Converter={StaticResource TipoCampoLabel}}" FontSize="10"
                                               Foreground="{StaticResource BrushTestoSecondario}" Margin="8,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                        <!-- Situazione annuale sempre visibile come pallini colorati,
                                             anche a riga chiusa: click su un pallino seleziona quel
                                             periodo e apre la riga, stesso comando delle pillole piene
                                             sotto — qui è solo la versione compatta dello stesso dato. -->
                                        <ItemsControl Grid.Column="4" ItemsSource="{Binding Pillole}" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding SelezionaCommand}" CommandParameter="{Binding Indice}"
                                                        Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0"
                                                        Width="9" Height="20" ToolTip="{Binding Etichetta}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Grid Background="Transparent">
                                                                    <Ellipse Width="6" Height="6"
                                                                        Fill="{Binding StatoColore, Converter={StaticResource StatoAColore}}"/>
                                                                </Grid>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Grid.Column="5" Text="{Binding TestoRiepilogo}" FontSize="11" FontWeight="Medium"
                                               Foreground="{StaticResource BrushTestoSecondario}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Riga aperta: qui, e solo qui, la matrice a pillole intere
                         (etichetta leggibile, click per selezionare) e il pannello
                         di compilazione del periodo scelto. A riga chiusa restano
                         visibili solo i pallini sopra — meno colore sparato quando
                         non serve, la situazione resta comunque leggibile. -->
                    <StackPanel Visibility="{Binding Espansa, Converter={StaticResource BoolToVisibility}}">

                        <ItemsControl ItemsSource="{Binding Pillole}" Margin="14,0,12,10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,4,4">
                                        <Button Command="{Binding SelezionaCommand}" CommandParameter="{Binding Indice}"
                                            Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="5" Width="46" BorderThickness="1.5"
                                                        Background="{Binding StatoColore, Converter={StaticResource StatoASfondo}}">
                                                        <TextBlock Text="{Binding Etichetta}" FontSize="11" TextAlignment="Center" Padding="0,4"
                                                            Foreground="{Binding StatoColore, Converter={StaticResource StatoAColore}}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Selezionato}" Value="True">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Selezionato}" Value="False">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="Transparent"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Toggle compilazione rapida Sì/No (sopra la pill, a destra) -->
                                        <Button Command="{Binding ToggleRapidoCommand}" Cursor="Hand" Focusable="False"
                                            BorderThickness="0" Background="Transparent" Padding="0"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"
                                            Visibility="{Binding MostraToggleRapido, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="Compilazione rapida Sì/No">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="tg" CornerRadius="4" Padding="4,1" Background="Transparent">
                                                        <TextBlock Text="✓" FontSize="10" FontWeight="Bold" TextAlignment="Center"
                                                            Foreground="{Binding StatoColore, Converter={StaticResource StatoAColore}}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="tg" Property="Background" Value="{StaticResource BrushAccentHover}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border BorderBrush="{StaticResource BrushBordo}" BorderThickness="0,1,0,0">
                            <Border BorderThickness="3,0,0,0"
                                BorderBrush="{Binding CellaSelezionata.Stato, Converter={StaticResource StatoAColore}}"
                                Background="{StaticResource BrushSfondoChiaro}">
                                <StackPanel Margin="14,14,14,16">
                                    <local:CellaCompilazioneControl DataContext="{Binding CellaSelezionata}"/>
                                </StackPanel>
                            </Border>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>


        <Style x:Key="ChevronSezioneStyle" TargetType="iconPacks:PackIconBootstrapIcons">
            <Setter Property="Kind" Value="ChevronRight"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER: titolo + tab + YearNavigator (pattern Fatture) -->
        <Border Grid.Row="0" Style="{StaticResource ModuleHeaderBorderStyle}" Padding="28,0" Height="64">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Scadenzario" Style="{StaticResource ModuleTitleStyle}"
                           VerticalAlignment="Center" Margin="0,0,24,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding NessunClienteSelezionato, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                    <Button Content="Dashboard" Command="{Binding MostraDashboardCommand}"
                        Margin="0,0,16,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabUnderlineButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MostraDashboard}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Adempimenti" Command="{Binding MostraAdempimentiCommand}"
                        Margin="0,0,16,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabUnderlineButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MostraAdempimenti}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Ritenute d'acconto" Command="{Binding MostraRitenuteCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabUnderlineButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MostraRitenute}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <local:YearNavigatorControl Grid.Column="3" HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Anno="{Binding AnnoSelezionato}"
                                            ComandoPrecedente="{Binding AnnoPrecedenteCommand}"
                                            ComandoSuccessivo="{Binding AnnoSuccessivoCommand}"/>
            </Grid>
        </Border>

        <!-- BARRA CONTESTO — due stati mutuamente esclusivi, mai visibili insieme:
             VISTA GENERALE: ciclo vita + referente + cliente, per scegliere con chi lavorare.
             MODALITÀ CLIENTE: barra compatta evidenziata con un solo modo per uscire,
             così non si cambia cliente per un click sbagliato mentre si sta compilando. -->

        <Grid Grid.Row="1" Margin="28,10,28,0"
              Visibility="{Binding NessunClienteSelezionato, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BrushSfondoFine}"
                    CornerRadius="{StaticResource RadiusSmall}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Attivi" Style="{StaticResource ChipStatoAttivi}"
                            Command="{Binding ImpostaFiltroStatoClienteCommand}" CommandParameter="Attivi"/>
                    <Button Content="Stand by" Style="{StaticResource ChipStatoStandBy}"
                            Command="{Binding ImpostaFiltroStatoClienteCommand}" CommandParameter="Stand by"/>
                    <Button Content="Cessati" Style="{StaticResource ChipStatoCessati}"
                            Command="{Binding ImpostaFiltroStatoClienteCommand}" CommandParameter="Cessati"/>
                    <Button Content="Tutti" Style="{StaticResource ChipStatoTutti}"
                            Command="{Binding ImpostaFiltroStatoClienteCommand}" CommandParameter="Tutti"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="Studio"
               Style="{StaticResource FieldLabel}"
               Margin="0,0,0,4"/>

                <ComboBox Width="180" Height="32"
              IsTextSearchEnabled="True"
              TextSearch.TextPath="Nome" Margin="0,0,10,0"
              ItemsSource="{Binding ReferentiFiltro}"
              SelectedItem="{Binding ReferenteFiltro}"
              mah:TextBoxHelper.Watermark="Tutti i referenti"/>
            </StackPanel>

            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                <TextBlock Text="Cliente"
               Style="{StaticResource FieldLabel}"
               Margin="0,0,0,4"/>

                <ComboBox Width="240" Height="32"
              IsTextSearchEnabled="True"
              TextSearch.TextPath="RagioneSociale"
              ItemsSource="{Binding ClientiDisponibili}"
              SelectedItem="{Binding ClienteSelezionato}"
              mah:TextBoxHelper.Watermark="Seleziona un cliente"/>
            </StackPanel>

        </Grid>

        <Border Grid.Row="1" Margin="28,0,28,0" Padding="14,0" CornerRadius="{StaticResource RadiusSmall}"
                Background="{StaticResource BrushInfoLight}"
                Visibility="{Binding NessunClienteSelezionato, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding ClienteSelezionato.RagioneSociale}"
                           FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTestoPrimario}"
                           VerticalAlignment="Center"/>


                <Border Grid.Column="1" Padding="10,8,28,8"
                Visibility="{Binding MostraAvvisoClienteNonAttivo, Converter={StaticResource BoolToVisibility}}">
                    <Border CornerRadius="{StaticResource RadiusLarge}" Padding="12,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AvvisoClienteCessato}" Value="True">
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBootstrapIcons Kind="InfoCircle" Width="12" Height="12"
                        Margin="0,0,8,0" VerticalAlignment="Center">
                                <iconPacks:PackIconBootstrapIcons.Style>
                                    <Style TargetType="iconPacks:PackIconBootstrapIcons">
                                        <Setter Property="Foreground" Value="{StaticResource BrushStatoStandBy}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AvvisoClienteCessato}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource BrushStatoCessato}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AvvisoClienteAttivo}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource BrushStatoAttivo}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </iconPacks:PackIconBootstrapIcons.Style>
                            </iconPacks:PackIconBootstrapIcons>
                            <TextBlock Text="{Binding TestoAvvisoClienteNonAttivo}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource BrushStatoStandBy}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AvvisoClienteCessato}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource BrushStatoCessato}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AvvisoClienteAttivo}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource BrushStatoAttivo}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Border>

                <Button Grid.Column="3"
        Command="{Binding EsciDalClienteCommand}"
        Style="{StaticResource ChipFiltroNoHover}"
        ToolTip="Torna alla vista generale, su tutti i clienti">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBootstrapIcons Kind="ArrowLeft"
            Width="11"
            Height="11"
            Margin="0,0,6,0"
            VerticalAlignment="Center"/>
                        <TextBlock Text="Cambia cliente"
                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>


        <!-- VISTA GENERALE — landing operativa quando nessun cliente è selezionato.
             Sostituisce concettualmente i tre vecchi placeholder "Seleziona un cliente":
             qui, invece, si vede subito e su TUTTI i clienti filtrati cosa c'è da fare,
             con la riga cliccabile che entra direttamente nel cliente giusto. -->
        <Grid Grid.Row="3" Visibility="{Binding NessunClienteSelezionato, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Riepilogo flat, stile Home: numeri, non caselle colorate -->
            <Grid Grid.Row="0" Margin="28,25,28,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding GeneraleInRitardo}" Style="{StaticResource KpiNumberStyle}" HorizontalAlignment="Center"
                               Foreground="{StaticResource BrushStatoCessato}"/>
                    <TextBlock Text="In ritardo" Style="{StaticResource KpiLabelStyle}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
                <Rectangle Grid.Column="1" Fill="{StaticResource BrushBordoLeggero}" Margin="0,4"/>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding GeneraleInScadenzaOggi}" Style="{StaticResource KpiNumberStyle}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Da fare adesso" Style="{StaticResource KpiLabelStyle}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
                <Rectangle Grid.Column="3" Fill="{StaticResource BrushBordoLeggero}" Margin="0,4"/>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="{Binding GeneraleRitenuteDaVersare}" Style="{StaticResource KpiNumberStyle}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Ritenute da versare" Style="{StaticResource KpiLabelStyle}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Empty state: tutto in regola sui clienti filtrati -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50"
                    Visibility="{Binding HaVisteGenerali, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                <iconPacks:PackIconBootstrapIcons Kind="CheckCircle" Width="34" Height="34"
                    Foreground="{StaticResource BrushStatoAttivo}" HorizontalAlignment="Center"/>
                <TextBlock Text="Tutto in regola." Style="{StaticResource SectionTitleTextStyle}"
                           HorizontalAlignment="Center" Margin="0,10,0,2"/>
                <TextBlock Text="Nessun adempimento in ritardo o da fare adesso, nessuna ritenuta da versare, sui clienti filtrati."
                           Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center"/>
            </StackPanel>

            <Border Grid.Row="1" Margin="28,4,28,20" Style="{StaticResource CardGenerale}"
                    Visibility="{Binding HaVisteGenerali, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding VisteGenerali}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RigaCliccabileGenerale}" Margin="0,0,10,2"
                                    Command="{Binding DataContext.SelezionaVoceGeneraleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="7" Height="7" Margin="0,0,10,0" VerticalAlignment="Center"
                                            Fill="{StaticResource BrushStatoCessato}"
                                            Visibility="{Binding InRitardo, Converter={StaticResource BoolToVisibility}}"/>
                                        <Ellipse Grid.Column="0" Width="7" Height="7" Margin="0,0,10,0" VerticalAlignment="Center"
                                            Fill="{StaticResource BrushStatoAttivo}"
                                            Visibility="{Binding InRitardo, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{StaticResource BrushTestoPrimario}"
                                                TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding ClienteNome, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding Descrizione, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Dettaglio}" FontSize="12"
                                                Foreground="{StaticResource BrushTestoTerziario}" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <iconPacks:PackIconBootstrapIcons Grid.Column="3" Kind="ChevronRight" Width="11" Height="11"
                                            Foreground="{StaticResource BrushTestoTerziario}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- DASHBOARD -->
        <Grid Grid.Row="3" Visibility="{Binding MostraDashboardCliente, Converter={StaticResource BoolToVisibility}}">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding MostraEmptyState, Converter={StaticResource BoolToVisibility}}">
                <iconPacks:PackIconBootstrapIcons Kind="ClipboardData" Width="40" Height="40"
                    Foreground="{StaticResource BrushBordo}" HorizontalAlignment="Center"/>
                <TextBlock Text="Nessuna attività configurata per questo cliente"
                       FontSize="13" FontWeight="Medium" Foreground="{StaticResource BrushTestoPrimario}"
                       HorizontalAlignment="Center" Margin="0,14,0,2"/>
                <TextBlock Text="Scegli come iniziare" FontSize="12" Foreground="{StaticResource BrushTestoSecondario}"
                       HorizontalAlignment="Center" Margin="0,0,0,18"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource BtnOutlineGold}"
                        Command="{Binding ConfiguraAttivitaCommand}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBootstrapIcons Kind="ListCheck" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Configura attività" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnOutline}" Command="{Binding ApriPannelloDuplicaCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBootstrapIcons Kind="Copy" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Duplica da un altro cliente" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HaAttivitaConfigurate, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="28,40,28,24">

                    <!-- KPI flat, stessa fascia della Home: numero+label cliccabili,
                         separatori sottili, niente caselle colorate. -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource KpiButton}"
                                Command="{Binding MostraAdempimentiCommand}" ToolTip="Apri Adempimenti">
                            <StackPanel>
                                <TextBlock Text="{Binding TotaleCompletateAdOggi}" Style="{StaticResource KpiNumberStyle}" HorizontalAlignment="Center"
                                           Foreground="{StaticResource BrushStatoAttivo}"/>
                                <TextBlock Text="Completate ad oggi" Style="{StaticResource KpiLabelStyle}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Rectangle Grid.Column="1" Fill="{StaticResource BrushBordoLeggero}" Margin="0,10"/>

                        <Button Grid.Column="2" Style="{StaticResource KpiButton}"
                                Command="{Binding MostraAdempimentiCommand}" ToolTip="Apri Adempimenti">
                            <StackPanel>
                                <TextBlock Text="{Binding TotaleInCorso}" Style="{StaticResource KpiNumberStyle}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Da fare adesso" Style="{StaticResource KpiLabelStyle}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Rectangle Grid.Column="3" Fill="{StaticResource BrushBordoLeggero}" Margin="0,10"/>

                        <Button Grid.Column="4" Style="{StaticResource KpiButton}"
                                Command="{Binding MostraAdempimentiCommand}" ToolTip="Apri Adempimenti">
                            <StackPanel>
                                <TextBlock Text="{Binding TotaleInRitardo}" Style="{StaticResource KpiNumberStyle}" HorizontalAlignment="Center"
                                           Foreground="{StaticResource BrushStatoCessato}"/>
                                <TextBlock Text="In ritardo" Style="{StaticResource KpiLabelStyle}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Rectangle Grid.Column="5" Fill="{StaticResource BrushBordoLeggero}" Margin="0,10"/>

                        <Button Grid.Column="6" Style="{StaticResource KpiButton}"
                                Command="{Binding MostraRitenuteCommand}" ToolTip="Apri Ritenute d'acconto">
                            <StackPanel>
                                <TextBlock Text="{Binding RitenuteDaVersare}" Style="{StaticResource KpiNumberStyle}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Ritenute da versare" Style="{StaticResource KpiLabelStyle}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- RIGA: Mensili | Trimestrali | Annuali — stesso identico
                         pattern della card "Adempimenti" di Home: titolo, barra
                         segmentata proporzionale, tre contatori. Niente torte. -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardGenerale}">
                            <StackPanel>
                                <TextBlock Text="Mensili" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,12"/>

                                <Grid Visibility="{Binding TortaMensili.Vuoto, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding TortaMensili.PctCompletate, Converter={StaticResource PercentoAGridLength}}"/>
                                        <ColumnDefinition Width="{Binding TortaMensili.PctInCorso, Converter={StaticResource PercentoAGridLength}}"/>
                                        <ColumnDefinition Width="{Binding TortaMensili.PctInRitardo, Converter={StaticResource PercentoAGridLength}}"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Fill="{StaticResource BrushStatoAttivo}" Height="6" RadiusX="3" RadiusY="3"/>
                                    <Rectangle Grid.Column="1" Fill="{StaticResource BrushPrimaryLight}" Height="6" Margin="2,0" RadiusX="3" RadiusY="3"/>
                                    <Rectangle Grid.Column="2" Fill="{StaticResource BrushStatoCessato}" Height="6" RadiusX="3" RadiusY="3"/>
                                </Grid>

                                <Grid Margin="0,12,0,0" Visibility="{Binding TortaMensili.Vuoto, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding TortaMensili.Completate}" Style="{StaticResource ContatoreSecondario}" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource BrushStatoAttivo}"/>
                                        <TextBlock Text="Completate" Style="{StaticResource KpiLabelStyle}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding TortaMensili.InCorso}" Style="{StaticResource ContatoreSecondario}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="In corso" Style="{StaticResource KpiLabelStyle}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding TortaMensili.InRitardo}" Style="{StaticResource ContatoreSecondario}" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource BrushStatoCessato}"/>
                                        <TextBlock Text="In ritardo" Style="{StaticResource KpiLabelStyle}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Nessun adempimento mensile configurato."
                                           Style="{StaticResource SecondaryTextStyle}" Margin="2,4,0,4" TextWrapping="Wrap"
                                           Visibility="{Binding TortaMensili.Vuoto, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardGenerale}">
                            <StackPanel>
                                <TextBlock Text="Trimestrali" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,12"/>

                                <Grid Visibility="{Binding TortaTrimestrali.Vuoto, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding TortaTrimestrali.PctCompletate, Converter={StaticResource PercentoAGridLength}}"/>
                                        <ColumnDefinition Width="{Binding TortaTrimestrali.PctInCorso, Converter={StaticResource PercentoAGridLength}}"/>
                                        <ColumnDefinition Width="{Binding TortaTrimestrali.PctInRitardo, Converter={StaticResource PercentoAGridLength}}"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Fill="{StaticResource BrushStatoAttivo}" Height="6" RadiusX="3" RadiusY="3"/>
                                    <Rectangle Grid.Column="1" Fill="{StaticResource BrushPrimaryLight}" Height="6" Margin="2,0" RadiusX="3" RadiusY="3"/>
                                    <Rectangle Grid.Column="2" Fill="{StaticResource BrushStatoCessato}" Height="6" RadiusX="3" RadiusY="3"/>
                                </Grid>

                                <Grid Margin="0,12,0,0" Visibility="{Binding TortaTrimestrali.Vuoto, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding TortaTrimestrali.Completate}" Style="{StaticResource ContatoreSecondario}" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource BrushStatoAttivo}"/>
                                        <TextBlock Text="Completate" Style="{StaticResource KpiLabelStyle}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding TortaTrimestrali.InCorso}" Style="{StaticResource ContatoreSecondario}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="In corso" Style="{StaticResource KpiLabelStyle}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding TortaTrimestrali.InRitardo}" Style="{StaticResource ContatoreSecondario}" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource BrushStatoCessato}"/>
                                        <TextBlock Text="In ritardo" Style="{StaticResource KpiLabelStyle}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Nessun adempimento trimestrale configurato."
                                           Style="{StaticResource SecondaryTextStyle}" Margin="2,4,0,4" TextWrapping="Wrap"
                                           Visibility="{Binding TortaTrimestrali.Vuoto, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource CardGenerale}">
                            <StackPanel>
                                <TextBlock Text="Annuali" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,12"/>

                                <Grid Visibility="{Binding TortaAnnuali.Vuoto, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding TortaAnnuali.PctCompletate, Converter={StaticResource PercentoAGridLength}}"/>
                                        <ColumnDefinition Width="{Binding TortaAnnuali.PctInCorso, Converter={StaticResource PercentoAGridLength}}"/>
                                        <ColumnDefinition Width="{Binding TortaAnnuali.PctInRitardo, Converter={StaticResource PercentoAGridLength}}"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Fill="{StaticResource BrushStatoAttivo}" Height="6" RadiusX="3" RadiusY="3"/>
                                    <Rectangle Grid.Column="1" Fill="{StaticResource BrushPrimaryLight}" Height="6" Margin="2,0" RadiusX="3" RadiusY="3"/>
                                    <Rectangle Grid.Column="2" Fill="{StaticResource BrushStatoCessato}" Height="6" RadiusX="3" RadiusY="3"/>
                                </Grid>

                                <Grid Margin="0,12,0,0" Visibility="{Binding TortaAnnuali.Vuoto, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding TortaAnnuali.Completate}" Style="{StaticResource ContatoreSecondario}" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource BrushStatoAttivo}"/>
                                        <TextBlock Text="Completate" Style="{StaticResource KpiLabelStyle}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding TortaAnnuali.InCorso}" Style="{StaticResource ContatoreSecondario}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="In corso" Style="{StaticResource KpiLabelStyle}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding TortaAnnuali.InRitardo}" Style="{StaticResource ContatoreSecondario}" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource BrushStatoCessato}"/>
                                        <TextBlock Text="In ritardo" Style="{StaticResource KpiLabelStyle}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Nessun adempimento annuale configurato."
                                           Style="{StaticResource SecondaryTextStyle}" Margin="2,4,0,4" TextWrapping="Wrap"
                                           Visibility="{Binding TortaAnnuali.Vuoto, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- RITENUTE — stesso pattern della card "Fatture" di Home:
                         titolo con caption importi, barra segmentata, tre contatori.
                         Il dettaglio operativo (elenco, azioni) resta nella scheda
                         Ritenute; qui è solo lo stato d'insieme. -->
                    <Border Style="{StaticResource CardGenerale}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <TextBlock Text="Ritenute d'acconto" Style="{StaticResource SectionTitleTextStyle}"/>
                                <TextBlock Style="{StaticResource CaptionSezione}" Margin="10,1,0,0" VerticalAlignment="Bottom">
                                    <Run Text="· Totale"/>
                                    <Run Text="{Binding TotaleRitenuteTesto, Mode=OneWay}"/>
                                    <Run Text=" · Versato"/>
                                    <Run Text="{Binding TotaleVersatoTesto, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>

                            <Grid Visibility="{Binding TortaRitenute.Vuoto, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding TortaRitenute.PctCompletate, Converter={StaticResource PercentoAGridLength}}"/>
                                    <ColumnDefinition Width="{Binding TortaRitenute.PctInCorso, Converter={StaticResource PercentoAGridLength}}"/>
                                    <ColumnDefinition Width="{Binding TortaRitenute.PctInRitardo, Converter={StaticResource PercentoAGridLength}}"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Fill="{StaticResource BrushStatoAttivo}" Height="6" RadiusX="3" RadiusY="3"/>
                                <Rectangle Grid.Column="1" Fill="{StaticResource BrushStatoStandBy}" Height="6" Margin="2,0" RadiusX="3" RadiusY="3"/>
                                <Rectangle Grid.Column="2" Fill="{StaticResource BrushStatoCessato}" Height="6" RadiusX="3" RadiusY="3"/>
                            </Grid>

                            <Grid Margin="0,20,0,0" Visibility="{Binding TortaRitenute.Vuoto, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding RitenuteVersate}" Style="{StaticResource ContatoreSecondario}" HorizontalAlignment="Center"
                                               Foreground="{StaticResource BrushStatoAttivo}"/>
                                    <TextBlock Text="Versate" Style="{StaticResource KpiLabelStyle}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding RitenuteDaVersare}" Style="{StaticResource ContatoreSecondario}" HorizontalAlignment="Center"
                                               Foreground="{StaticResource BrushStatoStandBy}"/>
                                    <TextBlock Text="Da versare" Style="{StaticResource KpiLabelStyle}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding RitenuteAnomalie}" Style="{StaticResource ContatoreSecondario}" HorizontalAlignment="Center"
                                               Foreground="{StaticResource BrushStatoCessato}"/>
                                    <TextBlock Text="Anomalie" Style="{StaticResource KpiLabelStyle}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="{Binding RitenuteNoRavv}" Style="{StaticResource ContatoreSecondario}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Senza ravvedimento" Style="{StaticResource KpiLabelStyle}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Nessuna ritenuta registrata per l'anno selezionato."
                                       Style="{StaticResource SecondaryTextStyle}" Margin="2,4,0,4" TextWrapping="Wrap"
                                       Visibility="{Binding TortaRitenute.Vuoto, Converter={StaticResource BoolToVisibility}}"/>

                            <Button Style="{StaticResource LinkHome}" HorizontalAlignment="Left" Margin="2,12,0,0"
                                Command="{Binding MostraRitenuteCommand}">
                                <TextBlock Text="Apri ritenute d'acconto →"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Note generali -->
                    <!-- Note generali -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="110"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
               Text="NOTE GENERALI SUL CLIENTE"
               Style="{StaticResource FieldLabel}"
               Margin="0,25,0,0"/>

                        <TextBox Grid.Row="1"
             Text="{Binding NotaCliente, UpdateSourceTrigger=LostFocus}"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             Height="100"
             HorizontalAlignment="Stretch"
             VerticalContentAlignment="Top"
             Margin="0,4,0,0"/>
                    </Grid>
                </StackPanel>

            </ScrollViewer>
        </Grid>

        <!-- ADEMPIMENTI -->
        <Grid Grid.Row="3" Visibility="{Binding MostraAdempimenti, Converter={StaticResource BoolToVisibility}}">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding MostraEmptyState, Converter={StaticResource BoolToVisibility}}">
                <iconPacks:PackIconBootstrapIcons Kind="ClipboardData" Width="40" Height="40"
                    Foreground="{StaticResource BrushBordo}" HorizontalAlignment="Center"/>
                <TextBlock Text="Nessuna attività configurata per questo cliente"
                       FontSize="13" FontWeight="Medium" Foreground="{StaticResource BrushTestoPrimario}"
                       HorizontalAlignment="Center" Margin="0,14,0,2"/>
                <TextBlock Text="Scegli come iniziare" FontSize="12" Foreground="{StaticResource BrushTestoSecondario}"
                       HorizontalAlignment="Center" Margin="0,0,0,18"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource BtnOutlineGold}"
                        Command="{Binding ConfiguraAttivitaCommand}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBootstrapIcons Kind="ListCheck" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Configura attività" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnOutline}" Command="{Binding ApriPannelloDuplicaCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBootstrapIcons Kind="Copy" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Duplica da un altro cliente" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <Grid Visibility="{Binding HaAttivitaConfigurate, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20,24,24">

                        <!-- Ricerca (nome, mese o stato) -->
                        <Border MaxWidth="360" HorizontalAlignment="Left" Background="White" Margin="0,0,0,18"
                            BorderBrush="{StaticResource BrushBordo}" BorderThickness="1" CornerRadius="6" Height="34">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconBootstrapIcons Grid.Column="0"
                                    Kind="Search" Width="13" Height="13" Foreground="{StaticResource BrushTestoSecondario}"
                                    Margin="10,0,6,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                     Text="{Binding FiltroAttivitaTesto, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent"
                                     FontSize="13" Foreground="{StaticResource BrushTestoPrimario}"
                                     VerticalContentAlignment="Center" Height="32" Width="250"
                                     mah:TextBoxHelper.Watermark="  Cerca per attività, mese o stato…"/>
                            </Grid>
                        </Border>

                        <!-- MENSILI -->
                        <StackPanel Visibility="{Binding HaRigheMensili, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,20">
                            <ToggleButton Style="{StaticResource AdpSezioneHeader}" Content="MENSILI"
                                  IsChecked="{Binding SezioneMensiliEspansa}"
                                  BorderBrush="{Binding StatoSezioneMensili, Converter={StaticResource StatoAColore}}"/>
                            <ItemsControl ItemsSource="{Binding RigheMensiliFiltrate}"
                                          ItemTemplate="{StaticResource RigaAttivitaTemplateV2}"
                                          Visibility="{Binding SezioneMensiliEspansa, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>

                        <!-- TRIMESTRALI -->
                        <StackPanel Visibility="{Binding HaRigheTrimestrali, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,20">
                            <ToggleButton Style="{StaticResource AdpSezioneHeader}" Content="TRIMESTRALI"
                                  IsChecked="{Binding SezioneTrimestraliEspansa}"
                                  BorderBrush="{Binding StatoSezioneTrimestrali, Converter={StaticResource StatoAColore}}"/>
                            <ItemsControl ItemsSource="{Binding RigheTrimestraliFiltrate}"
                                          ItemTemplate="{StaticResource RigaAttivitaTemplateV2}"
                                          Visibility="{Binding SezioneTrimestraliEspansa, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>

                        <!-- ANNUALI -->
                        <StackPanel Visibility="{Binding HaRigheAnnuali, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,24">
                            <ToggleButton Style="{StaticResource AdpSezioneHeader}" Content="ANNUALI"
                                  IsChecked="{Binding SezioneAnnualiEspansa}"
                                  BorderBrush="{Binding StatoSezioneAnnuali, Converter={StaticResource StatoAColore}}"/>
                            <ItemsControl ItemsSource="{Binding RigheAnnualiFiltrate}"
                                          ItemTemplate="{StaticResource RigaAttivitaTemplateV2}"
                                          Visibility="{Binding SezioneAnnualiEspansa, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- RITENUTE D'ACCONTO -->
        <Grid Grid.Row="3" Visibility="{Binding MostraRitenute, Converter={StaticResource BoolToVisibility}}">

            <Grid Visibility="{Binding NessunClienteSelezionato, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- KPI anno (indipendenti dai filtri lista) -->
                <Border Grid.Row="0" MaxWidth="560" HorizontalAlignment="Left"
                        Background="White" BorderBrush="{StaticResource BrushBordoLeggero}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMedium}" Padding="18,12" Margin="28,16,28,0">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TOTALE" FontSize="10" FontWeight="Medium"
                                       Foreground="{StaticResource BrushTestoSecondario}"/>
                            <TextBlock Text="{Binding TotaleRitenuteTesto}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTestoPrimario}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Rectangle Width="1" Height="26" Fill="{StaticResource BrushBordoLeggero}"
                                   Margin="24,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="VERSATO" FontSize="10" FontWeight="Medium"
                                       Foreground="{StaticResource BrushTestoSecondario}"/>
                            <TextBlock Text="{Binding TotaleVersatoTesto}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushStatoAttivo}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Rectangle Width="1" Height="26" Fill="{StaticResource BrushBordoLeggero}"
                                   Margin="24,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="RESIDUO" FontSize="10" FontWeight="Medium"
                                       Foreground="{StaticResource BrushTestoSecondario}"/>
                            <TextBlock Text="{Binding ResiduoRitenuteTesto}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushPrimary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Rectangle Width="1" Height="26" Fill="{StaticResource BrushBordoLeggero}"
                                   Margin="24,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ANOMALIE" FontSize="10" FontWeight="Medium"
                                       Foreground="{StaticResource BrushTestoSecondario}"/>
                            <TextBlock Text="{Binding RitenuteAnomalie}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushDanger}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Filtri + ricerca + nuova -->
                <Grid Grid.Row="1" Margin="28,10,28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource BrushSfondoFine}"
                            CornerRadius="{StaticResource RadiusSmall}" Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Tutte" Style="{StaticResource ChipRitenuteTutte}"
                                    Command="{Binding ImpostaFiltroStatoRitenuteCommand}" CommandParameter="Tutte"/>
                            <Button Content="Da versare" Style="{StaticResource ChipRitenuteDaVersare}"
                                    Command="{Binding ImpostaFiltroStatoRitenuteCommand}" CommandParameter="Da versare"/>
                            <Button Content="Versate" Style="{StaticResource ChipRitenuteVersate}"
                                    Command="{Binding ImpostaFiltroStatoRitenuteCommand}" CommandParameter="Versate"/>
                            <Button Content="Anomalie" Style="{StaticResource ChipRitenuteAnomalie}"
                                    Command="{Binding ImpostaFiltroStatoRitenuteCommand}" CommandParameter="Anomalie"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="2" Style="{StaticResource ChipFiltro}"
                            Command="{Binding AzzeraFiltriRitenuteCommand}" ToolTip="Rimuove i filtri"
                            Visibility="{Binding HaFiltriRitenuteAttivi, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBootstrapIcons Kind="Eraser" Width="11" Height="11"
                                Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Azzera filtri" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Grid.Column="3" Width="250" Height="32" Background="White" Margin="0,0,10,0"
                            BorderBrush="{StaticResource BrushBordo}" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconBootstrapIcons Grid.Column="0" Kind="Search" Width="13" Height="13"
                                Foreground="{StaticResource BrushTestoSecondario}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Margin="0,0,5,0"
                                Text="{Binding FiltroRitenuteTesto, UpdateSourceTrigger=PropertyChanged}"
                                BorderThickness="0" Background="Transparent" FontSize="12"
                                Foreground="{StaticResource BrushTestoPrimario}"
                                VerticalContentAlignment="Center"
                                mah:TextBoxHelper.Watermark="  Cerca intestazione o n. fattura…"/>
                            <Button Grid.Column="2" Style="{StaticResource AzioneGriglia}" Width="22" Height="22"
                                Margin="0,0,4,0" Click="CancellaRicercaRitenute_Click" ToolTip="Cancella ricerca"
                                Visibility="{Binding FiltroRitenuteTesto, Converter={StaticResource BoolToVisibility}}">
                                <iconPacks:PackIconBootstrapIcons Kind="XLg" Width="10" Height="10"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Button Grid.Column="4" Style="{StaticResource BtnPrimary}" Height="32" MinWidth="118" Padding="12,0"
                            Command="{Binding NuovaRitenutaCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBootstrapIcons Kind="Plus" Width="11" Height="11"
                                Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Nuova ritenuta" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <DataGrid Grid.Row="2" x:Name="gridRitenute" ItemsSource="{Binding RitenuteFiltrate}"
                          Style="{StaticResource ModuleDataGridStyle}"
                          AlternationCount="2"
                          RowHeight="44" Margin="28,12,28,0"
                          MouseDoubleClick="gridRitenute_MouseDoubleClick">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModuleDataGridColumnHeaderStyle}"/>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource ModuleDataGridRowClickableSelectedStyle}"/>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="INTESTAZIONE" Binding="{Binding Intestazione}" Width="1.3*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="14,0"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="N. FATTURA" Binding="{Binding NumeroFattura}" Width="0.9*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="14,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="EMISSIONE" Binding="{Binding DataFattura, StringFormat=dd/MM/yyyy}" Width="0.85*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="14,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="PAG. FATTURA" Binding="{Binding DataPagamentoFattura, StringFormat=dd/MM/yyyy}" Width="0.9*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="14,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="IMPORTO R.A." Binding="{Binding ImportoRitenuta, StringFormat='€ {0:N2}'}" Width="0.9*">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModuleDataGridColumnHeaderStyle}">
                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="14,0"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="14,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="PAG. R.A." Binding="{Binding ScadenzaVersamento, StringFormat=dd/MM/yyyy}" Width="0.85*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="14,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="VERSATO" Binding="{Binding ImportoVersato, StringFormat='€ {0:N2}'}" Width="0.85*">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModuleDataGridColumnHeaderStyle}">
                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="14,0"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="14,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="RAVV." Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Style="{StaticResource ModuleCheckBoxStyle}"
                                              IsChecked="{Binding Ravvedimento, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleRavvedimentoRitenutaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"
                                              ToolTip="Ravvedimento"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="STATO" Width="1.15*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                        <local:StatusBadgeControl Stato="{Binding StatoVersamento}"/>
                                        <iconPacks:PackIconBootstrapIcons Kind="ExclamationTriangleFill"
                                            Width="11" Height="11" Foreground="{StaticResource BrushDanger}" Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HaAnomalieData, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="{Binding DettaglioAnomalieData}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Style="{StaticResource AzioneGrigliaPagata}"
                                            Command="{Binding DataContext.VersataOggiRitenutaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="Segna versata oggi, per l'intero importo"
                                            Visibility="{Binding Versato, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                                            <iconPacks:PackIconBootstrapIcons Kind="CheckCircle" Width="12" Height="12"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>
                                        <Button Style="{StaticResource AzioneGriglia}" Margin="2,0,0,0"
                                            Command="{Binding DataContext.ModificaRitenutaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="Modifica">
                                            <iconPacks:PackIconBootstrapIcons Kind="Pencil" Width="12" Height="12"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>
                                        <Button Style="{StaticResource AzioneGrigliaElimina}" Margin="2,0,0,0"
                                            Command="{Binding DataContext.EliminaRitenutaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="Elimina">
                                            <iconPacks:PackIconBootstrapIcons Kind="Trash" Width="12" Height="12"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="3" Margin="28,8,28,24" HorizontalAlignment="Center"
                    Visibility="{Binding HaRitenuteFiltrate, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                    <TextBlock Text="{Binding EmptyRitenuteTesto}" FontSize="14"
                        Foreground="{StaticResource BrushTestoSecondario}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <local:ModalDialogControl
                IsAperto="{Binding PannelloRitenutaAperto}"
                Titolo="{Binding TitoloPannelloRitenuta}"
                ComandoChiudi="{Binding AnnullaRitenutaCommand}"
                ComandoSalva="{Binding SalvaRitenutaCommand}"
                LarghezzaExtra="720">
                <local:ModalDialogControl.Contenuto>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="INTESTAZIONE" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding FormIntestazione, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="NUMERO FATTURA" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding FormNumeroFattura, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                                <TextBlock Text="DATA FATTURA" Style="{StaticResource FieldLabel}"/>
                                <DatePicker SelectedDate="{Binding FormDataFattura}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                                <Grid Height="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="DATA PAGAMENTO FATTURA" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0"
                                            Command="{Binding PulisciDataPagamentoFatturaCommand}" ToolTip="Svuota"
                                            Visibility="{Binding FormDataPagamentoFattura, Converter={StaticResource BoolToVisibility}}">
                                        <iconPacks:PackIconBootstrapIcons Kind="XLg" Width="10" Height="10"
                                            Foreground="{StaticResource BrushTestoSecondario}"/>
                                    </Button>
                                </Grid>
                                <DatePicker SelectedDate="{Binding FormDataPagamentoFattura}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,14,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="IMPORTO RITENUTA" Style="{StaticResource FieldLabel}"/>
                                <Border BorderBrush="{StaticResource BrushBordo}" BorderThickness="1" CornerRadius="5" Height="34" Margin="0,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource BrushSfondoChiaro}" CornerRadius="4,0,0,4" Padding="10,0">
                                            <TextBlock Text="€" Foreground="{StaticResource BrushTestoSecondario}" VerticalAlignment="Center" FontSize="12"/>
                                        </Border>
                                        <TextBox Grid.Column="1" BorderThickness="0" TextAlignment="Right" Padding="8,0"
                                                 Text="{Binding FormImportoRitenuta, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <Grid Height="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="DATA PAGAMENTO RITENUTA" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0"
                                            Command="{Binding PulisciDataPagamentoRitenutaCommand}" ToolTip="Svuota"
                                            Visibility="{Binding FormScadenzaVersamento, Converter={StaticResource BoolToVisibility}}">
                                        <iconPacks:PackIconBootstrapIcons Kind="XLg" Width="10" Height="10"
                                            Foreground="{StaticResource BrushTestoSecondario}"/>
                                    </Button>
                                </Grid>
                                <DatePicker SelectedDate="{Binding FormScadenzaVersamento}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                                <Grid Height="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="IMPORTO VERSATO" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0"
                                            Command="{Binding SegnaVersatoInteroCommand}"
                                            ToolTip="Imposta l'importo versato pari alla ritenuta e la data di pagamento di oggi">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconBootstrapIcons Kind="CheckCircle" Width="10" Height="10"
                                                Foreground="{StaticResource BrushStatoAttivo}" Margin="0,2,4,0"/>
                                            <TextBlock Text="Segna versato oggi" FontSize="10" FontWeight="Medium"
                                                       Foreground="{StaticResource BrushStatoAttivo}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" BorderBrush="{StaticResource BrushBordo}" BorderThickness="1" CornerRadius="5" Height="34">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{StaticResource BrushSfondoChiaro}" CornerRadius="4,0,0,4" Padding="10,0">
                                                <TextBlock Text="€" Foreground="{StaticResource BrushTestoSecondario}" VerticalAlignment="Center" FontSize="12"/>
                                            </Border>
                                            <TextBox Grid.Column="1" BorderThickness="0" TextAlignment="Right" Padding="8,0"
                                                     Text="{Binding FormImportoVersato, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                        </Grid>
                                    </Border>
                                    <Button Grid.Column="1" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0"
                                            Margin="8,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding PulisciImportoVersatoCommand}" ToolTip="Svuota"
                                            Visibility="{Binding FormImportoVersato, Converter={StaticResource BoolToVisibility}}">
                                        <iconPacks:PackIconBootstrapIcons Kind="XLg" Width="10" Height="10"
                                            Foreground="{StaticResource BrushTestoSecondario}"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0"
            Orientation="Horizontal"
            Margin="0,24,0,0"
            VerticalAlignment="Center">

                                <CheckBox Style="{StaticResource ModuleCheckBoxStyle}"
              IsChecked="{Binding FormRavvedimento}"
              VerticalAlignment="Center" Margin="0,0,8,4"/>
 
                                <TextBlock Text="RAVVEDIMENTO"
               Style="{StaticResource FieldLabel}"
               VerticalAlignment="Center"/>
               
                            </StackPanel>

                        </Grid>
                    </StackPanel>
                </local:ModalDialogControl.Contenuto>
            </local:ModalDialogControl>
        </Grid>

        <!-- OVERLAY DUPLICA -->
        <Border Grid.Row="0" Grid.RowSpan="4" Style="{StaticResource OverlayScuroStyle}"
            Visibility="{Binding PannelloDuplicaAperto, Converter={StaticResource BoolToVisibility}}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding AnnullaDuplicaCommand}"/>
            </Border.InputBindings>
        </Border>

        <!-- PANNELLO DUPLICA -->
        <Border Grid.Row="0" Grid.RowSpan="4" Width="380" HorizontalAlignment="Right"
            Style="{StaticResource PanelLateraleStyle}"
            Visibility="{Binding PannelloDuplicaAperto, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Duplica attività" Style="{StaticResource ModuleTitleStyle}"/>
                        <Button Grid.Column="1" Style="{StaticResource BtnIconGhost}"
                            Command="{Binding AnnullaDuplicaCommand}" ToolTip="Chiudi" VerticalAlignment="Top">
                            <iconPacks:PackIconBootstrapIcons Kind="XLg" Width="14" Height="14"
                            Foreground="{StaticResource BrushTestoSecondario}"/>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,16">

                        <TextBlock Text="DUPLICA DA" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding ClientiDuplicabili}"
                              TextSearch.TextPath="RagioneSociale"
                              SelectedItem="{Binding ClienteSorgenteSelezionato}"
                              Margin="0,4,0,16"/>

                        <StackPanel Visibility="{Binding ClienteSorgenteSelezionato, Converter={StaticResource BoolToVisibility}}">

                            <TextBlock Text="VERRANNO ASSEGNATE" Style="{StaticResource FieldLabel}"/>
                            <ItemsControl ItemsSource="{Binding AttivitaAssegnate}" Margin="0,4,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushSfondoChiaro}" CornerRadius="4"
                                            Padding="10,7" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Nome}" FontSize="12"
                                                           Foreground="{StaticResource BrushTestoPrimario}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding Periodicita}" FontSize="10"
                                                               Foreground="{StaticResource BrushTestoSecondario}"
                                                               Background="White" Padding="6,2" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding TipoCampo, Converter={StaticResource TipoCampoLabel}}"
                                                               FontSize="10" Foreground="{StaticResource BrushTestoSecondario}"
                                                               Background="White" Padding="6,2"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Padding="4"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.RimuoviDaAssegnateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" ToolTip="Non assegnare">
                                                    <iconPacks:PackIconBootstrapIcons Kind="Dash" Width="11" Height="11"
                                                    Foreground="{StaticResource BrushTestoSecondario}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="NON VERRANNO ASSEGNATE" Style="{StaticResource FieldLabel}"/>
                            <ItemsControl ItemsSource="{Binding AttivitaNonAssegnate}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushSfondoChiaro}" CornerRadius="4"
                                            Padding="10,7" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Nome}" FontSize="12"
                                                           Foreground="{StaticResource BrushTestoSecondario}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding Periodicita}" FontSize="10"
                                                               Foreground="{StaticResource BrushTestoSecondario}"
                                                               Background="White" Padding="6,2" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding TipoCampo, Converter={StaticResource TipoCampoLabel}}"
                                                               FontSize="10" Foreground="{StaticResource BrushTestoSecondario}"
                                                               Background="White" Padding="6,2"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Padding="4"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.AggiungiAdAssegnateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" ToolTip="Assegna">
                                                    <iconPacks:PackIconBootstrapIcons Kind="Plus" Width="11" Height="11"
                                                    Foreground="{StaticResource BrushTestoSecondario}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="{StaticResource BrushBordo}" BorderThickness="0,1,0,0" Padding="22,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Salva" Command="{Binding SalvaDuplicaCommand}"
                            Style="{StaticResource BtnPrimary}" HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="2" Content="Annulla" Command="{Binding AnnullaDuplicaCommand}"
                            Style="{StaticResource BtnOutline}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
