                            <TextBlock Text="Duplica da un altro cliente" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <Grid Visibility="{Binding HaAttivitaConfigurate, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,40,20,24">

                        <!-- Filtro testuale + eventuale filtro "solo ritardi" (navigazione contestuale) -->
