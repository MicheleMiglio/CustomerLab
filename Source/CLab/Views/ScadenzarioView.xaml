                            <Border Width="280" Background="White"
                                BorderBrush="{StaticResource BrushBordo}" BorderThickness="1" CornerRadius="6" Height="34">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconBootstrapIcons Grid.Column="0"
                                    Kind="Search" Width="13" Height="13" Foreground="{StaticResource BrushTestoSecondario}"
                                    Margin="10,0,6,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1"
                                         Text="{Binding FiltroAttivitaTesto, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent"
                                         FontSize="13" Foreground="{StaticResource BrushTestoPrimario}"
                                         VerticalContentAlignment="Center" Height="32"
                                         mah:TextBoxHelper.Watermark="Cerca attività…"/>
                                </Grid>
                            </Border>

                            <!-- Chip filtro attivo: click = torna a vedere tutte le righe -->
                            <Button Margin="10,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                                Command="{Binding RimuoviSoloRitardiCommand}"
                                Visibility="{Binding SoloRitardi, Converter={StaticResource BoolToVisibility}}"
                                Background="{StaticResource BrushAccentSelected}" BorderThickness="0" Padding="10,5">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Solo ritardi" FontSize="11" FontWeight="Medium"
                                                    Foreground="{StaticResource BrushTestoPrimario}" VerticalAlignment="Center"/>
                                                <iconPacks:PackIconBootstrapIcons Kind="XLg" Width="9" Height="9"
                                                    Foreground="{StaticResource BrushTestoPrimario}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- FASE 8: cambio modalità Griglia / Elenco -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="VISUALIZZAZIONE" FontSize="9" FontWeight="Bold"
                                Foreground="{StaticResource BrushTestoSecondario}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="Griglia" Command="{Binding MostraGrigliaCommand}" Margin="0,0,14,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TabUnderlineButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MostraGriglia}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Elenco" Command="{Binding MostraElencoCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TabUnderlineButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MostraElenco}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <!-- FASE 8: area griglia (matrice periodi), visibile solo in modalità Griglia -->
                        <StackPanel Visibility="{Binding MostraGriglia, Converter={StaticResource BoolToVisibility}}">

                        <!-- MENSILI -->
                        <StackPanel Visibility="{Binding HaRigheMensili, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,10">
                            <Button Command="{Binding ToggleSezioneMensiliCommand}" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconBootstrapIcons Width="10" Height="10" Foreground="{StaticResource BrushTestoSecondario}" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <iconPacks:PackIconBootstrapIcons.Style>
                                                    <Style TargetType="iconPacks:PackIconBootstrapIcons" BasedOn="{StaticResource ChevronSezioneStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SezioneMensiliEspansa}" Value="True">
                                                                <Setter Property="Kind" Value="ChevronDown"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </iconPacks:PackIconBootstrapIcons.Style>
                                            </iconPacks:PackIconBootstrapIcons>
                                            <TextBlock Text="MENSILI" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushTestoSecondario}" VerticalAlignment="Center"/>
