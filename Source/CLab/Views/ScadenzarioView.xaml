<UserControl x:Class="CLab.Views.ScadenzarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:converters="clr-namespace:CLab.Converters"
             xmlns:local="clr-namespace:CLab.Views">

    <UserControl.Resources>
        <converters:TipoCampoLabelConverter x:Key="TipoCampoLabel"/>
        <!-- FASE 2: badge semantico unificato (chiavi locali invariate per i binding esistenti) -->
        <converters:StatoSemanticoForeConverter x:Key="StatoAColore"/>
        <converters:StatoSemanticoBackConverter x:Key="StatoASfondo"/>
        <converters:StatoSemanticoForeConverter x:Key="VersatoAColore"/>
        <converters:StatoSemanticoTestoConverter x:Key="StatoVersamentoTesto"/>
        <converters:StatoSemanticoForeConverter x:Key="StatoVersamentoAColore"/>

        <!-- Chip filtro (segmented): stesso pattern locale di Fatture/Clienti. -->
        <Style x:Key="ChipFiltro" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushHoverNeutro}"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="Sel"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushSidebarSelectedBadge}"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChipStatoAttivi" TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FiltroStatoCliente}" Value="Attivi">
                    <Setter Property="Tag" Value="Sel"/>
                    <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChipStatoStandBy" TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FiltroStatoCliente}" Value="Stand by">
                    <Setter Property="Tag" Value="Sel"/>
                    <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChipStatoCessati" TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FiltroStatoCliente}" Value="Cessati">
                    <Setter Property="Tag" Value="Sel"/>
                    <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChipStatoTutti" TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FiltroStatoCliente}" Value="Tutti">
                    <Setter Property="Tag" Value="Sel"/>
                    <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChipRitenuteTutte" TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FiltroStatoRitenute}" Value="Tutte">
                    <Setter Property="Tag" Value="Sel"/>
                    <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChipRitenuteDaVersare" TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FiltroStatoRitenute}" Value="Da versare">
                    <Setter Property="Tag" Value="Sel"/>
                    <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChipRitenuteVersate" TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FiltroStatoRitenute}" Value="Versate">
                    <Setter Property="Tag" Value="Sel"/>
                    <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChipRitenuteAnomalie" TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FiltroStatoRitenute}" Value="Anomalie">
                    <Setter Property="Tag" Value="Sel"/>
                    <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AzioneGriglia" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushHoverNeutro}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AzioneGrigliaElimina" TargetType="Button" BasedOn="{StaticResource AzioneGriglia}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrushStatoCessato}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="RigaAttivitaTemplate">
            <Border Background="White" BorderBrush="{StaticResource BrushBordo}" BorderThickness="1"
                CornerRadius="8" Margin="0,0,0,8">
                <StackPanel>
                    <Button Command="{Binding ToggleEspansaCommand}" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="16,13">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <iconPacks:PackIconBootstrapIcons Grid.Column="0" Width="12" Height="12"
                                            Foreground="{StaticResource BrushTestoSecondario}" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <iconPacks:PackIconBootstrapIcons.Style>
                                                <Style TargetType="iconPacks:PackIconBootstrapIcons">
                                                    <Setter Property="Kind" Value="ChevronRight"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Espansa}" Value="True">
                                                            <Setter Property="Kind" Value="ChevronDown"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </iconPacks:PackIconBootstrapIcons.Style>
                                        </iconPacks:PackIconBootstrapIcons>
                                        <TextBlock Grid.Column="1" Text="{Binding Nome}" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushTestoPrimario}" TextTrimming="CharacterEllipsis"/>
                                        <!-- FASE 6: tipo di compilazione attesa (informazione già disponibile) -->
                                        <TextBlock Grid.Column="2" Text="{Binding TipoCampo, Converter={StaticResource TipoCampoLabel}}" FontSize="10"
                                               Foreground="{StaticResource BrushTestoSecondario}" Margin="8,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                        <Ellipse Grid.Column="3" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"
                                             Fill="{Binding StatoRiepilogo, Converter={StaticResource StatoAColore}}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding TestoRiepilogo}" FontSize="11"
                                               Foreground="{StaticResource BrushTestoSecondario}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- FASE 6: fila pillole SEMPRE visibile — la matrice dei periodi.
                         Click sulla pill = seleziona ed espande la compilazione;
                         ✓ = compilazione rapida Sì/No (stesso percorso di persistenza). -->
                    <ItemsControl ItemsSource="{Binding Pillole}" Margin="16,0,12,10" HorizontalAlignment="Right"
                              Visibility="{Binding Pillole.Count, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,4,0">
                                    <Button Command="{Binding SelezionaCommand}" CommandParameter="{Binding Indice}"
                                        Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" CornerRadius="5" Width="46" BorderThickness="1.5"
                                                    Background="{Binding StatoColore, Converter={StaticResource StatoASfondo}}">
                                                    <TextBlock Text="{Binding Etichetta}" FontSize="11" TextAlignment="Center" Padding="0,4"
                                                        Foreground="{Binding StatoColore, Converter={StaticResource StatoAColore}}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Selezionato}" Value="True">
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Selezionato}" Value="False">
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="Transparent"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Toggle compilazione rapida Sì/No (sopra la pill, a destra) -->
                                    <Button Command="{Binding ToggleRapidoCommand}" Cursor="Hand" Focusable="False"
                                        BorderThickness="0" Background="Transparent" Padding="0"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"
                                        Visibility="{Binding MostraToggleRapido, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="Compilazione rapida Sì/No">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="tg" CornerRadius="4" Padding="4,1" Background="Transparent">
                                                    <TextBlock Text="✓" FontSize="10" FontWeight="Bold" TextAlignment="Center"
                                                        Foreground="{Binding StatoColore, Converter={StaticResource StatoAColore}}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="tg" Property="Background" Value="{StaticResource BrushAccentHover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding Espansa, Converter={StaticResource BoolToVisibility}}">
                        <Border BorderBrush="{StaticResource BrushBordo}" BorderThickness="0,1,0,0">
                            <Border BorderThickness="3,0,0,0"
                                BorderBrush="{Binding CellaSelezionata.Stato, Converter={StaticResource StatoAColore}}"
                                Background="{StaticResource BrushSfondoChiaro}">
                                <StackPanel Margin="16,16,16,20">

                                    <!-- FASE 6: le pillole sono ora sempre visibili nella matrice sopra -->

                                    <local:CellaCompilazioneControl DataContext="{Binding CellaSelezionata}"/>

                                </StackPanel>
                            </Border>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="ChevronSezioneStyle" TargetType="iconPacks:PackIconBootstrapIcons">
            <Setter Property="Kind" Value="ChevronRight"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER: titolo + tab + YearNavigator (pattern Fatture) -->
        <Border Grid.Row="0" Style="{StaticResource ModuleHeaderBorderStyle}" Padding="28,0" Height="64">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Scadenzario" Style="{StaticResource ModuleTitleStyle}"
                           VerticalAlignment="Center" Margin="0,0,24,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Dashboard" Command="{Binding MostraDashboardCommand}"
                        Margin="0,0,16,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabUnderlineButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MostraDashboard}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Adempimenti" Command="{Binding MostraAdempimentiCommand}"
                        Margin="0,0,16,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabUnderlineButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MostraAdempimenti}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Ritenute d'acconto" Command="{Binding MostraRitenuteCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabUnderlineButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MostraRitenute}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <local:YearNavigatorControl Grid.Column="3" HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Anno="{Binding AnnoSelezionato}"
                                            ComandoPrecedente="{Binding AnnoPrecedenteCommand}"
                                            ComandoSuccessivo="{Binding AnnoSuccessivoCommand}"/>
            </Grid>
        </Border>

        <!-- BARRA CONTESTO: ciclo vita + referente + cliente -->
        <Grid Grid.Row="1" Margin="28,10,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BrushSfondoFine}"
                    CornerRadius="{StaticResource RadiusSmall}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Attivi" Style="{StaticResource ChipStatoAttivi}"
                            Command="{Binding ImpostaFiltroStatoClienteCommand}" CommandParameter="Attivi"/>
                    <Button Content="Stand by" Style="{StaticResource ChipStatoStandBy}"
                            Command="{Binding ImpostaFiltroStatoClienteCommand}" CommandParameter="Stand by"/>
                    <Button Content="Cessati" Style="{StaticResource ChipStatoCessati}"
                            Command="{Binding ImpostaFiltroStatoClienteCommand}" CommandParameter="Cessati"/>
                    <Button Content="Tutti" Style="{StaticResource ChipStatoTutti}"
                            Command="{Binding ImpostaFiltroStatoClienteCommand}" CommandParameter="Tutti"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Referente" Style="{StaticResource FieldLabel}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Width="180" Height="32" Margin="0,0,16,0"
                          IsTextSearchEnabled="True" TextSearch.TextPath="Nome"
                          ItemsSource="{Binding ReferentiFiltro}"
                          SelectedItem="{Binding ReferenteFiltro}"
                          mah:TextBoxHelper.Watermark="Tutti i referenti"/>
                <TextBlock Text="Cliente" Style="{StaticResource FieldLabel}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Width="240" Height="32" Margin="0,0,10,0"
                          IsTextSearchEnabled="True"
                          TextSearch.TextPath="RagioneSociale"
                          ItemsSource="{Binding ClientiDisponibili}"
                          SelectedItem="{Binding ClienteSelezionato}"
                          mah:TextBoxHelper.Watermark="Seleziona un cliente"/>
                <local:StatusBadgeControl Stato="{Binding ClienteSelezionato.Stato}"
                    VerticalAlignment="Center"
                    Visibility="{Binding NessunClienteSelezionato, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Padding="28,8,28,8"
                Visibility="{Binding MostraAvvisoClienteNonAttivo, Converter={StaticResource BoolToVisibility}}">
            <Border CornerRadius="{StaticResource RadiusSmall}" Padding="12,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource BrushStatoStandByLight}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AvvisoClienteCessato}" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrushStatoCessatoLight}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconBootstrapIcons Kind="InfoCircle" Width="12" Height="12"
                        Margin="0,0,8,0" VerticalAlignment="Center">
                        <iconPacks:PackIconBootstrapIcons.Style>
                            <Style TargetType="iconPacks:PackIconBootstrapIcons">
                                <Setter Property="Foreground" Value="{StaticResource BrushStatoStandBy}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AvvisoClienteCessato}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource BrushStatoCessato}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </iconPacks:PackIconBootstrapIcons.Style>
                    </iconPacks:PackIconBootstrapIcons>
                    <TextBlock Text="{Binding TestoAvvisoClienteNonAttivo}" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource BrushStatoStandBy}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AvvisoClienteCessato}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource BrushStatoCessato}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Border>

        <!-- DASHBOARD -->
        <Grid Grid.Row="3" Visibility="{Binding MostraDashboard, Converter={StaticResource BoolToVisibility}}">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding NessunClienteSelezionato, Converter={StaticResource BoolToVisibility}}">
                <iconPacks:PackIconBootstrapIcons Kind="PersonWorkspace" Width="40" Height="40"
                    Foreground="{StaticResource BrushBordo}" HorizontalAlignment="Center"/>
                <TextBlock Text="Seleziona un cliente e un anno per iniziare"
                       FontSize="13" FontWeight="Medium" Foreground="{StaticResource BrushTestoPrimario}"
                       HorizontalAlignment="Center" Margin="0,14,0,2"/>
                <TextBlock Text="Troverai qui adempimenti, scadenze e ritenute d'acconto"
                       FontSize="12" Foreground="{StaticResource BrushTestoSecondario}" HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding MostraEmptyState, Converter={StaticResource BoolToVisibility}}">
                <iconPacks:PackIconBootstrapIcons Kind="ClipboardData" Width="40" Height="40"
                    Foreground="{StaticResource BrushBordo}" HorizontalAlignment="Center"/>
                <TextBlock Text="Nessuna attività configurata per questo cliente"
                       FontSize="13" FontWeight="Medium" Foreground="{StaticResource BrushTestoPrimario}"
                       HorizontalAlignment="Center" Margin="0,14,0,2"/>
                <TextBlock Text="Scegli come iniziare" FontSize="12" Foreground="{StaticResource BrushTestoSecondario}"
                       HorizontalAlignment="Center" Margin="0,0,0,18"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource BtnOutlineGold}"
                        Command="{Binding ConfiguraAttivitaCommand}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBootstrapIcons Kind="ListCheck" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Configura attività" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnOutline}" Command="{Binding ApriPannelloDuplicaCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBootstrapIcons Kind="Copy" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Duplica da un altro cliente" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HaAttivitaConfigurate, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="28,40,28,24">

                    <TextBlock Text="STATO ADEMPIMENTI" Style="{StaticResource FieldLabel}" Margin="0,0,0,10"/>
                    <UniformGrid Rows="1" Columns="3" Margin="0,0,0,16">

                        <Border Background="White" BorderBrush="{StaticResource BrushBordo}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,10,0">
                            <StackPanel HorizontalAlignment="Center">
                                <local:TortaStatoControl Width="120" Height="120"
                                    FettaCompletate="{Binding TortaMensili.FettaCompletate}"
                                    FettaInCorso="{Binding TortaMensili.FettaInCorso}"
                                    FettaInRitardo="{Binding TortaMensili.FettaInRitardo}"
                                    Vuoto="{Binding TortaMensili.Vuoto}"
                                    TestoCentro="{Binding CompletamentoMensiliTesto}"/>
                                <TextBlock Text="MENSILI" FontSize="10" FontWeight="Medium" Foreground="{StaticResource BrushTestoSecondario}"
                                       HorizontalAlignment="Center" Margin="0,10,0,10"/>
                                <StackPanel>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="8" Height="8" Background="{StaticResource BrushSuccess}" CornerRadius="2" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1" Text="Completate" FontSize="10" Foreground="{StaticResource BrushTestoSecondario}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TortaMensili.Completate}" FontSize="10" FontWeight="Medium" Foreground="{StaticResource BrushTestoPrimario}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="8" Height="8" Background="{StaticResource BrushPrimary}" CornerRadius="2" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1" Text="Da fare ad oggi" FontSize="10" Foreground="{StaticResource BrushTestoSecondario}"/>
