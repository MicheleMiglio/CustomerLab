<UserControl x:Class="CLab.Views.SidePanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:conv="clr-namespace:CLab.Converters"
             x:Name="radice"
             Focusable="True"
             PreviewKeyDown="SuTasto">

    <!-- FASE 3 CLab 2.0: contenitore condiviso per l'editing a pannello laterale.
         Presentazione pura: i contenuti (form) restano nelle View, i comandi e
         lo stato di apertura restano nei ViewModel. -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:LarghezzaSidePanelConverter x:Key="LarghezzaSidePanel"/>
    </UserControl.Resources>

    <Grid Visibility="{Binding IsAperto, ElementName=radice, Converter={StaticResource BoolToVis}}">

        <!-- Overlay: click = richiesta chiusura (con conferma se ci sono modifiche) -->
        <Border x:Name="overlay" Style="{StaticResource OverlayScuroStyle}"
                MouseLeftButtonDown="SuClickOverlay"/>

        <!-- Pannello laterale -->
        <Border x:Name="pannello" Style="{StaticResource PanelLateraleStyle}" HorizontalAlignment="Right"
                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource LarghezzaSidePanel}}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="trasformazionePannello"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header sticky: titolo + eventuale contenuto extra (schede, azioni) + chiusura -->
                <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Titolo, ElementName=radice}"
                                           Style="{StaticResource ModuleTitleStyle}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Sottotitolo, ElementName=radice}"
                                           Style="{StaticResource ModuleSubtitleStyle}" Margin="0,4,0,0"
                                           Visibility="{Binding Sottotitolo, ElementName=radice, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource BtnIconGhost}"
                                    Command="{Binding ComandoChiudi, ElementName=radice}"
                                    ToolTip="Chiudi (Esc)" VerticalAlignment="Top"
                                    Click="SuClickChiudi">
                                <iconPacks:PackIconBootstrapIcons Kind="XLg"
                                    Width="14" Height="14" Foreground="{StaticResource BrushTestoSecondario}"/>
                            </Button>
                        </Grid>
                        <ContentPresenter Grid.Row="1" Margin="0,12,0,0"
                                          Content="{Binding HeaderExtra, ElementName=radice}"
                                          Visibility="{Binding HeaderExtra, ElementName=radice, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>

                <!-- Body scrollabile -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,18,22,8">
                    <ContentPresenter Content="{Binding Contenuto, ElementName=radice}"/>
                </ScrollViewer>

                <!-- Footer sticky: Salva (se previsto) + Annulla -->
                <Border Grid.Row="2" BorderBrush="{StaticResource BrushBordoLeggero}" BorderThickness="0,1,0,0" Padding="22,14"
                        Visibility="{Binding MostraFooter, ElementName=radice, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{Binding EtichettaSalva, ElementName=radice}"
                                Command="{Binding ComandoSalva, ElementName=radice}"
                                Style="{StaticResource BtnPrimary}" HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="2" Content="Annulla"
                                Command="{Binding ComandoChiudi, ElementName=radice}"
                                Style="{StaticResource BtnOutline}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
