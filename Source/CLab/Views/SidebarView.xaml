<UserControl x:Class="CLab.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:conv="clr-namespace:CLab.Converters">

    <!-- ============================================================ -->
    <!-- SIDEBAR CLab 2.0 (Proposta A: rail chiara).                   -->
    <!-- La sidebar si fonde con l'app: off-white, separata solo da un -->
    <!-- bordo destro 1px. Voce attiva = wash blu tenue + testo/icona  -->
    <!-- ColorPrimary. Comandi, binding e navigazione invariati.       -->
    <!-- ============================================================ -->

    <Border Background="{StaticResource BrushSidebarBackground}"
            BorderBrush="{StaticResource BrushBordoLeggero}"
            BorderThickness="0,1,1,0">

        <Grid ClipToBounds="True">

            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Branding: altezza allineata all'header di pagina (64).
                 Il blocco resta cliccabile per aprire/chiudere la sidebar. -->
            <Border Grid.Row="0" Margin="6,0,10,0"
                BorderBrush="{StaticResource BrushBordoLeggero}" BorderThickness="0,0,0,1"
                Background="Transparent" Cursor="Hand">

                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleSidebarCommand}"/>
                </Border.InputBindings>

                <Grid Margin="14,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Marchio: lettera "C" esistente, tinta piatta ColorPrimary.
                         Unico elemento pieno di brand: compatto, sobrio. -->
                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7"
                        VerticalAlignment="Center"
                        Background="{StaticResource BrushPrimary}">
                        <TextBlock Text="C" FontSize="13" FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Wordmark, solo a sidebar espansa -->
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding SidebarEspansa, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="CLab" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTestoPrimario}"/>
                        <TextBlock Text="CUSTOMER LAB" FontSize="9" FontWeight="Medium"
                               Foreground="{StaticResource BrushTestoTerziario}" Margin="0,2,0,0"
                               TextOptions.TextFormattingMode="Ideal"/>
                    </StackPanel>

                    <!-- Indicatore di collassa, solo a sidebar espansa -->
                    <iconPacks:PackIconBootstrapIcons Grid.Column="2" Kind="ChevronLeft"
                        Width="12" Height="12" Foreground="{StaticResource BrushTestoTerziario}"
                        VerticalAlignment="Center"
                        Visibility="{Binding SidebarEspansa, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Border>

            <!-- Menu principale -->
            <Border Grid.Row="1"
        Margin="0,8,0,0">
                <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding MenuPrincipale}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Button Style="{StaticResource SidebarMenuButton}"
        Command="{Binding Comando}"
        CommandParameter="{Binding}"
        ToolTip="{Binding Titolo}">

                                <Grid VerticalAlignment="Center">


                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="Auto"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>



                                    <!-- ICONA + PUNTINO NOTIFICA (sidebar chiusa) -->
                                    <Grid Grid.Column="0" Width="18" Height="18" Margin="2,0,10,0">
                                        <iconPacks:PackIconBootstrapIcons
        Kind="{Binding Icona, Converter={StaticResource IconaBootstrapConverter}}"
        Width="18"
        Height="18"/>

                                        <Border Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top"
               Margin="0,-2,-2,0"
               Visibility="{Binding DataContext.SidebarEspansa,
                            RelativeSource={RelativeSource AncestorType=UserControl},
                            Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                                            <Border CornerRadius="4"
               Visibility="{Binding Contatore, Converter={StaticResource BoolToVisibility}}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource BrushTestoTerziario}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelezionato}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource BrushSidebarAccent}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Border>
                                    </Grid>



                                    <!-- TESTO + BADGE CONTATORE -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
               Visibility="{Binding DataContext.SidebarEspansa,
                            RelativeSource={RelativeSource AncestorType=UserControl},
                            Converter={StaticResource BoolToVisibility}}">

                                        <TextBlock Text="{Binding Titolo}" Style="{StaticResource MenuText}"/>

                                        <!-- Badge contatore: piccolo, neutro, secondario
                                             rispetto al testo della voce -->
                                        <Border CornerRadius="9"
               MinWidth="18" Height="18" Padding="5,0" Margin="8,0,0,0" VerticalAlignment="Center"
               Visibility="{Binding Contatore, Converter={StaticResource BoolToVisibility}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelezionato}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource BrushSidebarSelectedBadge}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Contatore}" FontSize="10" FontWeight="Medium"
               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelezionato}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource BrushSidebarAccent}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                    </StackPanel>

                                </Grid>

                            </Button>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>
            </Border>
            <!-- Footer: Impostazioni, separato dalle voci da un divider sottilissimo -->
            <StackPanel Grid.Row="2" Margin="0,8,0,10">

                <Border Height="1" Background="{StaticResource BrushBordoLeggero}"
                        Margin="14,4,14,8"/>

                <ItemsControl ItemsSource="{Binding MenuFooter}">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Button Style="{StaticResource SidebarMenuButton}"
        Command="{Binding Comando}"
        CommandParameter="{Binding}"
        ToolTip="{Binding Titolo}">

                            <Grid VerticalAlignment="Center">


                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>



                                <!-- ICONA -->
                                <iconPacks:PackIconBootstrapIcons
        Grid.Column="0"
        Kind="{Binding Icona, Converter={StaticResource IconaBootstrapConverter}}"
        Width="18"
        Height="18"
        Margin="2,0,10,0"/>



                                <!-- TESTO -->
                                <TextBlock Grid.Column="1"
               Text="{Binding Titolo}"
               Style="{StaticResource MenuText}"
               Visibility="{Binding DataContext.SidebarEspansa,
                            RelativeSource={RelativeSource AncestorType=UserControl},
                            Converter={StaticResource BoolToVisibility}}"/>


                            </Grid>

                        </Button>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>
        </Grid>
    </Border>

</UserControl>