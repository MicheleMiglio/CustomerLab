<UserControl x:Class="CLab.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:conv="clr-namespace:CLab.Converters">

    <Border Background="{StaticResource BrushSidebarBackground}">

        <Grid ClipToBounds="True">

            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Logo / Nome applicazione: stessa altezza dell'header di pagina,
                 così le due barre in cima allo schermo si allineano. Tutto il
                 blocco è cliccabile per aprire/chiudere la sidebar. -->
            <Border Grid.Row="0"
                BorderBrush="{StaticResource BrushDivisoreSuScuro}" BorderThickness="0,0,0,1"
                Background="Transparent" Cursor="Hand">

                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleSidebarCommand}"/>
                </Border.InputBindings>

                <Grid Margin="18,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Marchio: unico punto dell'app in cui compare l'oro, come
                         tocco di brand puntuale. -->
                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="7"
                        VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource ColorPrimaryLight}" Offset="0"/>
                                <GradientStop Color="{StaticResource ColorPrimary}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="C" FontSize="13" FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Wordmark, solo a sidebar espansa -->
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding SidebarEspansa, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="CLab" FontSize="14" FontWeight="SemiBold" FontFamily="Segoe UI Semibold"
                               Foreground="{StaticResource BrushTestoSuScuro}"/>
                        <TextBlock Text="CUSTOMER LAB" FontSize="9" FontWeight="Medium" FontFamily="Segoe UI"
                               Foreground="{StaticResource BrushTestoSuScuroSecondario}" Margin="0,2,0,0"
                               TextOptions.TextFormattingMode="Ideal">
                        </TextBlock>
                    </StackPanel>

                    <!-- Indicatore di collassa, solo a sidebar espansa -->
                    <iconPacks:PackIconBootstrapIcons Grid.Column="2" Kind="ChevronLeft"
                        Width="12" Height="12" Foreground="{StaticResource BrushTestoSuScuroSecondario}"
                        VerticalAlignment="Center"
                        Visibility="{Binding SidebarEspansa, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Border>

            <!-- Menu principale -->
            <Border Grid.Row="1"
        Margin="0,10,0,0">
                <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding MenuPrincipale}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Button Style="{StaticResource SidebarMenuButton}"
        Command="{Binding Comando}"
        CommandParameter="{Binding}">

                                <Grid VerticalAlignment="Center">


                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="Auto"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>



                                    <!-- ICONA + PUNTINO NOTIFICA (sidebar chiusa) -->
                                    <Grid Grid.Column="0" Width="18" Height="18" Margin="2,0,10,0">
                                        <iconPacks:PackIconBootstrapIcons
        Kind="{Binding Icona, Converter={StaticResource IconaBootstrapConverter}}"
        Width="18"
        Height="18"/>

                                        <Border Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top"
               Margin="0,-2,-2,0"
               Visibility="{Binding DataContext.SidebarEspansa,
                            RelativeSource={RelativeSource AncestorType=UserControl},
                            Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                                            <Border CornerRadius="5"
               Visibility="{Binding Contatore, Converter={StaticResource BoolToVisibility}}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource BrushTestoSuScuroSecondario}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelezionato}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource BrushSidebarAccent}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Border>
                                    </Grid>



                                    <!-- TESTO + BADGE CONTATORE -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
               Visibility="{Binding DataContext.SidebarEspansa,
                            RelativeSource={RelativeSource AncestorType=UserControl},
                            Converter={StaticResource BoolToVisibility}}">

                                        <TextBlock Text="{Binding Titolo}" Style="{StaticResource MenuText}"/>

                                        <Border CornerRadius="10"
               MinWidth="18" Height="18" Padding="5,0" Margin="8,0,0,0" VerticalAlignment="Center"
               Visibility="{Binding Contatore, Converter={StaticResource BoolToVisibility}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelezionato}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource BrushSidebarSelectedBadge}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Contatore}" FontSize="10" FontWeight="Bold"
               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushTestoSuScuroSecondario}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelezionato}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource BrushTestoSuScuro}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                    </StackPanel>

                                </Grid>

                            </Button>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>
            </Border>
            <!-- Footer -->
            <ItemsControl Grid.Row="2"
              ItemsSource="{Binding MenuFooter}">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Button Style="{StaticResource SidebarMenuButton}"
        Command="{Binding Comando}"
        CommandParameter="{Binding}">

                            <Grid VerticalAlignment="Center">


                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>



                                <!-- ICONA -->
                                <iconPacks:PackIconBootstrapIcons
        Grid.Column="0"
        Kind="{Binding Icona, Converter={StaticResource IconaBootstrapConverter}}"
        Width="18"
        Height="18"
        Margin="2,0,10,0"/>



                                <!-- TESTO -->
                                <TextBlock Grid.Column="1"
               Text="{Binding Titolo}"
               Style="{StaticResource MenuText}"
               Visibility="{Binding DataContext.SidebarEspansa,
                            RelativeSource={RelativeSource AncestorType=UserControl},
                            Converter={StaticResource BoolToVisibility}}"/>


                            </Grid>

                        </Button>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>
        </Grid>
    </Border>

</UserControl>