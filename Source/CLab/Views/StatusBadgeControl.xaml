<UserControl x:Class="CLab.Views.StatusBadgeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CLab.Converters">

    <!-- FASE 2 CLab 2.0: badge di stato unificato. Presentazione pura: la
         semantica (testo/colore) viene da Converters.StatoSemantico, così
         tutti i moduli mostrano lo stesso stato allo stesso modo.
         Design system: pill piena, dot discreto, testo 11 Medium - comunica
         lo stato senza diventare l'elemento più importante della riga. -->
    <UserControl.Resources>
        <conv:StatoSemanticoTestoConverter x:Key="StatoSemanticoTesto"/>
        <conv:StatoSemanticoForeConverter x:Key="StatoSemanticoFore"/>
        <conv:StatoSemanticoBackConverter x:Key="StatoSemanticoBack"/>
    </UserControl.Resources>

    <Border CornerRadius="999" Padding="8,3"
            Background="{Binding Stato, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StatoSemanticoBack}}">
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,5,0"
                     Fill="{Binding Stato, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StatoSemanticoFore}}"/>
            <TextBlock Text="{Binding Stato, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StatoSemanticoTesto}}"
                       FontSize="11" FontWeight="Medium" VerticalAlignment="Center"
                       Foreground="{Binding Stato, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StatoSemanticoFore}}"/>
        </StackPanel>
    </Border>
</UserControl>
