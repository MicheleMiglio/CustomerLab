<UserControl x:Class="CLab.Views.ToDoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:CLab.Models"
             xmlns:converters="clr-namespace:CLab.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:views="clr-namespace:CLab.Views">

    <!-- ============================================================ -->
    <!-- TODO CLab 2.0 - revisione UX completa.                       -->
    <!-- Struttura: header -> toolbar (Filtri | ordinamento | ricerca) -->
    <!-- -> barra filtri INLINE (toggle, chip per i criteri principali  -->
    <!-- e riga criteri avanzati) -> chip dei filtri applicati -> lista -->
    <!-- a sezioni con righe a gerarchia cosa/quando/per chi/urgenza/   -->
    <!-- completamento -> form nel ModalDialogControl condiviso.        -->
    <!-- Pattern riusati da Clienti/Studi/Fatture/Promemoria: chip      -->
    <!-- ghost con selezione wash blu, AzioneGriglia, StatusBadge       -->
    <!-- unificato, ricerca compatta con cancella rapido, segmented     -->
    <!-- ordinamento e priorità. Il raggruppamento per cliente è      -->
    <!-- stato RIMOSSO (ridondante rispetto a ricerca e filtri).        -->
    <!-- ============================================================ -->

    <UserControl.Resources>
        <ResourceDictionary>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <!-- Priorità -> colore semantico (StatoSemantico): usata dal
                 segmented del form (pattern Promemoria). -->
            <converters:StatoSemanticoForeConverter x:Key="PrioritaAColore"/>

            <!-- Chip filtro (segmented): ghost, hover neutro, selezione wash
                 blu tenue. Stessa definizione di Clienti/Studi/Fatture. -->
            <Style x:Key="ChipFiltro" TargetType="Button">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Padding" Value="12,4"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushHoverNeutro}"/>
                                </Trigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="Sel"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushSidebarSelectedBadge}"/>
                                </MultiDataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Chip filtro ATTIVO con rimozione: neutro a riposo, hover wash,
                 la X diventa rossa solo come feedback di rimozione. -->
            <Style x:Key="ChipRimuovi" TargetType="Button">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                <Setter Property="Background" Value="{StaticResource BrushSfondoFine}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Margin" Value="0,0,8,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                    <iconPacks:PackIconBootstrapIcons x:Name="segno" Kind="XLg" Width="9" Height="9"
                                        Margin="7,1,0,0" VerticalAlignment="Center"
                                        Foreground="{StaticResource BrushTestoTerziario}"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushHoverNeutro}"/>
                                    <Setter TargetName="segno" Property="Foreground" Value="{StaticResource BrushDanger}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Chip PRIORITA' (barra filtri): segmentata su BozzaPriorita. -->
            <Style x:Key="ChipPrioTutte" TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding BozzaPriorita}" Value="tutte">
                        <Setter Property="Tag" Value="Sel"/>
                        <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ChipPrioAlta" TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding BozzaPriorita}" Value="alta">
                        <Setter Property="Tag" Value="Sel"/>
                        <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ChipPrioMedia" TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding BozzaPriorita}" Value="media">
                        <Setter Property="Tag" Value="Sel"/>
                        <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ChipPrioBassa" TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding BozzaPriorita}" Value="bassa">
                        <Setter Property="Tag" Value="Sel"/>
                        <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Chip STATO (barra filtri): toggle Solo scaduti. -->
            <Style x:Key="ChipSoloScaduti" TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding BozzaSoloScaduti}" Value="True">
                        <Setter Property="Tag" Value="Sel"/>
                        <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Segmented ordinamento (pattern Promemoria). -->
            <Style x:Key="ChipOrdinaScadenza" TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Ordinamento}" Value="Scadenza">
                        <Setter Property="Tag" Value="Sel"/>
                        <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ChipOrdinaCreazione" TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Ordinamento}" Value="Creazione">
                        <Setter Property="Tag" Value="Sel"/>
                        <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Bottone Filtri: outline che si evidenzia quando la barra è aperta. -->
            <Style x:Key="BtnFiltri" TargetType="Button" BasedOn="{StaticResource BtnOutline}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding FiltriAperti}" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Azioni inline della lista: icone ghost discreti (pattern Fatture). -->
            <Style x:Key="AzioneGriglia" TargetType="Button">
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushHoverNeutro}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Segmented priorità del form (pattern Promemoria): attivo =
                 wash neutro + testo nel colore semantico della priorità. -->
            <Style x:Key="SegmentFormBase" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushHoverNeutro}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SegmentFormBassa" TargetType="Button" BasedOn="{StaticResource SegmentFormBase}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding FormPriorita}" Value="Bassa">
                        <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                        <Setter Property="Foreground" Value="{Binding FormPriorita, Converter={StaticResource PrioritaAColore}}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SegmentFormMedia" TargetType="Button" BasedOn="{StaticResource SegmentFormBase}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding FormPriorita}" Value="Media">
                        <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                        <Setter Property="Foreground" Value="{Binding FormPriorita, Converter={StaticResource PrioritaAColore}}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SegmentFormAlta" TargetType="Button" BasedOn="{StaticResource SegmentFormBase}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding FormPriorita}" Value="Alta">
                        <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                        <Setter Property="Foreground" Value="{Binding FormPriorita, Converter={StaticResource PrioritaAColore}}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER: titolo + azione primaria (stesso schema di Studi/Fatture) -->
        <Border Grid.Row="0" Style="{StaticResource ModuleHeaderBorderStyle}" Padding="28,0" Height="64">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="ToDo" Style="{StaticResource ModuleTitleStyle}"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Height="32" MinWidth="120" Padding="12,0"
                    Command="{Binding NuovoCommand}" ToolTip="Nuovo ToDo">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBootstrapIcons Kind="Plus" Width="11" Height="11"
                            Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Nuovo ToDo" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOOLBAR: [Filtri] | [ordinamento][ricerca]. Pulita: i filtri
                 attivi si vedono nei chip, la barra di editing si apre al click. -->
            <Grid Grid.Row="0" Margin="28,10,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource BtnFiltri}" Height="32" Padding="12,0" VerticalAlignment="Center"
                    Command="{Binding ApriFiltriCommand}" ToolTip="Mostra o nasconde i filtri">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBootstrapIcons Kind="Funnel" Width="12" Height="12"
                            Margin="0,0,7,0" VerticalAlignment="Center"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock Text="{Binding TestoBottoneFiltri}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BrushBordoLeggero}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}" Padding="2"
                    VerticalAlignment="Center" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Per scadenza" Style="{StaticResource ChipOrdinaScadenza}"
                            Command="{Binding OrdinaPerScadenzaCommand}" ToolTip="Ordina per scadenza"/>
                        <Button Content="Più recenti" Style="{StaticResource ChipOrdinaCreazione}"
                            Command="{Binding OrdinaPerCreazioneCommand}" ToolTip="Ordina per data di creazione"/>
                    </StackPanel>
                </Border>

                <!-- Ricerca compatta con cancella rapido (pattern Clienti/Studi/Fatture) -->
                <Border Grid.Column="3" Width="250" Height="32" Background="White"
                    BorderBrush="{StaticResource BrushBordo}" BorderThickness="1" CornerRadius="6"
                    VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconBootstrapIcons Grid.Column="0" Kind="Search" Width="13" Height="13"
                            Foreground="{StaticResource BrushTestoSecondario}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Margin="0,0,5,0"
                            Text="{Binding FiltroTesto, UpdateSourceTrigger=PropertyChanged}"
                            BorderThickness="0" Background="Transparent" FontSize="12"
                            Foreground="{StaticResource BrushTestoPrimario}"
                            VerticalContentAlignment="Center"
                            mah:TextBoxHelper.Watermark="  Cerca titolo, cliente, referente…"/>
                        <Button Grid.Column="2" Style="{StaticResource AzioneGriglia}" Width="22" Height="22"
                            Margin="0,0,4,0" Click="CancellaRicerca_Click" ToolTip="Cancella ricerca"
                            Visibility="{Binding FiltroTesto, Converter={StaticResource BoolToVisibility}}">
                            <iconPacks:PackIconBootstrapIcons Kind="XLg" Width="10" Height="10"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- BARRA FILTRI INLINE: si apre sotto la toolbar con lo stesso
                 toggle "Filtri". Superficie morbida distinta dalla lista bianca.
                 Riusa la logica Bozza -> Applica del ViewModel, senza sidebar. -->
            <Border Grid.Row="1" Margin="28,10,28,0"
                Background="{StaticResource BrushSfondoFine}"
                BorderBrush="{StaticResource BrushBordoLeggero}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}" Padding="16,14,16,10"
                Visibility="{Binding FiltriAperti, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>

                    <!-- FILTRI PRINCIPALI: le scelte più frequenti, un click ciascuna -->
                    <WrapPanel>
                        <StackPanel Margin="0,0,24,12">
                            <TextBlock Text="PRIORITÀ" Style="{StaticResource FieldLabel}"/>
                            <Border Background="White" BorderBrush="{StaticResource BrushBordoLeggero}"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}"
                                Padding="2" Margin="0,4,0,0" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Tutte" Style="{StaticResource ChipPrioTutte}"
                                        Command="{Binding ImpostaBozzaPrioritaCommand}" CommandParameter="tutte"/>
                                    <Button Content="Alta" Style="{StaticResource ChipPrioAlta}"
                                        Command="{Binding ImpostaBozzaPrioritaCommand}" CommandParameter="alta"/>
                                    <Button Content="Media" Style="{StaticResource ChipPrioMedia}"
                                        Command="{Binding ImpostaBozzaPrioritaCommand}" CommandParameter="media"/>
                                    <Button Content="Bassa" Style="{StaticResource ChipPrioBassa}"
                                        Command="{Binding ImpostaBozzaPrioritaCommand}" CommandParameter="bassa"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,0,24,12">
                            <TextBlock Text="CLIENTE" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding ClientiPerFiltro}"
                                    DisplayMemberPath="RagioneSociale" SelectedItem="{Binding BozzaCliente}"/>
                                <Button Grid.Column="1" Style="{StaticResource AzioneGriglia}" Padding="5" Margin="4,0,0,0"
                                    Command="{Binding PulisciBozzaClienteCommand}" ToolTip="Rimuovi selezione"
                                    Visibility="{Binding BozzaCliente, Converter={StaticResource BoolToVisibility}}">
                                    <iconPacks:PackIconBootstrapIcons Kind="XLg" Width="10" Height="10"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,0,24,12">
                            <TextBlock Text="REFERENTE" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding ReferentiTutti}"
                                    DisplayMemberPath="Nome" SelectedItem="{Binding BozzaReferente}"/>
                                <Button Grid.Column="1" Style="{StaticResource AzioneGriglia}" Padding="5" Margin="4,0,0,0"
                                    Command="{Binding PulisciBozzaReferenteCommand}" ToolTip="Rimuovi selezione"
                                    Visibility="{Binding BozzaReferente, Converter={StaticResource BoolToVisibility}}">
                                    <iconPacks:PackIconBootstrapIcons Kind="XLg" Width="10" Height="10"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="STATO" Style="{StaticResource FieldLabel}"/>
                            <Button Margin="0,4,0,0" HorizontalAlignment="Left"
                                Style="{StaticResource ChipSoloScaduti}"
                                Command="{Binding ToggleBozzaSoloScadutiCommand}"
                                ToolTip="Mostra solo i ToDo con scadenza superata">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconBootstrapIcons Kind="ExclamationTriangle" Width="11" Height="11"
                                        Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Solo scaduti" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </WrapPanel>

                    <!-- CRITERI AVANZATI: meno frequenti, secondo livello -->
                    <TextBlock Text="ALTRI CRITERI" Style="{StaticResource SectionTitle}" Margin="0,2,0,8"/>
                    <WrapPanel>
                        <StackPanel Margin="0,0,24,12">
                            <TextBlock Text="COLLEGAMENTO" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Width="180" Margin="0,4,0,0" HorizontalAlignment="Left"
                                ItemsSource="{Binding OpzioniCollegamentoFiltro}"
                                DisplayMemberPath="Value" SelectedValuePath="Key"
                                SelectedValue="{Binding BozzaCollegamento}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,24,12">
                            <TextBlock Text="SOTTO-ATTIVITÀ" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Width="200" Margin="0,4,0,0" HorizontalAlignment="Left"
                                ItemsSource="{Binding OpzioniPassiFiltro}"
                                DisplayMemberPath="Value" SelectedValuePath="Key"
                                SelectedValue="{Binding BozzaPassi}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,24,12">
                            <TextBlock Text="PERIODO" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <ComboBox Width="140"
                                    ItemsSource="{Binding OpzioniCampoDataFiltro}"
                                    DisplayMemberPath="Value" SelectedValuePath="Key"
                                    SelectedValue="{Binding BozzaCampoData}"/>
                                <DatePicker Width="125" Margin="10,0,0,0"
                                    SelectedDate="{Binding BozzaDataDa}" mah:TextBoxHelper.Watermark="Dal"/>
                                <DatePicker Width="125" Margin="8,0,0,0"
                                    SelectedDate="{Binding BozzaDataA}" mah:TextBoxHelper.Watermark="Al"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12" MaxWidth="330">
                            <TextBlock Text="COMPLETATI" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <CheckBox IsChecked="{Binding BozzaMostraTuttiCompletati}"
                                    Style="{StaticResource ModuleCheckBoxStyle}" VerticalAlignment="Center"/>
                                <TextBlock Text="Mostra tutti i completati (oltre 90 giorni)"
                                    FontSize="12" Foreground="{StaticResource BrushTestoPrimario}"
                                    VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Text="Di default i completati restano negli ultimi 90 giorni. Spunta qui, oppure filtra per data di completamento, per rivedere lo storico."
                                FontSize="11" Foreground="{StaticResource BrushTestoTerziario}" TextWrapping="Wrap"
                                Margin="26,4,0,0"/>
                        </StackPanel>
                    </WrapPanel>

                    <!-- AZIONI BARRA: applica chiude la barra e aggiorna i chip -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Content="Azzera" Style="{StaticResource BtnOutline}" MinWidth="96"
                            Command="{Binding AzzeraBozzaFiltriCommand}" ToolTip="Azzera filtri e ricerca"/>
                        <Button Content="Applica" Style="{StaticResource BtnPrimary}" MinWidth="104" Margin="10,0,0,0"
                            Command="{Binding ApplicaFiltriCommand}" ToolTip="Applica i filtri alla lista"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- CHIP FILTRI APPLICATI + azzeramento (nascosti mentre la barra è aperta) -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="28,8,28,0"
                Visibility="{Binding MostraChipFiltri, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding ChipFiltri}" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ChipRimuovi}"
                                Command="{Binding DataContext.RimuoviChipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Chiave}"
                                ToolTip="Rimuovi filtro">
                                <TextBlock Text="{Binding Testo}"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource ChipFiltro}" Margin="0,0,0,4" VerticalAlignment="Top"
                    Command="{Binding AzzeraBozzaFiltriCommand}" ToolTip="Rimuove tutti i filtri">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBootstrapIcons Kind="Eraser" Width="11" Height="11"
                            Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Azzera filtri" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- CONTENUTO -->
            <Grid Grid.Row="3">

                <!-- CARD LISTA a sezioni (nascosta quando la lista è vuota) -->
                <Border Margin="28,12,28,24" Background="White"
                    BorderBrush="{StaticResource BrushBordoLeggero}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Visibility="{Binding ListaVuota, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- INTESTAZIONI DI COLONNA: gerarchia cosa/quando/per chi/
                             urgenza/completamento. Stessa griglia delle righe. -->
                        <Border Grid.Row="0" BorderBrush="{StaticResource BrushBordoLeggero}"
                            BorderThickness="0,0,0,1" Padding="14,0">
                            <Grid Height="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="105"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="TITOLO" Style="{StaticResource TableHeaderTextStyle}"
                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2" Text="SCADENZA" Style="{StaticResource TableHeaderTextStyle}"
                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="3" Text="COLLEGAMENTO" Style="{StaticResource TableHeaderTextStyle}"
                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="4" Text="PRIORITÀ" Style="{StaticResource TableHeaderTextStyle}"
                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="5" Text="PASSI" Style="{StaticResource TableHeaderTextStyle}"
                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Sezioni}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Visibility="{Binding MostraSezione, Converter={StaticResource BoolToVisibility}}">

                                            <!-- TESTATA SEZIONE: chevron + dot semantico + titolo
                                                 + conteggio, nota a destra. Leggera, niente barra piena. -->
                                            <Button Command="{Binding DataContext.ToggleSezioneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Cursor="Hand"
                                                HorizontalContentAlignment="Stretch" Padding="0" FocusVisualStyle="{x:Null}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="Transparent" Padding="14,8">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushHoverNeutro}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <iconPacks:PackIconBootstrapIcons Grid.Column="0" Width="11" Height="11"
                                                        Foreground="{StaticResource BrushTestoTerziario}" VerticalAlignment="Center">
                                                        <iconPacks:PackIconBootstrapIcons.Style>
                                                            <Style TargetType="iconPacks:PackIconBootstrapIcons">
                                                                <Setter Property="Kind" Value="ChevronRight"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Espansa}" Value="True">
                                                                        <Setter Property="Kind" Value="ChevronDown"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </iconPacks:PackIconBootstrapIcons.Style>
                                                    </iconPacks:PackIconBootstrapIcons>
                                                    <Ellipse Grid.Column="1" Width="7" Height="7" Margin="10,0,8,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{StaticResource BrushTestoTerziario}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Chiave}" Value="scaduti">
                                                                        <Setter Property="Fill" Value="{StaticResource BrushDanger}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Chiave}" Value="programma">
                                                                        <Setter Property="Fill" Value="{StaticResource BrushPrimary}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Chiave}" Value="completati">
                                                                        <Setter Property="Fill" Value="{StaticResource BrushSuccess}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Titolo}" FontSize="12" FontWeight="Medium"
                                                            Foreground="{StaticResource BrushTestoPrimario}"/>
                                                        <TextBlock Text="{Binding Conteggio, StringFormat=' ({0})'}" FontSize="11"
                                                            Foreground="{StaticResource BrushTestoTerziario}" Margin="5,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3" Text="{Binding Nota}" FontSize="11"
                                                        Foreground="{StaticResource BrushTestoTerziario}" VerticalAlignment="Center"
                                                        Visibility="{Binding Nota, Converter={StaticResource BoolToVisibility}}"/>
                                                </Grid>
                                            </Button>

                                            <!-- placeholder della sezione vuota (es. Scaduti) -->
                                            <TextBlock Text="Nessun elemento in questa sezione" FontSize="12"
                                                Foreground="{StaticResource BrushTestoTerziario}" Padding="50,6,14,12"
                                                Visibility="{Binding MostraVuoto, Converter={StaticResource BoolToVisibility}}"/>

                                            <!-- RIGHE -->
                                            <ItemsControl ItemsSource="{Binding Righe}"
                                                Visibility="{Binding MostraRighe, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>

                                                            <!-- RIGA PRINCIPALE: hover neutro, doppio click = apri -->
                                                            <Border BorderBrush="{StaticResource BrushBordoLeggero}"
                                                                BorderThickness="0,0,0,1" MinHeight="44">
                                                                <Border.InputBindings>
                                                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                                        Command="{Binding DataContext.ApriModificaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"/>
                                                                </Border.InputBindings>
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <!-- Transparent (non null): l'area vuota della riga
                                                                             resta cliccabile per hover e doppio click. -->
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Setter Property="Cursor" Value="Hand"/>
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource BrushHoverNeutro}"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="36"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="105"/>
                                                                        <ColumnDefinition Width="150"/>
                                                                        <ColumnDefinition Width="90"/>
                                                                        <ColumnDefinition Width="64"/>
                                                                        <ColumnDefinition Width="40"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- completamento inline -->
                                                                    <CheckBox Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                        IsChecked="{Binding Completato, Mode=OneWay}"
                                                                        Style="{StaticResource ModuleCheckBoxStyle}"
                                                                        ToolTip="Segna come completato / da fare">
                                                                        <CheckBox.InputBindings>
                                                                            <MouseBinding MouseAction="LeftClick"
                                                                                Command="{Binding DataContext.ToggleCompletatoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}"/>
                                                                        </CheckBox.InputBindings>
                                                                    </CheckBox>

                                                                    <!-- COSA: titolo dominante; badge Scaduto solo se serve;
                                                                         data di completamento (verde) solo sui completati -->
                                                                    <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0" LastChildFill="True">
                                                                        <views:StatusBadgeControl DockPanel.Dock="Right" Stato="Scaduto" VerticalAlignment="Center" Margin="10,0,0,0"
                                                                            Visibility="{Binding IsScaduto, Converter={StaticResource BoolToVisibility}}"/>
                                                                        <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource BrushSuccess}"
                                                                            VerticalAlignment="Center" Margin="10,0,0,0"
                                                                            Text="{Binding CompletamentoDisplay, StringFormat='Completato il {0}'}"
                                                                            Visibility="{Binding Completato, Converter={StaticResource BoolToVisibility}}"/>
                                                                        <TextBlock Text="{Binding Titolo}" FontSize="13" VerticalAlignment="Center"
                                                                            TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Titolo}">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="FontWeight" Value="Medium"/>
                                                                                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Completato}" Value="True">
                                                                                            <Setter Property="FontWeight" Value="Normal"/>
                                                                                            <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </DockPanel>

                                                                    <!-- QUANDO: rosso = scaduto, ambra = in scadenza (entro 7gg) -->
                                                                    <TextBlock Grid.Column="2" Text="{Binding ScadenzaDisplay}" FontSize="12"
                                                                        VerticalAlignment="Center" Margin="0,0,10,0">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsScaduto}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                                                                                        <Setter Property="FontWeight" Value="Medium"/>
                                                                                        <Setter Property="ToolTip" Value="Scaduto"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding IsInScadenza}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{StaticResource BrushStatoStandBy}"/>
                                                                                        <Setter Property="FontWeight" Value="Medium"/>
                                                                                        <Setter Property="ToolTip" Value="In scadenza (entro 7 giorni)"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Completato}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{StaticResource BrushTestoTerziario}"/>
                                                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>

                                                                    <!-- PER CHI: cliente, altrimenti referente -->
                                                                    <TextBlock Grid.Column="3" Text="{Binding CollegamentoDisplay}" FontSize="12"
                                                                        VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                                        ToolTip="{Binding CollegamentoDisplay}" Margin="0,0,10,0">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding CollegamentoDisplay}" Value="—">
                                                                                        <Setter Property="Foreground" Value="{StaticResource BrushTestoTerziario}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>

                                                                    <!-- QUANTO E' URGENTE: badge unificato, nascosto sui completati -->
                                                                    <views:StatusBadgeControl Grid.Column="4" Stato="{Binding Priorita}"
                                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                        Visibility="{Binding Completato, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}"/>

                                                                    <!-- QUANTO E' COMPLETATO: n/m + espansione (solo con passi) -->
                                                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center"
                                                                        Visibility="{Binding HaSottoAttivita, Converter={StaticResource BoolToVisibility}}">
                                                                        <TextBlock Text="{Binding PassiDisplay}" FontSize="11" FontWeight="Medium"
                                                                            Foreground="{StaticResource BrushTestoSecondario}" VerticalAlignment="Center"
                                                                            ToolTip="Sotto-attività completate sul totale"/>
                                                                        <Button Style="{StaticResource AzioneGriglia}" Width="22" Height="22" Margin="2,0,0,0"
                                                                            Command="{Binding DataContext.ToggleEspansoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}" ToolTip="Mostra/nascondi sotto-attività">
                                                                            <iconPacks:PackIconBootstrapIcons Width="11" Height="11"
                                                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                                                                <iconPacks:PackIconBootstrapIcons.Style>
                                                                                    <Style TargetType="iconPacks:PackIconBootstrapIcons">
                                                                                        <Setter Property="Kind" Value="ChevronDown"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsEspanso}" Value="True">
                                                                                                <Setter Property="Kind" Value="ChevronUp"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </iconPacks:PackIconBootstrapIcons.Style>
                                                                            </iconPacks:PackIconBootstrapIcons>
                                                                        </Button>
                                                                    </StackPanel>

                                                                    <!-- AZIONI (modifica; eliminazione nel modal, con conferma) -->
                                                                    <StackPanel Grid.Column="6" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Button Style="{StaticResource AzioneGriglia}" Margin="0,0,2,0"
                                                                            Command="{Binding DataContext.ApriModificaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}" ToolTip="Modifica">
                                                                            <iconPacks:PackIconBootstrapIcons Kind="Pencil" Width="13" Height="13"
                                                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>

                                                            <!-- SOTTO-ATTIVITÀ (solo se la riga è espansa): pannello
                                                                 rientrato e discreto, subordinato al ToDo padre -->
                                                            <Border Background="{StaticResource BrushSfondoFine}"
                                                                CornerRadius="{StaticResource RadiusSmall}"
                                                                Margin="50,0,14,10" Padding="10,8"
                                                                Visibility="{Binding MostraSottoAttivitaEspanse, Converter={StaticResource BoolToVisibility}}">
                                                                <ItemsControl ItemsSource="{Binding SottoAttivita}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                                                <CheckBox VerticalAlignment="Center" IsChecked="{Binding Completato, Mode=OneWay}"
                                                                                    Style="{StaticResource ModuleCheckBoxStyle}" ToolTip="Segna il passo come completato">
                                                                                    <CheckBox.InputBindings>
                                                                                        <MouseBinding MouseAction="LeftClick"
                                                                                            Command="{Binding DataContext.ToggleSottoAttivitaInlineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                            CommandParameter="{Binding}"/>
                                                                                    </CheckBox.InputBindings>
                                                                                </CheckBox>
                                                                                <TextBlock Text="{Binding Testo}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"
                                                                                    TextTrimming="CharacterEllipsis">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock">
                                                                                            <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding Completato}" Value="True">
                                                                                                    <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Border>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- EMPTY STATE: titolo + sottotesto + CTA contestuale (pattern Promemoria) -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28,0,28,24"
                    Visibility="{Binding ListaVuota, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding EmptyStateTesto}" FontSize="15" FontWeight="SemiBold"
                        Foreground="{StaticResource BrushTestoPrimario}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding EmptyStateSottotesto}" Style="{StaticResource SecondaryTextStyle}"
                        Margin="0,6,0,0" HorizontalAlignment="Center"/>
                    <Button Style="{StaticResource BtnPrimary}" Padding="14,7" HorizontalAlignment="Center" Margin="0,16,0,0"
                        Command="{Binding NuovoCommand}" ToolTip="Nuovo ToDo"
                        Visibility="{Binding HaFiltriORicerca, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverti}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBootstrapIcons Kind="Plus" Width="12" Height="12"
                                Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Nuovo ToDo" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnOutline}" Padding="14,6" HorizontalAlignment="Center" Margin="0,16,0,0"
                        Command="{Binding AzzeraBozzaFiltriCommand}" ToolTip="Azzera filtri e ricerca"
                        Visibility="{Binding HaFiltriORicerca, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBootstrapIcons Kind="Eraser" Width="11" Height="11"
                                Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Azzera filtri" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Form crea/modifica nel ModalDialogControl condiviso (stesso contratto
             degli altri moduli). -->
        <views:ModalDialogControl Grid.Row="0" Grid.RowSpan="2"
            IsAperto="{Binding OverlayAperto}"
            Titolo="{Binding PannelloTitolo}"
            Sottotitolo="{Binding PannelloSottoTitolo}"
            ComandoChiudi="{Binding ChiudiOverlayCommand}"
            ComandoSalva="{Binding SalvaCommand}"
            HaModificheNonSalvate="{Binding HaModifiche}">

            <views:ModalDialogControl.HeaderExtra>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BtnIconRed}"
                        Command="{Binding EliminaCommand}" ToolTip="Elimina ToDo"
                        Visibility="{Binding MostraEliminaPanel, Converter={StaticResource BoolToVisibility}}">
                        <iconPacks:PackIconBootstrapIcons Kind="Trash" Width="13" Height="13"
                            Foreground="{StaticResource BrushDanger}"/>
                    </Button>
                </StackPanel>
            </views:ModalDialogControl.HeaderExtra>

            <views:ModalDialogControl.Contenuto>
                <StackPanel>

                    <!-- Stato completato: verde (semantica Completato del design system) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14"
                        Visibility="{Binding FormCompletatoInfo, Converter={StaticResource BoolToVisibility}}">
                        <iconPacks:PackIconBootstrapIcons Kind="CheckCircle" Width="13" Height="13"
                            Foreground="{StaticResource BrushSuccess}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FormCompletatoInfo}" FontSize="12" FontWeight="Medium"
                            Foreground="{StaticResource BrushSuccess}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="TITOLO *" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding FormTitolo, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14"/>

                    <TextBlock Text="DESCRIZIONE" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding FormDescrizione, UpdateSourceTrigger=PropertyChanged}"
                        AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                        VerticalContentAlignment="Top" Margin="0,4,0,16"/>

                    <!-- Scadenza + priorità (segmented, pattern Promemoria) -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SCADENZA" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <DatePicker Grid.Column="0" SelectedDate="{Binding FormDataScadenza}"/>
                                <Button Grid.Column="1" Style="{StaticResource AzioneGriglia}" Width="24" Height="24"
                                    Padding="4" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Command="{Binding PulisciScadenzaCommand}" ToolTip="Svuota scadenza"
                                    Visibility="{Binding FormDataScadenza, Converter={StaticResource BoolToVisibility}}">
                                    <iconPacks:PackIconBootstrapIcons Kind="XLg" Width="10" Height="10"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PRIORITÀ" Style="{StaticResource FieldLabel}"/>
                            <Border Background="White" BorderBrush="{StaticResource BrushBordoLeggero}"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}" Padding="2"
                                Margin="0,4,0,0" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Bassa" Style="{StaticResource SegmentFormBassa}"
                                        Command="{Binding ImpostaPrioritaCommand}"
                                        CommandParameter="{x:Static models:PrioritaToDo.Bassa}"/>
                                    <Button Content="Media" Style="{StaticResource SegmentFormMedia}"
                                        Command="{Binding ImpostaPrioritaCommand}"
                                        CommandParameter="{x:Static models:PrioritaToDo.Media}"/>
                                    <Button Content="Alta" Style="{StaticResource SegmentFormAlta}"
                                        Command="{Binding ImpostaPrioritaCommand}"
                                        CommandParameter="{x:Static models:PrioritaToDo.Alta}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Collegamenti: cliente + referente affiancati -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CLIENTE" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding ClientiPerCombo}"
                                    DisplayMemberPath="RagioneSociale" SelectedItem="{Binding FormCliente}"/>
                                <Button Grid.Column="1" Style="{StaticResource AzioneGriglia}" Width="24" Height="24"
                                    Padding="4" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Command="{Binding PulisciClienteCommand}" ToolTip="Rimuovi selezione"
                                    Visibility="{Binding FormCliente, Converter={StaticResource BoolToVisibility}}">
                                    <iconPacks:PackIconBootstrapIcons Kind="XLg" Width="10" Height="10"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="REFERENTE" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding ReferentiTutti}"
                                    DisplayMemberPath="Nome" SelectedItem="{Binding FormReferente}"/>
                                <Button Grid.Column="1" Style="{StaticResource AzioneGriglia}" Width="24" Height="24"
                                    Padding="4" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Command="{Binding PulisciReferenteCommand}" ToolTip="Rimuovi selezione"
                                    Visibility="{Binding FormReferente, Converter={StaticResource BoolToVisibility}}">
                                    <iconPacks:PackIconBootstrapIcons Kind="XLg" Width="10" Height="10"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="SOTTO-ATTIVITÀ" Style="{StaticResource SectionTitle}" Margin="0,12,0,6"/>
                    <ItemsControl ItemsSource="{Binding FormSottoAttivita}" Margin="0,0,0,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BrushBordoLeggero}" BorderThickness="0,0,0,1" Padding="2,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding Completato}" Margin="0,0,9,0"
                                            VerticalAlignment="Center" Style="{StaticResource ModuleCheckBoxStyle}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Testo}" FontSize="12" VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushTestoPrimario}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Completato}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushTestoSecondario}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Grid.Column="2" Style="{StaticResource AzioneGriglia}" Width="22" Height="22"
                                            Command="{Binding DataContext.RimuoviSottoAttivitaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="Rimuovi passo">
                                            <iconPacks:PackIconBootstrapIcons Kind="XLg" Width="10" Height="10"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Height="34"
                            Text="{Binding NuovaSottoAttivitaTesto, UpdateSourceTrigger=PropertyChanged}"
                            mah:TextBoxHelper.Watermark="Aggiungi un passo…"
                            KeyDown="NuovaSottoAttivita_KeyDown"/>
                        <Button Grid.Column="2" Style="{StaticResource AzioneGriglia}" Width="34" Height="34"
                            Foreground="{StaticResource BrushPrimary}"
                            Command="{Binding AggiungiSottoAttivitaCommand}" ToolTip="Aggiungi passo">
                            <iconPacks:PackIconBootstrapIcons Kind="Plus" Width="14" Height="14"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </Grid>

                </StackPanel>
            </views:ModalDialogControl.Contenuto>
        </views:ModalDialogControl>

    </Grid>

</UserControl>
